"""Collect required suite native exits and sanitized receipts, even on failure.

Usage: tools/qualification-results OUTPUT SUITE [SUITE...]
Native output stays local in OUTPUT/raw; only results.json and the allowlisted
per-lane .log receipts may be uploaded. A required skip blocks qualification.
"""
import hashlib
import ctypes
import os
import math
import signal
import time
import json
import subprocess
import sys
from pathlib import Path


def suite_timeout(suite):
    """Allow a default 30-minute soak to finish its final cycle and cleanup."""
    if suite == "soak":
        minutes = float(os.environ.get("MEMVEIL_SOAK_MINUTES", "30"))
        if not math.isfinite(minutes) or minutes <= 0:
            raise ValueError("invalid soak duration")
        return minutes * 60 + 300
    return 1800


def _processes():
    records = {}
    for file in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = file.read_text().rsplit(")", 1)[1].split()
            records[int(file.parent.name)] = (int(fields[1]), fields[0], int(fields[19]))
        except (OSError, ValueError, IndexError):
            continue
    return records


def _same(pid, birth):
    return _processes().get(pid, (None, None, None))[2] == birth


def _terminate_owned(proc, prior_children):
    """Freeze and retire exact descendants, including separate VM sessions.

    The runner is a Linux subreaper. Targeted waitpid calls retire only the
    descendants of this invocation; unrelated resources are never signalled
    or reaped. Birth ticks guard against PID reuse during cleanup.
    """
    snapshot = _processes()
    owned = {proc.pid: snapshot[proc.pid][2]} if proc.pid in snapshot else {}
    errors = 0

    def discover():
        # TERM handlers may fork, and exiting parents transfer their children
        # to this single-threaded subreaper. Refresh both ownership routes in
        # every cleanup phase, always excluding the pre-suite child boundary.
        snapshot = _processes()
        added = set()
        changed = True
        while changed:
            changed = False
            for pid, (ppid, state, birth) in snapshot.items():
                parent_owned = (ppid in owned and ppid in snapshot
                                and snapshot[ppid][2] == owned[ppid])
                adopted = ppid == os.getpid() and (pid, birth) not in prior_children
                if (parent_owned or adopted) and owned.get(pid) != birth:
                    owned[pid] = birth
                    added.add(pid)
                    changed = True
        return snapshot, added

    def send(pid, sig):
        nonlocal errors
        if _same(pid, owned[pid]):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
            except PermissionError:
                errors += 1

    for _ in range(16):
        snapshot, added = discover()
        for pid in owned:
            send(pid, signal.SIGSTOP)
        if not added:
            break
    for pid in owned:
        send(pid, signal.SIGTERM)
        send(pid, signal.SIGCONT)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        snapshot, added = discover()
        for pid in added:
            send(pid, signal.SIGSTOP)
            send(pid, signal.SIGTERM)
            send(pid, signal.SIGCONT)
        if all(pid not in snapshot or snapshot[pid][2] != birth
               or snapshot[pid][1] == "Z" for pid, birth in owned.items()):
            break
        time.sleep(0.02)
    # Re-discover during KILL and targeted reaping too: a handler can create
    # its last detached child at the end of the TERM grace period.
    deadline = time.monotonic() + 5
    reaped = 0
    empty_checks = 0
    remaining = len(owned)
    while time.monotonic() < deadline:
        snapshot, _ = discover()
        for pid in owned:
            send(pid, signal.SIGKILL)
        # Let Popen retain the direct child's exact native exit before reaping
        # adopted descendants. Never use waitpid(-1) for unrelated children.
        proc.poll()
        for pid in owned:
            if pid == proc.pid:
                continue
            try:
                got, _ = os.waitpid(pid, os.WNOHANG)
                reaped += int(got != 0)
            except ChildProcessError:
                pass
        snapshot, _ = discover()
        remaining = sum(pid in snapshot and snapshot[pid][2] == birth
                        for pid, birth in owned.items())
        empty_checks = empty_checks + 1 if not remaining else 0
        if empty_checks >= 2:
            break
        time.sleep(0.02)
    return dict(owned_processes=len(owned), reaped_descendants=reaped,
                remaining_owned=remaining, signal_errors=errors)


def run_suites(repo,out,suites,timeouts=None):
    out.mkdir(parents=True,exist_ok=True)
    raw=out/'raw';raw.mkdir(exist_ok=True)
    lanes=[]
    # Subreaper ownership belongs only to this development runner process.
    libc=ctypes.CDLL(None,use_errno=True)
    if libc.prctl(36,1,0,0,0) != 0:
        raise OSError(ctypes.get_errno(),"cannot establish child reaping")
    unresolved_cleanup = False
    for suite in suites:
        # Suite names, not arbitrary external commands, form the interface.
        if not suite or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789-' for c in suite):
            raise ValueError('invalid suite name')
        target=raw/(suite+'.log')
        cleanup = None
        timed_out = False
        leaked_processes = False
        prior_children = {(pid, birth) for pid, (ppid, state, birth) in _processes().items() if ppid == os.getpid()}
        budget = (timeouts or {}).get(suite, suite_timeout(suite))
        try:
            with target.open('wb') as log:
                if unresolved_cleanup:
                    raise OSError("previous owned suite cleanup is unresolved")
                proc=subprocess.Popen([str(repo/'tools/test'),suite],stdout=log,
                                      stderr=subprocess.STDOUT,start_new_session=True)
                try:
                    rc=proc.wait(timeout=budget)
                except subprocess.TimeoutExpired:
                    timed_out=True
                    cleanup=_terminate_owned(proc, prior_children)
                    rc=proc.returncode
                snapshot = _processes()
                orphans = {pid: state for pid, (ppid, state, birth) in snapshot.items()
                           if ppid == os.getpid() and (pid, birth) not in prior_children}
                if orphans:
                    leaked_processes = any(state != "Z" for state in orphans.values())
                    cleanup = _terminate_owned(proc, prior_children)
                if cleanup:
                    leaked_processes |= bool(cleanup["remaining_owned"])
                    unresolved_cleanup = bool(cleanup["remaining_owned"] or cleanup["signal_errors"])
            status='FAIL' if timed_out or leaked_processes else 'PASS' if rc==0 else 'SKIP' if rc==77 else 'FAIL'
            if unresolved_cleanup and status == 'PASS':
                status = 'BLOCKED'
        except OSError:
            rc=None;status='BLOCKED'
        lane=dict(suite=suite,native_exit=rc,status=status,timed_out=timed_out,
                  timeout_seconds=budget,cleanup=cleanup,leaked_processes=leaked_processes,
                  raw_log_sha256=hashlib.sha256(target.read_bytes()).hexdigest())
        lanes.append(lane)
        # Exact allowlist: no raw command/kernel/event text crosses to CI artifacts.
        (out/(suite+'.log')).write_text(json.dumps(lane,sort_keys=True)+'\n')
        print('%s %s native_exit=%s' % (suite,status,rc),flush=True)
    status=('FAIL' if any(r['status']=='FAIL' for r in lanes) else
            'BLOCKED' if not lanes or any(r['status'] in ('SKIP','BLOCKED') for r in lanes) else 'PASS')
    (out/'results.json').write_text(json.dumps(dict(schema='qualification-results/1',
        status=status,lanes=lanes),indent=2,sort_keys=True)+'\n')
    return 0 if status=='PASS' else 1


def main():
    if sys.argv[1:] in (['--help'],['-h']):
        print(__doc__);return 0
    if len(sys.argv)<3:return 2
    return run_suites(Path(__file__).resolve().parent.parent,Path(sys.argv[1]),sys.argv[2:])

if __name__=='__main__':sys.exit(main())

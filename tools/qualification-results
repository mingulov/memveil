"""Collect required suite native exits and sanitized receipts, even on failure.

Usage: tools/qualification-results OUTPUT SUITE [SUITE...]
Native output stays local in OUTPUT/raw; only results.json, the allowlisted
per-lane .log receipts, and the retained gate evidence under OUTPUT/gates
may be uploaded. A required skip blocks qualification.
"""
import hashlib
import ctypes
import os
import math
import re
import signal
import time
import json
import subprocess
import sys
from pathlib import Path

SCHEMA='qualification-results/2'


def suite_timeout(suite):
    """Allow a default 30-minute soak to finish its final cycle and cleanup."""
    if suite == "soak":
        minutes = float(os.environ.get("MEMVEIL_SOAK_MINUTES", "30"))
        if not math.isfinite(minutes) or minutes <= 0:
            raise ValueError("invalid soak duration")
        return minutes * 60 + 300
    return 1800


def _processes():
    records = {}
    for file in Path("/proc").glob("[0-9]*/stat"):
        try:
            fields = file.read_text().rsplit(")", 1)[1].split()
            records[int(file.parent.name)] = (int(fields[1]), fields[0], int(fields[19]))
        except (OSError, ValueError, IndexError):
            continue
    return records


def _same(pid, birth):
    return _processes().get(pid, (None, None, None))[2] == birth


def _terminate_owned(proc, prior_children):
    """Freeze and retire exact descendants, including separate VM sessions.

    The runner is a Linux subreaper. Targeted waitpid calls retire only the
    descendants of this invocation; unrelated resources are never signalled
    or reaped. Birth ticks guard against PID reuse during cleanup.
    """
    snapshot = _processes()
    owned = {proc.pid: snapshot[proc.pid][2]} if proc.pid in snapshot else {}
    errors = 0

    def discover():
        # TERM handlers may fork, and exiting parents transfer their children
        # to this single-threaded subreaper. Refresh both ownership routes in
        # every cleanup phase, always excluding the pre-suite child boundary.
        snapshot = _processes()
        added = set()
        changed = True
        while changed:
            changed = False
            for pid, (ppid, state, birth) in snapshot.items():
                parent_owned = (ppid in owned and ppid in snapshot
                                and snapshot[ppid][2] == owned[ppid])
                adopted = ppid == os.getpid() and (pid, birth) not in prior_children
                if (parent_owned or adopted) and owned.get(pid) != birth:
                    owned[pid] = birth
                    added.add(pid)
                    changed = True
        return snapshot, added

    def send(pid, sig):
        nonlocal errors
        if _same(pid, owned[pid]):
            try:
                os.kill(pid, sig)
            except ProcessLookupError:
                pass
            except PermissionError:
                errors += 1

    for _ in range(16):
        snapshot, added = discover()
        for pid in owned:
            send(pid, signal.SIGSTOP)
        if not added:
            break
    for pid in owned:
        send(pid, signal.SIGTERM)
        send(pid, signal.SIGCONT)
    deadline = time.monotonic() + 2
    while time.monotonic() < deadline:
        snapshot, added = discover()
        for pid in added:
            send(pid, signal.SIGSTOP)
            send(pid, signal.SIGTERM)
            send(pid, signal.SIGCONT)
        if all(pid not in snapshot or snapshot[pid][2] != birth
               or snapshot[pid][1] == "Z" for pid, birth in owned.items()):
            break
        time.sleep(0.02)
    # Re-discover during KILL and targeted reaping too: a handler can create
    # its last detached child at the end of the TERM grace period.
    deadline = time.monotonic() + 5
    reaped = 0
    empty_checks = 0
    remaining = len(owned)
    while time.monotonic() < deadline:
        snapshot, _ = discover()
        for pid in owned:
            send(pid, signal.SIGKILL)
        # Let Popen retain the direct child's exact native exit before reaping
        # adopted descendants. Never use waitpid(-1) for unrelated children.
        proc.poll()
        for pid in owned:
            if pid == proc.pid:
                continue
            try:
                got, _ = os.waitpid(pid, os.WNOHANG)
                reaped += int(got != 0)
            except ChildProcessError:
                pass
        snapshot, _ = discover()
        remaining = sum(pid in snapshot and snapshot[pid][2] == birth
                        for pid, birth in owned.items())
        empty_checks = empty_checks + 1 if not remaining else 0
        if empty_checks >= 2:
            break
        time.sleep(0.02)
    return dict(owned_processes=len(owned), reaped_descendants=reaped,
                remaining_owned=remaining, signal_errors=errors)


def _retention():
    import importlib.util
    from importlib.machinery import SourceFileLoader
    path=Path(__file__).resolve().parent.parent/'tests'/'vm'/'evidence_retention.py'
    loader=SourceFileLoader('evidence_retention',str(path))
    spec=importlib.util.spec_from_loader(loader.name,loader)
    module=importlib.util.module_from_spec(spec);loader.exec_module(module)
    return module


def run_suites(repo,out,suites,timeouts=None):
    out.mkdir(parents=True,exist_ok=True)
    raw=out/'raw';raw.mkdir(exist_ok=True)
    retention=_retention()
    owned=out.resolve()
    lanes=[]
    # Subreaper ownership belongs only to this development runner process.
    libc=ctypes.CDLL(None,use_errno=True)
    if libc.prctl(36,1,0,0,0) != 0:
        raise OSError(ctypes.get_errno(),"cannot establish child reaping")
    unresolved_cleanup = False
    for suite in suites:
        # Suite names, not arbitrary external commands, form the interface.
        if not suite or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789-' for c in suite):
            raise ValueError('invalid suite name')
        target=raw/(suite+'.log')
        cleanup = None
        timed_out = False
        leaked_processes = False
        prior_children = {(pid, birth) for pid, (ppid, state, birth) in _processes().items() if ppid == os.getpid()}
        budget = (timeouts or {}).get(suite, suite_timeout(suite))
        try:
            with target.open('wb') as log:
                if unresolved_cleanup:
                    raise OSError("previous owned suite cleanup is unresolved")
                child_env=dict(os.environ)
                child_env['MEMVEIL_EVIDENCE_DIR']=str(owned)
                proc=subprocess.Popen([str(repo/'tools/test'),suite],stdout=log,
                                      stderr=subprocess.STDOUT,start_new_session=True,
                                      env=child_env)
                try:
                    rc=proc.wait(timeout=budget)
                except subprocess.TimeoutExpired:
                    timed_out=True
                    cleanup=_terminate_owned(proc, prior_children)
                    rc=proc.returncode
                snapshot = _processes()
                orphans = {pid: state for pid, (ppid, state, birth) in snapshot.items()
                           if ppid == os.getpid() and (pid, birth) not in prior_children}
                if orphans:
                    leaked_processes = any(state != "Z" for state in orphans.values())
                    cleanup = _terminate_owned(proc, prior_children)
                if cleanup:
                    leaked_processes |= bool(cleanup["remaining_owned"])
                    unresolved_cleanup = bool(cleanup["remaining_owned"] or cleanup["signal_errors"])
            status='FAIL' if timed_out or leaked_processes else 'PASS' if rc==0 else 'SKIP' if rc==77 else 'FAIL'
            if unresolved_cleanup and status == 'PASS':
                status = 'BLOCKED'
        except OSError:
            rc=None;status='BLOCKED'
        lane=dict(suite=suite,native_exit=rc,status=status,timed_out=timed_out,
                  timeout_seconds=budget,cleanup=cleanup,leaked_processes=leaked_processes,
                  raw_log_sha256=hashlib.sha256(target.read_bytes()).hexdigest())
        lanes.append(lane)
        # Exact allowlist: no raw command/kernel/event text crosses to CI artifacts.
        (out/(suite+'.log')).write_text(json.dumps(lane,sort_keys=True)+'\n')
        # Lanes without gate-authored evidence still explain
        # themselves: skipped lanes never ran, lanes with
        # uncertain cleanup cannot trust their run directories,
        # and failed lanes (including cleanly reaped timeouts)
        # record their owned failure summary. Passed lanes keep
        # gate-authored evidence.
        if status=='SKIP':
            retention.record_lane_disposition(
                suite,'skipped',dict(status=status,native_exit=rc,
                                     timed_out=timed_out),root=out)
        elif status=='BLOCKED' or (cleanup is not None and (
                cleanup['remaining_owned'] or
                cleanup['signal_errors'])):
            detail=dict(status=status,timed_out=timed_out)
            if rc is not None:
                detail['native_exit']=rc
            if cleanup is not None:
                for key in ('owned_processes','reaped_descendants',
                            'remaining_owned','signal_errors'):
                    detail[key]=cleanup[key]
            retention.record_lane_disposition(
                suite,'cleanup-uncertain',detail,root=out)
        elif status=='FAIL':
            detail=dict(status=status,timed_out=timed_out)
            if rc is not None:
                detail['native_exit']=rc
            if cleanup is not None:
                for key in ('owned_processes','reaped_descendants',
                            'remaining_owned','signal_errors'):
                    detail[key]=cleanup[key]
            retention.record_lane_disposition(
                suite,'failed',detail,root=out)
        print('%s %s native_exit=%s' % (suite,status,rc),flush=True)
    status=('FAIL' if any(r['status']=='FAIL' for r in lanes) else
            'BLOCKED' if not lanes or any(r['status'] in ('SKIP','BLOCKED') for r in lanes) else 'PASS')
    build,toolchain=build_linkage(repo)
    doc=dict(schema=SCHEMA,status=status,required=list(suites),
        kernel=os.uname().release,
        command=dict(tool='tools/qualification-results',suites=list(suites)),
        source=source_identity(repo),build=build,toolchain=toolchain,lanes=lanes)
    validate_results(doc)
    (out/'results.json').write_text(json.dumps(doc,indent=2,sort_keys=True)+'\n')
    return 0 if status=='PASS' else 1


def source_identity(repo):
    """Owning commit and dirty flag, muted to unknown and dirty."""
    try:
        proc=subprocess.run(['git','rev-parse','HEAD'],cwd=str(repo),
                            capture_output=True,text=True,timeout=10)
        sha=proc.stdout.strip() if proc.returncode==0 else ''
    except (OSError,subprocess.TimeoutExpired):
        sha=''
    if not sha:
        return dict(commit='unknown',dirty=True)
    try:
        proc=subprocess.run(['git','status','--porcelain'],cwd=str(repo),
                            capture_output=True,text=True,timeout=10)
    except (OSError,subprocess.TimeoutExpired):
        return dict(commit=sha,dirty=True)
    if proc.returncode!=0:
        return dict(commit=sha,dirty=True)
    return dict(commit=sha,dirty=bool(proc.stdout.strip()))


def build_linkage(repo):
    """(build, toolchain) from the build receipt, or absence.

    Lanes test the build tree as-is; the linkage names the
    exact sealed inventory digest, observed toolchain, and
    output hashes when tools/build receipted them. A missing
    or malformed receipt records absence instead of failing
    the lanes.
    """
    try:
        doc=json.loads((Path(repo)/'build/build-receipt.json').read_bytes().decode('utf-8'))
        git=doc['git_descriptive'];digest=doc['inventory']['digest']
        toolchain=doc['toolchain_observed'];outputs=doc['outputs']
    except (OSError,ValueError,KeyError,TypeError):
        return dict(present=False),None
    if not isinstance(git,str) or not git or not isinstance(digest,str) \
            or not isinstance(toolchain,dict) or not isinstance(outputs,dict) or not outputs:
        return dict(present=False),None
    artifacts={}
    for rel,entry in outputs.items():
        if not isinstance(rel,str) or not isinstance(entry,dict):
            return dict(present=False),None
        sha=entry.get('sha256')
        if not isinstance(sha,str) or not sha:
            return dict(present=False),None
        artifacts[rel]=sha
    for name,value in toolchain.items():
        if not isinstance(name,str) or not isinstance(value,str) or not value:
            return dict(present=False),None
    return dict(present=True,git=git,sources_digest=digest,artifacts=artifacts),dict(toolchain)


def validate_results(doc):
    """Strict grammar plus recomputed overall status."""
    if not isinstance(doc,dict) or set(doc)!={'schema','status','required','kernel','command','source','build','toolchain','lanes'}:
        raise ValueError('bad results shape')
    if doc['schema']!=SCHEMA:
        raise ValueError('bad results schema')
    if doc['status'] not in ('PASS','FAIL','SKIP','BLOCKED'):
        raise ValueError('bad results status')
    required=doc['required']
    if not isinstance(required,list) or any(not isinstance(s,str) or not re.fullmatch(r'[a-z0-9-]+',s) for s in required):
        raise ValueError('bad required lanes')
    if not isinstance(doc['kernel'],str) or not doc['kernel']:
        raise ValueError('bad kernel identity')
    command=doc['command']
    if not isinstance(command,dict) or command.get('tool')!='tools/qualification-results' or command.get('suites')!=required:
        raise ValueError('bad command record')
    source=doc['source']
    if not isinstance(source,dict) or set(source)!={'commit','dirty'}:
        raise ValueError('bad source record')
    if source['commit']!='unknown' and not re.fullmatch(r'[0-9a-f]{40}',source['commit']):
        raise ValueError('bad source commit')
    if source['dirty'] is not True and source['dirty'] is not False:
        raise ValueError('bad source dirty flag')
    if source['commit']=='unknown' and source['dirty'] is not True:
        raise ValueError('bad source dirty flag')
    build=doc['build']
    if not isinstance(build,dict) or 'present' not in build:
        raise ValueError('bad build linkage')
    if build['present'] is False:
        if set(build)!={'present'}:
            raise ValueError('bad build linkage')
    elif build['present'] is True:
        if set(build)!={'present','git','sources_digest','artifacts'}:
            raise ValueError('bad build linkage')
        if not isinstance(build['git'],str) or not build['git']:
            raise ValueError('bad build linkage')
        if not re.fullmatch(r'[0-9a-f]{64}',build['sources_digest'] or ''):
            raise ValueError('bad build linkage')
        if not isinstance(build['artifacts'],dict) or not build['artifacts']:
            raise ValueError('bad build linkage')
        for digest in build['artifacts'].values():
            if not re.fullmatch(r'[0-9a-f]{64}',digest or ''):
                raise ValueError('bad build linkage')
    else:
        raise ValueError('bad build linkage')
    toolchain=doc['toolchain']
    if toolchain is not None and (not isinstance(toolchain,dict) or any(not isinstance(k,str) or not isinstance(v,str) for k,v in toolchain.items())):
        raise ValueError('bad toolchain record')
    if (toolchain is None)==bool(build.get('present')):
        raise ValueError('bad toolchain record')
    lanes=doc['lanes']
    if not isinstance(lanes,list):
        raise ValueError('bad lanes')
    for lane in lanes:
        if not isinstance(lane,dict) or set(lane)!={'suite','native_exit','status','timed_out','timeout_seconds','cleanup','leaked_processes','raw_log_sha256'}:
            raise ValueError('bad lane record')
        if not re.fullmatch(r'[a-z0-9-]+',lane['suite'] or ''):
            raise ValueError('bad lane record')
        if lane['native_exit'] is not None and (not isinstance(lane['native_exit'],int) or isinstance(lane['native_exit'],bool)):
            raise ValueError('bad lane record')
        if lane['status'] not in ('PASS','FAIL','SKIP','BLOCKED'):
            raise ValueError('bad lane record')
        if lane['timed_out'] is not True and lane['timed_out'] is not False:
            raise ValueError('bad lane record')
        if not isinstance(lane['timeout_seconds'],(int,float)) or isinstance(lane['timeout_seconds'],bool) or lane['timeout_seconds']<=0:
            raise ValueError('bad lane record')
        cleanup=lane['cleanup']
        if cleanup is not None and (not isinstance(cleanup,dict) or set(cleanup)!={'owned_processes','reaped_descendants','remaining_owned','signal_errors'}):
            raise ValueError('bad lane record')
        if lane['leaked_processes'] is not True and lane['leaked_processes'] is not False:
            raise ValueError('bad lane record')
        if not re.fullmatch(r'[0-9a-f]{64}',lane['raw_log_sha256'] or ''):
            raise ValueError('bad lane record')
    want='FAIL' if any(r['status']=='FAIL' for r in lanes) else 'BLOCKED' if not lanes or any(r['status'] in ('SKIP','BLOCKED') for r in lanes) else 'PASS'
    if doc['status']!=want:
        raise ValueError('results status drifts from its lanes')
    return doc


def main():
    if sys.argv[1:] in (['--help'],['-h']):
        print(__doc__);return 0
    if len(sys.argv)<3:return 2
    return run_suites(Path(__file__).resolve().parent.parent,Path(sys.argv[1]),sys.argv[2:])

if __name__=='__main__':sys.exit(main())

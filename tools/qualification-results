"""Collect required suite native exits and sanitized receipts, even on failure.

Usage: tools/qualification-results OUTPUT SUITE [SUITE...]
Native output stays local in OUTPUT/raw; only results.json and the allowlisted
per-lane .log receipts may be uploaded. A required skip blocks qualification.
"""
import hashlib
import json
import subprocess
import sys
from pathlib import Path


def run_suites(repo,out,suites):
    out.mkdir(parents=True,exist_ok=True)
    raw=out/'raw';raw.mkdir(exist_ok=True)
    lanes=[]
    for suite in suites:
        # Suite names, not arbitrary external commands, form the interface.
        if not suite or any(c not in 'abcdefghijklmnopqrstuvwxyz0123456789-' for c in suite):
            raise ValueError('invalid suite name')
        target=raw/(suite+'.log')
        try:
            with target.open('wb') as log:
                proc=subprocess.run([str(repo/'tools/test'),suite],stdout=log,
                                    stderr=subprocess.STDOUT,timeout=1800)
            rc=proc.returncode
            status='PASS' if rc==0 else 'SKIP' if rc==77 else 'FAIL'
        except subprocess.TimeoutExpired:
            rc=None;status='FAIL'
        except OSError:
            rc=None;status='BLOCKED'
        lane=dict(suite=suite,native_exit=rc,status=status,
                  raw_log_sha256=hashlib.sha256(target.read_bytes()).hexdigest())
        lanes.append(lane)
        # Exact allowlist: no raw command/kernel/event text crosses to CI artifacts.
        (out/(suite+'.log')).write_text(json.dumps(lane,sort_keys=True)+'\n')
        print('%s %s native_exit=%s' % (suite,status,rc),flush=True)
    status=('FAIL' if any(r['status']=='FAIL' for r in lanes) else
            'BLOCKED' if not lanes or any(r['status'] in ('SKIP','BLOCKED') for r in lanes) else 'PASS')
    (out/'results.json').write_text(json.dumps(dict(schema='qualification-results/1',
        status=status,lanes=lanes),indent=2,sort_keys=True)+'\n')
    return 0 if status=='PASS' else 1


def main():
    if sys.argv[1:] in (['--help'],['-h']):
        print(__doc__);return 0
    if len(sys.argv)<3:return 2
    return run_suites(Path(__file__).resolve().parent.parent,Path(sys.argv[1]),sys.argv[2:])

if __name__=='__main__':sys.exit(main())

    python3 - "$TMP" "$ROOT/tests/fixtures/reader/corrupt-tail" <<'PYEOF'
import json, os, sys
tmp, src = sys.argv[1], sys.argv[2]
tpl = json.loads(
    open(src + '/events.ndjson', 'rb').read().split(b'\n')[0]
)
sess = open(src + '/session.json', 'rb').read()
def line(i):
    d = dict(tpl)
    d['seq'] = str(i)
    d['ts_ns'] = str(1000000000 + i * 1000)
    dd = dict(tpl['data'])
    dd['operation_id'] = 'op-%d' % i
    d['data'] = dd
    return json.dumps(d, separators=(', ', ': ')).encode() + b'\n'
os.makedirs(tmp + '/sparse-cap', exist_ok=True)
open(tmp + '/sparse-cap/session.json', 'wb').write(sess)
with open(tmp + '/sparse-cap/events.ndjson', 'wb') as f:
    i = 1
    while f.tell() <= 270000000:
        f.write(line(i))
        i += 1
os.makedirs(tmp + '/bigsession-cap', exist_ok=True)
trimmed = sess.rstrip()
pad = trimmed[:-1] + b', "pad": "' + b'x' * 17000000 + b'"}\n'
open(tmp + '/bigsession-cap/session.json', 'wb').write(pad)
open(tmp + '/bigsession-cap/events.ndjson', 'wb').write(
    open(src + '/events.ndjson', 'rb').read())
os.makedirs(tmp + '/large-cap', exist_ok=True)
open(tmp + '/large-cap/session.json', 'wb').write(sess)
with open(tmp + '/large-cap/events.ndjson', 'wb') as f:
    for i in range(1, 164001):
        f.write(line(i))
PYEOF
    python3 - "$BIN" report "$TMP/sparse-cap" \

suite_doctor() {
    # No fixture prerequisite: the suite judges the built
    # binary live. A previous revision required a
    # unit-test-written JSON sidecar; the producer went
    # away with the Mojo tests while the check stayed,
    # failing every clean checkout. The fixture render is
    # pinned by the doctor unit tests and the schema
    # oracle still judges every live JSON below, so the
    # sidecar carried no unique coverage. Every input
    # here is generated fresh in $TMP from the binary
    # under test, never read from ambient build
    # leftovers, so a stale file cannot mask a break.
    BIN="$(memveil_bin)"
    if [ ! -x "$BIN" ]; then
        echo "doctor: missing $BIN (run $(memveil_build_hint) first)" >&2
        return 1
    fi
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    failed=0

    (cd "$ROOT" && "$BIN" doctor --json >"$TMP/live.json" 2>"$TMP/err")
    rc=$?
    # No validated profile is admitted yet, so the live verdict is
    # unavailable (exit 3) on every host; only the reason varies.
    if [ "$rc" -ne 3 ]; then
        echo "doctor: live doctor --json exit $rc, want 3" >&2
        failed=1
    fi
    if ! "$ROOT/tools/validate-schemas" --check-doctor \
        "$TMP/live.json" >/dev/null 2>&1; then
        echo "doctor: oracle rejected live JSON" >&2
        failed=1
    fi
    if ! python3 - "$TMP/live.json" <<'PYEOF'; then
import json, os, sys
doc = json.load(open(sys.argv[1]))
un = os.uname()
assert doc["mode"] == "passive", "mode"
assert doc["kernel"]["release"] == un.release, "release"
assert doc["kernel"]["arch"] == un.machine, "arch"
assert doc["privilege"]["euid"] == os.geteuid(), "euid"
assert doc["verdict"] == "unavailable", "verdict"
PYEOF
        echo "doctor: live facts mismatch uname/id" >&2
        failed=1
    fi

    (cd "$ROOT" && "$BIN" doctor >"$TMP/live.txt" 2>"$TMP/err")
    rc=$?
    if [ "$rc" -ne 3 ]; then
        echo "doctor: live doctor exit $rc, want 3" >&2
        failed=1
    elif ! head -1 "$TMP/live.txt" | grep -q "memveil doctor (passive, live evidence)"; then
        echo "doctor: live text lacks header" >&2
        failed=1
    fi

    (cd "$ROOT" && "$BIN" doctor --help >"$TMP/out" 2>"$TMP/err")
    if [ "$?" -ne 0 ] || [ ! -s "$TMP/out" ]; then
        echo "doctor: --help must exit 0 with usage" >&2
        failed=1
    fi
    (cd "$ROOT" && "$BIN" doctor --bogus >"$TMP/out" 2>"$TMP/err")
    if [ "$?" -ne 2 ]; then
        echo "doctor: --bogus must exit 2" >&2
        failed=1
    elif [ -s "$TMP/out" ]; then
        echo "doctor: --bogus must keep stdout empty" >&2
        failed=1
    elif [ ! -s "$TMP/err" ]; then
        echo "doctor: --bogus must explain on stderr" >&2
        failed=1
    fi

    # An explicit null remedy violates the schema's string-only
    # constraint; the validator must reject it, not skip it.
    if ! python3 - "$TMP/live.json" "$TMP/nullrem.json" <<'PYEOF'; then
import json, sys
doc = json.load(open(sys.argv[1]))
assert doc["capabilities"], "no caps"
doc["capabilities"][0]["remedy"] = None
json.dump(doc, open(sys.argv[2], "w"))
PYEOF
        echo "doctor: null-remedy fixture build failed" >&2
        failed=1
    elif "$ROOT/tools/validate-schemas" --check-doctor \
        "$TMP/nullrem.json" >/dev/null 2>&1; then
        echo "doctor: validator accepted null remedy" >&2
        failed=1
    fi

    (cd "$ROOT" && "$BIN" doctor --json --capability all \
        >"$TMP/all.json" 2>"$TMP/err")
    rc=$?
    if [ "$rc" -ne 3 ]; then
        echo "doctor: --capability all exit $rc, want 3" >&2
        failed=1
    fi
    if ! "$ROOT/tools/validate-schemas" --check-doctor \
        "$TMP/all.json" >/dev/null 2>&1; then
        echo "doctor: oracle rejected --capability all JSON" >&2
        failed=1
    fi
    if ! python3 - "$TMP/all.json" <<'PYEOF'; then
import json, sys
doc = json.load(open(sys.argv[1]))
assert doc["mode"] == "passive", "mode"
assert all(c["status"] in ("unknown", "unavailable", "unsupported")
           for c in doc["capabilities"]), "status"
PYEOF
        echo "doctor: --capability all facts mismatch" >&2
        failed=1
    fi

    (cd "$ROOT" && "$BIN" doctor --json --load-check \
        --capability attempt-trace >"$TMP/lc.json" 2>"$TMP/err")
    rc=$?
    if [ "$rc" -ne 3 ]; then
        echo "doctor: --load-check exit $rc, want 3" >&2
        failed=1
    fi
    if ! "$ROOT/tools/validate-schemas" --check-doctor \
        "$TMP/lc.json" >/dev/null 2>&1; then
        echo "doctor: oracle rejected --load-check JSON" >&2
        failed=1
    fi
    if ! python3 - "$TMP/lc.json" <<'PYEOF'; then
import json, sys
doc = json.load(open(sys.argv[1]))
assert doc["mode"] == "load-check", "mode"
assert doc["load"][0]["state"] == "skipped", "load state"
PYEOF
        echo "doctor: --load-check facts mismatch" >&2
        failed=1
    fi

    # Passive doctor is bridge-independent: with
    # LMB_NATIVE_LIB aimed at a blocking stdin pipe,
    # doctor still completes promptly (regression pin
    # for the /dev/stdin hang) and its trace shows no
    # probe or open of the env-selected path or any
    # bridge candidate.
    mkfifo "$TMP/dstdin"
    exec 9<>"$TMP/dstdin"
    # LeakSanitizer cannot run under ptrace; the audit keeps ASan/UBSan
    # while leak checking stays covered by the unstrace'd runs.
    # (Plain binaries ignore LSAN_OPTIONS.)
    (cd "$ROOT" && timeout 20 strace -f -o "$TMP/dstdin.trace" \
        -e trace=openat,open,openat2,access,faccessat \
        env LSAN_OPTIONS=detect_leaks=0 LMB_NATIVE_LIB=/dev/stdin \
        "$BIN" doctor \
        <"$TMP/dstdin" >"$TMP/dstdin.out" 2>"$TMP/dstdin.err")
    rc=$?
    exec 9>&-
    if [ "$rc" -ne 3 ]; then
        echo "doctor: hostile LMB_NATIVE_LIB exit $rc, want 3" >&2
        failed=1
    elif [ ! -s "$TMP/dstdin.out" ]; then
        echo "doctor: hostile LMB_NATIVE_LIB left stdout empty" >&2
        failed=1
    elif grep -qE '"/dev/stdin"' "$TMP/dstdin.trace"; then
        echo "doctor: trace shows env-selected stream touched" >&2
        failed=1
    # Tripwire: the statically linked binary must never reference
    # the deleted bridge; a match means the bridge came back.
    elif grep -q "libbpf_mojo" "$TMP/dstdin.trace"; then
        echo "doctor: trace shows bridge candidate touched" >&2
        failed=1
    else
        echo "ok doctor hostile-env (exit 3, no bridge touch)"
    fi

    # Same hostile run with an explicit capability set.
    exec 9<>"$TMP/dstdin"
    (cd "$ROOT" && timeout 20 strace -f -o "$TMP/dstdin-all.trace" \
        -e trace=openat,open,openat2,access,faccessat \
        env LSAN_OPTIONS=detect_leaks=0 LMB_NATIVE_LIB=/dev/stdin \
        "$BIN" doctor --capability all \
        <"$TMP/dstdin" >"$TMP/dstdin-all.out" 2>"$TMP/dstdin-all.err")
    rc=$?
    exec 9>&-
    if [ "$rc" -ne 3 ]; then
        echo "doctor: hostile --capability all exit $rc, want 3" >&2
        failed=1
    elif [ ! -s "$TMP/dstdin-all.out" ]; then
        echo "doctor: hostile --capability all left stdout empty" >&2
        failed=1
    elif grep -qE '"/dev/stdin"' "$TMP/dstdin-all.trace"; then
        echo "doctor: trace shows env-selected stream touched" >&2
        failed=1
    # Tripwire: see above.
    elif grep -q "libbpf_mojo" "$TMP/dstdin-all.trace"; then
        echo "doctor: trace shows bridge candidate touched" >&2
        failed=1
    else
        echo "ok doctor hostile-env-all (exit 3, no bridge touch)"
    fi

    if [ "$failed" -ne 0 ]; then
        echo "doctor: FAILED" >&2
        return 1
    fi
    echo "doctor: live checks passed"
    return 0
}



suite_record() {
    echo "record: unit suites passed"
    BIN="$(memveil_bin)"
    if [ ! -x "$BIN" ]; then
        echo "record: missing $BIN (run $(memveil_build_hint) first)" >&2
        return 1
    fi
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    rfailed=0
    rexpect() { # <case> <want-exit> <want-err> <residual-or-empty> -- <args...>
        cname=$1; want_exit=$2; want_err=$3; residual=$4
        shift 4
        if [ "$1" = "--" ]; then shift; fi
        "$BIN" record "$@" >"$TMP/$cname.out" 2>"$TMP/$cname.err"
        rc=$?
        if [ "$rc" -ne "$want_exit" ]; then
            echo "record: case $cname exit $rc, want $want_exit" >&2
            cat "$TMP/$cname.err" >&2
            rfailed=1
            return 0
        fi
        if ! grep -qF -- "$want_err" "$TMP/$cname.err"; then
            echo "record: case $cname missing [$want_err]" >&2
            cat "$TMP/$cname.err" >&2
            rfailed=1
            return 0
        fi
        if [ -n "$residual" ] && [ -e "$residual" ]; then
            echo "record: case $cname left residual $residual" >&2
            rfailed=1
            return 0
        fi
        echo "ok record-cli $cname (exit $rc)"
    }
    "$BIN" record --help >"$TMP/help.out" 2>"$TMP/help.err"
    rc=$?
    if [ "$rc" -ne 0 ] || ! grep -qF "usage: memveil record" "$TMP/help.out"; then
        echo "record: case help failed (exit $rc)" >&2
        rfailed=1
    else
        echo "ok record-cli help (exit 0)"
    fi
    rexpect no-args 2 "missing --output" "" --
    rexpect unknown-flag 2 "unknown option" "" -- --bogus
    rexpect bad-duration 2 "bad decimal" "" -- \
        --output "$TMP/r" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --duration 0
    rexpect duration-suffix 2 "bad decimal" "" -- \
        --output "$TMP/r" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --duration 60s
    rexpect device-empty 2 "--device needs a value" "" -- \
        --output "$TMP/r-deve" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --device ""
    devlong=$(python3 -c "print('d' * 257)")
    rexpect device-long 2 "--device must be 1..256 characters" "" -- \
        --output "$TMP/r-devl" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --device "$devlong"
    rexpect budget-low 3 "below 131072" "$TMP/r-low" -- \
        --output "$TMP/r-low" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --bridge "$TMP/nolib.so" --max-events-bytes 131071
    rexpect budget-high 3 "above 4294967296" "$TMP/r-high" -- \
        --output "$TMP/r-high" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --bridge "$TMP/nolib.so" --max-events-bytes 4294967297
    # The binary embeds its channel objects, so a missing-object
    # discovery refusal is unreachable; refusal coverage stays in
    # record-failures + the explicit-path record cases below.
    echo "record-cli: no-object skipped (binary embeds objects)"
    # The loader is statically linked, so a missing-bridge
    # discovery refusal is unreachable; refusal coverage stays
    # in record-failures + the explicit-path record cases
    # below.
    echo "record-cli: no-bridge skipped (loader is static)"
    host_ok=0
    if [ "$(uname -m)" = "x86_64" ]; then
        kmaj=$(uname -r | cut -d. -f1)
        case $kmaj in
            '' | *[!0-9]*) ;;
            *) if [ "$kmaj" -ge 7 ]; then host_ok=1; fi ;;
        esac
    fi
    if [ "$host_ok" -eq 1 ]; then
        rexpect bad-object 3 "object refused: not a BPF object" \
            "$TMP/r-badobj" -- \
            --output "$TMP/r-badobj" \
            --object "$ROOT/tests/fixtures/elf/badarch.o" \
            --bridge "$TMP/nolib.so"
        rexpect profile-miss 3 "unknown --profile" "$TMP/r-miss" -- \
            --output "$TMP/r-miss" \
            --object "$ROOT/tests/fixtures/elf/ok.o" \
            --bridge "$TMP/nolib.so" --profile definitely-not-a-profile
        rexpect bad-capability 3 "unknown capability: nope" \
            "$TMP/r-badcap" -- \
            --output "$TMP/r-badcap" \
            --object "$ROOT/tests/fixtures/elf/ok.o" \
            --bridge "$TMP/nolib.so" --capability attempt-trace,nope
        # The kernel gate refuses denied tracefs before any format read.
        if [ ! -r /sys/kernel/tracing/events ] || [ ! -x /sys/kernel/tracing/events ]; then
            rexpect tracefs-denied 3 "code: tracefs-denied" "$TMP/r-nofmt" -- \
                --output "$TMP/r-nofmt" \
                --object "$ROOT/tests/fixtures/elf/ok.o" \
                --bridge "$TMP/nolib.so"
        elif [ ! -f /sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format ]; then
            rexpect no-format 3 "format unreadable" "$TMP/r-nofmt" -- \
                --output "$TMP/r-nofmt" \
                --object "$ROOT/tests/fixtures/elf/ok.o" \
                --bridge "$TMP/nolib.so"
        else
            echo "record-cli: no-format skipped (live hook present)"
        fi
    else
        echo "record-cli: env cases skipped (needs x86_64 kernel >= 7)"
    fi
    if [ "$rfailed" -ne 0 ]; then
        return 1
    fi
    echo "record: CLI refusal cases passed"
    return 0
}

suite_qualify() {
    BIN="$(memveil_bin)"
    if [ ! -x "$BIN" ]; then
        echo "qualify: missing $BIN (run $(memveil_build_hint) first)" >&2
        return 1
    fi
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    qfailed=0
    qexpect() { # <case> <want-exit> <want-err> -- <args...>
        cname=$1; want_exit=$2; want_err=$3
        shift 3
        if [ "$1" = "--" ]; then shift; fi
        (cd "$ROOT" && "$BIN" qualify "$@" >"$TMP/$cname.out" 2>"$TMP/$cname.err")
        rc=$?
        if [ "$rc" -ne "$want_exit" ]; then
            echo "qualify: case $cname exit $rc, want $want_exit" >&2
            cat "$TMP/$cname.err" >&2
            qfailed=1
            return 0
        fi
        if ! grep -qF "$want_err" "$TMP/$cname.err"; then
            echo "qualify: case $cname missing [$want_err]" >&2
            cat "$TMP/$cname.err" >&2
            qfailed=1
            return 0
        fi
        echo "ok qualify-cli $cname (exit $rc)"
    }
    (cd "$ROOT" && "$BIN" qualify --help >"$TMP/help.out" 2>"$TMP/help.err")
    rc=$?
    if [ "$rc" -ne 0 ] || ! grep -qF "usage: memveil qualify" "$TMP/help.out"; then
        echo "qualify: --help must exit 0 with usage" >&2
        qfailed=1
    fi
    (cd "$ROOT" && "$BIN" qualify --bogus >"$TMP/bogus.out" 2>"$TMP/bogus.err")
    if [ "$?" -ne 2 ]; then
        echo "qualify: --bogus must exit 2" >&2
        qfailed=1
    elif [ -s "$TMP/bogus.out" ]; then
        echo "qualify: --bogus must keep stdout empty" >&2
        qfailed=1
    elif [ ! -s "$TMP/bogus.err" ]; then
        echo "qualify: --bogus must explain on stderr" >&2
        qfailed=1
    fi
    # Argument parsing and capability parsing precede
    # evidence handling, so these refusals run on any host
    # with no BPF and no privileged smoke.
    qexpect missing-output 2 "missing --output" -- \
        --object "$ROOT/tests/fixtures/elf/ok.o"
    # Qualify mints explicit artifacts only: without --object the
    # run refuses before the smoke on every host (no discovery).
    qexpect no-object 3 "no object: pass --object PATH" -- \
        --output "$TMP/q-noobj" --bridge "$TMP/nolib.so"
    qexpect bad-capability 3 "bad capability list" -- \
        --output "$TMP/q-badcap" \
        --object "$ROOT/tests/fixtures/elf/ok.o" \
        --capability 'attempt-trace,'
    qexpect convert-channel 3 "conversion-observe has no record channel" -- \
        --output "$TMP/q-conv" \
        --object "$ROOT/tests/fixtures/elf/ok.o" \
        --capability attempt-trace,conversion-observe
    bexpect() { # <case> <want-exit> <want-err> -- <args...>
        cname=$1; want_exit=$2; want_err=$3
        shift 3
        if [ "$1" = "--" ]; then shift; fi
        (cd "$ROOT" && "$BIN" bind-profile "$@" >"$TMP/$cname.out" 2>"$TMP/$cname.err")
        rc=$?
        if [ "$rc" -ne "$want_exit" ]; then
            echo "qualify: bind case $cname exit $rc, want $want_exit" >&2
            cat "$TMP/$cname.err" >&2
            qfailed=1
            return 0
        fi
        if ! grep -qF "$want_err" "$TMP/$cname.err"; then
            echo "qualify: bind case $cname missing [$want_err]" >&2
            cat "$TMP/$cname.err" >&2
            qfailed=1
            return 0
        fi
        if [ -s "$TMP/$cname.out" ]; then
            echo "qualify: bind case $cname must keep stdout empty" >&2
            qfailed=1
            return 0
        fi
        echo "ok bind-cli $cname (exit $rc)"
    }
    (cd "$ROOT" && "$BIN" bind-profile --help >"$TMP/bind-help.out" 2>"$TMP/bind-help.err")
    rc=$?
    if [ "$rc" -ne 0 ] || ! grep -qF "usage: memveil bind-profile" "$TMP/bind-help.out"; then
        echo "qualify: bind-profile --help must exit 0 with usage" >&2
        qfailed=1
    fi
    # Usage and capability parsing precede evidence
    # handling, so these refusals run on any host.
    bexpect bind-bogus 2 "unknown option: --bogus" -- --bogus
    bexpect bind-missing-output 2 "missing --output" -- \
        --object "$ROOT/tests/fixtures/elf/ok.o"
    bexpect bind-bad-id 2 "bad --profile-id" -- \
        --output "$TMP/b-id.json" --profile-id 'has space'
    bexpect bind-bad-capability 3 "bad capability list" -- \
        --output "$TMP/b-badcap" \
        --object "$ROOT/tests/fixtures/elf/ok.o" \
        --capability 'attempt-trace,'
    bexpect bind-convert 3 "conversion-observe has no record channel" -- \
        --output "$TMP/b-conv" \
        --object "$ROOT/tests/fixtures/elf/ok.o" \
        --capability attempt-trace,conversion-observe
    # End-to-end mint through the built binary; the independent
    # oracle checks the minted document shape. Live bindings need
    # root reads, so an unprivileged host skips with cause (the
    # fixture-rooted mint probe retired with the Mojo tree;
    # fixture-rooted minting stays pinned by the bind unit
    # tests).
    (cd "$ROOT" && "$BIN" bind-profile \
        --output "$TMP/minted.json" \
        --object "$ROOT/tests/fixtures/elf/ok.o" \
        --profiles-dir "$ROOT/tests/fixtures/qualify/profiles" \
        >"$TMP/minted.out" 2>"$TMP/minted.err")
    rc=$?
    if [ "$rc" -ne 0 ] \
        && grep -q "live bindings unmeasurable" "$TMP/minted.err"; then
        echo "qualify-cli: bind-fixture-mint skipped (needs root reads)"
    elif [ "$rc" -ne 0 ]; then
        echo "qualify: bind-fixture-mint exit $rc" >&2
        cat "$TMP/minted.err" >&2
        qfailed=1
    elif ! "$ROOT/tools/validate-schemas" --check-profile \
        "$TMP/minted.json" >"$TMP/minted.check" 2>&1; then
        echo "qualify: oracle rejected minted document" >&2
        cat "$TMP/minted.check" >&2
        qfailed=1
    else
        echo "ok bind-fixture-mint (oracle accepted)"
    fi
    # Profile resolution runs past the kernel-floor gate,
    # so these cases need x86_64 kernel >= 7; the floor
    # refusal itself is pinned fixture-backed in the qualify
    # unit tests (plan_below_floor_refuses).
    host_ok=0
    if [ "$(uname -m)" = "x86_64" ]; then
        kmaj=$(uname -r | cut -d. -f1)
        case $kmaj in
            '' | *[!0-9]*) ;;
            *) if [ "$kmaj" -ge 7 ]; then host_ok=1; fi ;;
        esac
    fi
    if [ "$host_ok" -eq 1 ]; then
        qexpect profiles-dir-missing 3 "cannot load profiles: " -- \
            --output "$TMP/q-noprof" \
            --object "$ROOT/tests/fixtures/elf/ok.o" \
            --profiles-dir "$TMP/does-not-exist"
        qexpect profile-unknown 3 "unknown --profile: " -- \
            --output "$TMP/q-unk" \
            --object "$ROOT/tests/fixtures/elf/ok.o" \
            --profiles-dir "$ROOT/tests/fixtures/qualify/profiles" \
            --profile definitely-not-a-profile
        qexpect profile-unparsable 3 "cannot parse --profile: " -- \
            --output "$TMP/q-badprof" \
            --object "$ROOT/tests/fixtures/elf/ok.o" \
            --profile "$ROOT/tests/fixtures/layout/garbage.format"
    else
        echo "qualify-cli: profile cases skipped (needs x86_64 kernel >= 7)"
    fi
    for receipt in "$ROOT"/tests/fixtures/scan/profiles/receipts/*.json; do
        if ! "$ROOT/tools/validate-schemas" --check-receipt \
            "$receipt" >/dev/null 2>&1; then
            echo "qualify: oracle rejected $receipt" >&2
            qfailed=1
        fi
    done
    # A promoted grade is schema-invalid even when every
    # other field is well-formed; the oracle must refuse.
    if ! python3 - "$ROOT/tests/fixtures/scan/profiles/receipts/scan-ref.json" \
        "$TMP/promoted.json" <<'PYEOF'; then
import json, sys
doc = json.load(open(sys.argv[1]))
doc["grade"] = "validated"
json.dump(doc, open(sys.argv[2], "w"))
PYEOF
        echo "qualify: promoted-grade fixture build failed" >&2
        qfailed=1
    elif "$ROOT/tools/validate-schemas" --check-receipt \
        "$TMP/promoted.json" >/dev/null 2>&1; then
        echo "qualify: oracle accepted promoted grade" >&2
        qfailed=1
    fi
    if [ "$qfailed" -ne 0 ]; then
        echo "qualify: FAILED" >&2
        return 1
    fi
    echo "qualify: unit suite plus CLI refusal cases passed"
    return 0
}


import json, re, sys
src = open(sys.argv[1]).read()
schema = json.load(open(sys.argv[2]))
psrc = src.split('\ndef _top_field_known(')[0]
names = ['parse_event', '_parse_source', '_parse_observer',
         '_parse_snapshot_scope', '_parse_bounce', '_parse_map_result',
         '_parse_unmap', '_parse_copy', '_parse_sync',
         '_parse_transition', '_parse_pool', '_parse_gap',
         '_parse_marker', '_parse_snapshot']
starts = {}
for n in names:
    m = re.search(r'\ndef %s\(' % n, psrc)
    if not m:
        raise SystemExit('missing parser ' + n)
    starts[n] = m.start()
ordered = sorted(starts, key=starts.get)
bodies = {}
for i, n in enumerate(ordered):
    end = starts[ordered[i + 1]] if i + 1 < len(ordered) else len(psrc)
    bodies[n] = psrc[starts[n]:end]
pkeys = {n: set(re.findall(r'key == "([^"]+)"', b))
         for n, b in bodies.items()}
ctx_of = {'parse_event': 'top', '_parse_source': 'source',
          '_parse_observer': 'observer', '_parse_snapshot_scope': 'scope',
          '_parse_bounce': 'bounce_attempt',
          '_parse_map_result': 'map_result', '_parse_unmap': 'unmap',
          '_parse_copy': 'copy', '_parse_sync': 'sync_request',
          '_parse_transition': 'transition_result',
          '_parse_pool': 'pool_sample', '_parse_gap': 'gap',
          '_parse_marker': 'marker',
          '_parse_snapshot': 'counter_snapshot'}
mine = {}
for fn, ctx in (('_top_field_known', 'top'),
                ('_source_field_known', 'source'),
                ('_observer_field_known', 'observer'),
                ('_scope_field_known', 'scope')):
    m = re.search(r'\ndef %s\(.*?\n(.*?)\n\n\ndef ' % fn, src, re.S)
    if not m:
        raise SystemExit('missing mirror ' + fn)
    mine[ctx] = set(re.findall(r'key == "([^"]+)"', m.group(1)))
m = re.search(r'\ndef _data_field_known\(.*?\n(.*?)\n\n\ndef ', src, re.S)
if not m:
    raise SystemExit('missing mirror _data_field_known')
for sec in re.split(r'\n    if kind == "', m.group(1))[1:]:
    kind = sec.split('"', 1)[0]
    mine[kind] = set(re.findall(r'key == "([^"]+)"', sec))
skeys = {'top': set(schema['properties'].keys()),
         'source': set(schema['properties']['source']['properties'].keys()),
         'observer': set(
             schema['properties']['observer_context']['properties'].keys())}
for b in schema['allOf']:
    k = b['if']['properties']['kind']['const']
    dp = b['then']['properties']['data']['properties']
    skeys[k] = set(dp.keys())
    if k == 'counter_snapshot':
        skeys['scope'] = set(dp['scope']['properties'].keys())
for n, ctx in ctx_of.items():
    if pkeys[n] != mine.get(ctx, set()):
        raise SystemExit(
            'drift parser-vs-mirror at %s: %s vs %s'
            % (ctx, sorted(pkeys[n]), sorted(mine.get(ctx, set()))))
    if pkeys[n] != skeys.get(ctx, set()):
        raise SystemExit(
            'drift parser-vs-schema at %s: %s vs %s'
            % (ctx, sorted(pkeys[n]), sorted(skeys.get(ctx, set()))))
LEAD_OF = {'parse_string': 's', '_parse_id': 's',
           'parse_u64_field': 's', 'parse_bool': 'b',
           'parse_int': 'n', 'parse_maybe_string': 'S',
           '_parse_maybe_id': 'S', 'parse_maybe_u64': 'S',
           'parse_maybe_int': 'N', '_parse_source': 'o',
           '_parse_observer': 'o', '_parse_snapshot_scope': 'o',
           'skip_value': 'o'}
TOK = re.compile(r'(parse_maybe_u64|parse_maybe_int|'
                 r'parse_maybe_string|_parse_maybe_id|_parse_id|'
                 r'parse_u64_field|parse_bool|parse_int|parse_string|'
                 r'_parse_source|_parse_observer|'
                 r'_parse_snapshot_scope|skip_value)\s*\(')
ptypes = {}
for n in names:
    for sec in re.split(r'\n\s*(?:if|elif) key == "', bodies[n])[1:]:
        key = sec.split('"', 1)[0]
        m = TOK.search(sec)
        if not m:
            raise SystemExit('no value parser for %s %s' % (n, key))
        ptypes[(ctx_of[n], key)] = LEAD_OF[m.group(1)]
m = re.search(r'\ndef _type_rows\(.*?\n(.*?)\n\n\ndef ', src, re.S)
if not m:
    raise SystemExit('missing mirror _type_rows')
mine_types = {}
for row in re.findall(r'out\.append\(String\("([^"]+)"\)\)',
                      m.group(1)):
    parts = row.split(',')
    if len(parts) != 4:
        raise SystemExit('bad type row %r' % row)
    ctx, kind, key, lead = parts
    mine_types[(ctx, kind, key)] = lead
want_types = {}
for (c0, key), lead in ptypes.items():
    if c0 in ('top', 'source', 'observer', 'scope'):
        want_types[(c0, '', key)] = lead
    else:
        want_types[('data', c0, key)] = lead
if want_types != mine_types:
    only_parser = sorted(set(want_types) - set(mine_types))
    only_mine = sorted(set(mine_types) - set(want_types))
    clash = sorted(k for k in set(want_types) & set(mine_types)
                   if want_types[k] != mine_types[k])
    raise SystemExit(
        'type drift parser-only=%s mine-only=%s clash=%s'
        % (only_parser, only_mine,
           [(k, want_types[k], mine_types[k]) for k in clash]))
print('mirror sets match parser and schema')
PYEOF
        report_ok "f4-key-mirror (sets match parser and schema)"
    else
        report_bad "f4-key-mirror: accepted-key sets drifted"
    fi
    expect_error "overflow-rejected" 2 \

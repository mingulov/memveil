#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# memveil test runner.
#
# Usage: tools/test <suite> | tools/test --help
#
# Implemented suites: schemas, reports, profiles, doctor, record,
# qualify, confidential-hooks, confidential-ranges,
# confidential-inventory, confidential-real,
# confidential-late-attach, top, oracle-ledger, vm-oracle,
# profile-semantics, vm-lifecycle, vm-copy, vm-real-io,
# vm-topwalk, vm-kernels, vm-scenarios, vm-stop,
# vm-saturation, vm-cleanup, vm-attempts, quality,
# reader-adversarial, fuzz-smoke, fuzz-campaign,
# record-failures, output-paths, privacy, render-escaping,
# offline-environment, perf-replay, perf-region,
# perf-workload, perf-overhead, soak, preview-package,
# provenance, docs, examples, candidate, candidate-matrix,
# candidate-custody, candidate-inputs, vm-live-soak.
#
# A skipped suite is reported as skipped, never as success.
# Exit 0 only when the suite passes; 1 on test failure; 2 on
# invalid usage; 77 when a suite with unmet inputs skips.
# One suite per invocation; extra arguments are rejected.
# The binary under test is the Rust release build
# (target/release/memveil, built via cargo build
# --release). Python suites keep their
# build/memveil path, which the runner links at the Rust
# binary before dispatch. The link stays after the run.
# The release binary must exist before dispatch: a missing
# binary exits 1 without running any suite (an unknown
# suite name then also reports exit 1, not 2). Candidate
# mode routes before this check and never touches the
# build tree, so qualification works with an empty dev
# build tree.
# MEMVEIL_BIN overrides the binary under test: an absolute
# slash path must name an executable file, used verbatim
# (no rebuild, no relink of build/memveil); a relative
# slash path first requires every leading directory of the
# spelled path to exist, so a later dot-dot cannot hide a
# file or a missing directory, and only then resolves
# against the caller's directory to an absolute canonical
# path before dispatch, so a later directory change cannot
# lose it; a bare name is looked up
# on PATH and resolves to an absolute path. A
# set-but-unusable value (missing, not executable, or
# unresolvable on PATH) fails closed with exit 1. The CLI
# Python drivers resolve the same knob through
# tests/cli/memveil_bin.py (docs/sanitizer-lane.md).
# LMB_SANITIZE=1 exports fail-fast UBSan options for
# sanitizer-instrumented runs (plain binaries ignore this).
#
# Unit coverage lives in the Rust test suites (cargo test);
# the harness suites below drive the built binary end to
# end against fixtures and independent oracles.
# The reports suite drives the built report binary end to end: golden
# stdout bytes, exact exit codes (0 rendered, 4 only under --strict
# without a complete verdict, 2 invalid input), and independently
# recomputed counts from tools/validate-schemas over generated
# JSON reports.
# The profiles suite checks layout extraction against the
# reference fixtures plus the shipped-profile tripwire. The
# doctor suite runs the built doctor verb live: oracle-checked
# JSON, identity cross-checks against uname/id, exit/verdict
# consistency, and usage errors.
# The qualify suite runs the built qualify verb: usage,
# host-independent arg/capability refusals, and floor-gated
# (x86_64 kernel >= 7) profile refusals.
# With MV_BUNDLE_TARBALL or MV_CANDIDATE_MANIFEST set, the
# suite routes through tests/support/candidate_suite.py
# before any build-tree access: perf-replay, perf-region,
# soak, privacy, fuzz-smoke, fuzz-campaign, perf-overhead,
# perf-workload, vm-live-soak, release-runtime, package,
# deb, rpm-journey, vm-kernels, vm-scenarios and
# extracted-robustness run against the verified candidate;
# perf-workload is deferred and skips with its recorded
# reason instead of running.
# Partial inputs fail closed with exit 2, as do other
# suites given candidate inputs. Unarmed vm-live-soak
# without candidate inputs skips with exit 77; armed
# without inputs fails closed. The candidate-inputs
# suite aggregates the loader, dispatch and
# live-campaign tests.

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

if [ "$#" = 1 ] && [ "$1" != --help ] && [ "$1" != -h ] && \
   { [ "${MV_BUNDLE_TARBALL+x}" = x ] || [ "${MV_CANDIDATE_MANIFEST+x}" = x ]; }; then
    exec python3 "$ROOT/tests/support/candidate_suite.py" "$1"
fi
if [ "$#" = 1 ] && [ "$1" = vm-live-soak ]; then
    if [ "${MEMVEIL_VM_LIVE_SOAK:-0}" = 1 ]; then
        echo "vm-live-soak: FAIL: armed but candidate inputs missing" >&2
        exit 1
    fi
    echo "vm-live-soak: SKIP: needs candidate inputs" >&2
    exit 77
fi
if [ "$#" = 1 ] && [ "$1" = candidate-inputs ]; then
    exec python3 -m pytest "$ROOT/tests/support/test_candidate_input.py" "$ROOT/tests/support/test_candidate_suites.py" "$ROOT/tests/vm/test_live_soak.py" "$ROOT/tests/vm/test_pool_read_oracle.py" -q
fi

if [ "${LMB_SANITIZE:-0}" = 1 ]; then
    # UBSan prints and recovers by default, which would let a
    # report exit 0 and pass the suite; halt instead so the
    # lane tolerates zero reports (docs/build.md). ASan aborts
    # by default already. Plain binaries ignore this.
    export UBSAN_OPTIONS="halt_on_error=1${UBSAN_OPTIONS:+:$UBSAN_OPTIONS}"
fi

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
}


asan_preload() {
    # Under LMB_SANITIZE=1, print the ASan runtime path plus ':'
    # so LD_PRELOAD puts the runtime first: a preloaded
    # interposer otherwise aborts ASan init ("runtime does not
    # come first"). Interposition still chains through
    # RTLD_NEXT. Empty in plain mode.
    if [ "${LMB_SANITIZE:-0}" = 1 ]; then
        rt=$(ldd "$(memveil_bin)" 2>/dev/null | \
            sed -n 's/.*libasan[^ ]* => \([^ ]*\).*/\1/p' | head -1)
        if [ -n "$rt" ]; then
            printf '%s:' "$rt"
        fi
    fi
}

memveil_knob_resolved() {
    # Resolve a MEMVEIL_BIN value to the binary to run: an
    # absolute slash path prints verbatim (the caller
    # checks it names an executable file); a relative
    # slash path first requires every leading directory of
    # the spelled path to exist, so a later dot-dot cannot
    # hide a file or a missing directory, and only then
    # prints as an absolute canonical path resolved
    # against the caller's directory, so the blessed path
    # survives a directory change before dispatch; a bare
    # name is looked up on PATH, left to right, and prints
    # as an absolute canonical path.
    # The lookup is explicit so validation and dispatch
    # cannot disagree about which file a bare name means:
    # an executed bare name would otherwise search PATH
    # while a plain file test checks the current
    # directory. An empty PATH entry means the current
    # directory; an unset or empty PATH refuses every bare
    # name. Prints nothing and returns 1 when a bare name
    # resolves to nothing usable or a relative slash path
    # resolves to nothing at all.
    knob=$1
    case $knob in
        /*)
            printf '%s\n' "$knob"
            return 0
            ;;
        */*)
            # Every leading directory of the spelled path
            # must exist, checked on the original spelling
            # before canonicalizing, so a later dot-dot
            # cannot hide a file or a missing directory.
            head=${knob%/*}
            rest=$head
            prefix=
            while [ -n "$rest" ]; do
                case $rest in
                    */*)
                        comp=${rest%%/*}
                        rest=${rest#*/}
                        ;;
                    *)
                        comp=$rest
                        rest=
                        ;;
                esac
                if [ -z "$prefix" ]; then
                    prefix=$comp
                    if [ -z "$prefix" ]; then
                        prefix=/
                    fi
                else
                    prefix=$prefix/$comp
                fi
                if [ ! -d "$prefix" ]; then
                    return 1
                fi
            done
            resolved=$(command -p readlink -f -- "$knob" \
                2>/dev/null) || return 1
            if [ -z "$resolved" ]; then
                return 1
            fi
            printf '%s\n' "$resolved"
            return 0
            ;;
    esac
    search=${PATH-}
    if [ -z "$search" ]; then
        return 1
    fi
    search=$search:
    while [ -n "$search" ]; do
        dir=${search%%:*}
        search=${search#*:}
        if [ -z "$dir" ]; then
            dir=.
        fi
        cand=$dir/$knob
        if [ -f "$cand" ] && [ -x "$cand" ]; then
            # command -p: canonicalize with the default utility
            # path, since PATH itself is the search input here
            # and may not cover coreutils.
            resolved=$(command -p readlink -f "$cand" \
                2>/dev/null) || return 1
            if [ -n "$resolved" ] && [ -x "$resolved" ]; then
                printf '%s\n' "$resolved"
                return 0
            fi
            return 1
        fi
    done
    return 1
}

memveil_bin() {
    # Binary under test: the Rust release build, or the
    # $MEMVEIL_BIN resolution (sanitizer-lane override;
    # rust_bin_setup refuses an unusable value before any
    # suite runs, so dispatch always sees a resolved path).
    if [ "${MEMVEIL_BIN+x}" = x ]; then
        memveil_knob_resolved "$MEMVEIL_BIN"
        return
    fi
    printf '%s\n' "$ROOT/target/release/memveil"
}

memveil_build_hint() {
    # Rebuild hint matching memveil_bin.
    printf 'cargo build --release'
}

rust_bin_setup() {
    # MEMVEIL_BIN override: use the named binary (no
    # rebuild, no relink of build/memveil), failing
    # closed unless it names an executable file — a
    # relative slash path first requires every leading
    # directory of the spelled path, then resolves
    # against the caller's directory, a bare name must
    # resolve on PATH.
    # The slash check runs against the resolved path, so
    # setup blesses exactly what dispatch executes.
    if [ "${MEMVEIL_BIN+x}" = x ]; then
        case $MEMVEIL_BIN in
            */*)
                resolved=$(memveil_knob_resolved "$MEMVEIL_BIN" \
                    2>/dev/null) || resolved=
                if [ -z "$resolved" ] || \
                   [ ! -f "$resolved" ] || \
                   [ ! -x "$resolved" ]; then
                    echo "test: MEMVEIL_BIN=$MEMVEIL_BIN missing or not executable" >&2
                    return 1
                fi
                ;;
            *)
                if ! memveil_knob_resolved "$MEMVEIL_BIN" \
                        >/dev/null 2>&1; then
                    echo "test: MEMVEIL_BIN=$MEMVEIL_BIN missing or not executable" >&2
                    return 1
                fi
                ;;
        esac
        return 0
    fi
    # The release binary must exist, and the build/memveil
    # default (used by the CLI drivers when MEMVEIL_BIN is
    # unset) must reach it: link build/memveil at the Rust
    # binary, replacing any stale file from before the cutover.
    rust="$ROOT/target/release/memveil"
    if [ ! -x "$rust" ]; then
        echo "test: missing $rust" \
            "(run cargo build --release first)" >&2
        return 1
    fi
    link="$ROOT/build/memveil"
    mkdir -p "$ROOT/build"
    ln -sfn "$rust" "$link"
}





report_pass=0
report_fail=0

report_ok() {
    echo "ok $1"
    report_pass=$((report_pass + 1))
}

report_bad() {
    echo "FAIL $1" >&2
    report_fail=$((report_fail + 1))
}

# expect_stdout <label> <golden> <expected-exit> <args...>
expect_stdout() {
    label=$1
    golden=$2
    want_exit=$3
    shift 3
    if [ ! -f "$ROOT/$golden" ]; then
        report_bad "$label: missing golden $golden"
        return 0
    fi
    "$BIN" "$@" >"$TMP/out" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    if ! cmp -s "$TMP/out" "$ROOT/$golden"; then
        report_bad "$label: stdout differs from $golden"
        return 0
    fi
    report_ok "$label (exit $rc, golden match)"
}

# expect_json <label> <fixture> <expected-exit> <counts-line> [extra args...]
expect_json() {
    label=$1
    fixture=$2
    want_exit=$3
    want_counts=$4
    shift 4
    rm -rf "$TMP/cap"
    mkdir -p "$TMP/cap"
    cp "$ROOT/$fixture/session.json" "$TMP/cap/session.json"
    cp "$ROOT/$fixture/events.ndjson" "$TMP/cap/events.ndjson"
    "$BIN" report "$@" --format json "$ROOT/$fixture" \
        >"$TMP/cap/report.json" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    counts=$("$ROOT/tools/validate-schemas" "$TMP/cap" 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        report_bad "$label: oracle rejected generated report: $counts"
        return 0
    fi
    if [ "$counts" != "$want_counts" ]; then
        report_bad "$label: counts '$counts', want '$want_counts'"
        return 0
    fi
    report_ok "$label (exit $want_exit, $counts)"
}

# expect_error <label> <expected-exit> <args...>
expect_error() {
    label=$1
    want_exit=$2
    shift 2
    "$BIN" "$@" >"$TMP/out" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    if [ -s "$TMP/out" ]; then
        report_bad "$label: stdout must be empty on exit $rc"
        return 0
    fi
    if [ ! -s "$TMP/err" ]; then
        report_bad "$label: stderr must explain exit $rc"
        return 0
    fi
    report_ok "$label (exit $rc, quiet stdout)"
}

# expect_text_exit <label> <fixture> <expected-exit> [extra args...]
expect_text_exit() {
    label=$1
    fixture=$2
    want_exit=$3
    shift 3
    "$BIN" report "$@" "$ROOT/$fixture" >"$TMP/out" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    if [ ! -s "$TMP/out" ]; then
        report_bad "$label: exit $rc must still print a report"
        return 0
    fi
    report_ok "$label (exit $rc)"
}


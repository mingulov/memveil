import subprocess, resource, sys
binary, args, prefix = sys.argv[1], sys.argv[2:-1], sys.argv[-1]
p = subprocess.run([binary] + args, capture_output=True)
open(prefix + '.out', 'wb').write(p.stdout)
open(prefix + '.err', 'wb').write(p.stderr)
open(prefix + '.rc', 'w').write(str(p.returncode))
ru = resource.getrusage(resource.RUSAGE_CHILDREN)
print(ru.ru_maxrss)
PYEOF
    rc=$(cat "$TMP/sparse.rc")
    rss=$(cat "$TMP/measure")
    if [ "$rc" -ne 2 ]; then
        report_bad "streaming-reject: exit $rc, want 2"
    elif [ -s "$TMP/sparse.out" ]; then
        report_bad "streaming-reject: stdout must be empty on exit 2"
    elif [ ! -s "$TMP/sparse.err" ]; then
        report_bad "streaming-reject: stderr must explain exit 2"
    elif [ "$rss" -gt 200000 ]; then
        report_bad "streaming-reject: RSS ${rss}KiB exceeds 200000KiB"
    else
        report_ok "streaming-reject (exit 2, ${rss}KiB RSS)"
    fi
    python3 - "$BIN" report "$TMP/large-cap" \
        "$TMP/large" >"$TMP/measure" 2>&1 <<'PYEOF'
import subprocess, resource, sys
binary, args, prefix = sys.argv[1], sys.argv[2:-1], sys.argv[-1]
p = subprocess.run([binary] + args, capture_output=True)
open(prefix + '.out', 'wb').write(p.stdout)
open(prefix + '.err', 'wb').write(p.stderr)
open(prefix + '.rc', 'w').write(str(p.returncode))
ru = resource.getrusage(resource.RUSAGE_CHILDREN)
print(ru.ru_maxrss)
PYEOF
    rc=$(cat "$TMP/large.rc")
    rss=$(cat "$TMP/measure")
    if [ "$rc" -ne 0 ]; then
        report_bad "streaming-large: exit $rc, want 0"
    elif ! grep -q -F 'bounce_attempts = 164000 count' "$TMP/large.out"; then
        report_bad "streaming-large: report lacks 164000 attempts"
    elif ! grep -q -F 'requested_bounce_bytes = 671744000 bytes' \
        "$TMP/large.out"; then
        report_bad "streaming-large: report lacks 671744000 bytes"
    elif [ "$rss" -gt 100000 ]; then
        report_bad "streaming-large: RSS ${rss}KiB exceeds 100000KiB"
    else
        report_ok "streaming-large (exit 0, 164000 attempts, ${rss}KiB RSS)"
    fi
    python3 - "$BIN" report "$TMP/bigsession-cap" \
        "$TMP/bigsession" >"$TMP/measure" 2>&1 <<'PYEOF'
import subprocess, resource, sys
binary, args, prefix = sys.argv[1], sys.argv[2:-1], sys.argv[-1]
p = subprocess.run([binary] + args, capture_output=True)
open(prefix + '.out', 'wb').write(p.stdout)
open(prefix + '.err', 'wb').write(p.stderr)
open(prefix + '.rc', 'w').write(str(p.returncode))
ru = resource.getrusage(resource.RUSAGE_CHILDREN)
print(ru.ru_maxrss)
PYEOF
    rc=$(cat "$TMP/bigsession.rc")
    rss=$(cat "$TMP/measure")
    if [ "$rc" -ne 2 ]; then
        report_bad "session-reject: exit $rc, want 2"
    elif [ -s "$TMP/bigsession.out" ]; then
        report_bad "session-reject: stdout must be empty on exit 2"
    elif ! grep -q -F 'session.json too large' "$TMP/bigsession.err"; then
        report_bad "session-reject: stderr lacks size diagnostic"
    elif [ "$rss" -gt 100000 ]; then
        report_bad "session-reject: RSS ${rss}KiB exceeds 100000KiB"
    else
        report_ok "session-reject (exit 2, ${rss}KiB RSS)"
    fi

    # F7: 2043 observed devices need 4097 metric rows, past the 4096
    # report budget, so the capture is unrepresentable (exit 2). The
    # 300-flood capture stays representable: its 300 unknown-counter
    # notes merge into at most 256 limitations (oracle-checked).
    python3 - "$TMP" "$ROOT/tests/fixtures/attempts" <<'PYEOF'
import json, os, sys
tmp, src = sys.argv[1], sys.argv[2]
base = json.load(open(src + '/session.json'))
tpl = json.loads(open(src + '/events.ndjson', 'rb').read().split(b'\n')[0])
os.makedirs(tmp + '/manydev-cap', exist_ok=True)
sess = json.loads(json.dumps(base))
sess['device_catalog']['devices'] = [
    {'device_id': 'dev-%d' % i, 'name': 'testdev%d' % i,
     'driver': 'synthetic-test', 'identity_status': 'resolved'}
    for i in range(2043)
]
open(tmp + '/manydev-cap/session.json', 'w').write(json.dumps(sess))
with open(tmp + '/manydev-cap/events.ndjson', 'wb') as f:
    for i in range(2043):
        d = json.loads(json.dumps(tpl))
        d['seq'] = str(i + 1)
        d['ts_ns'] = str(1000000000 + i * 1000)
        d['data']['device_id'] = 'dev-%d' % i
        d['data']['operation_id'] = 'op-%d' % i
        f.write(json.dumps(d, separators=(', ', ': ')).encode() + b'\n')
os.makedirs(tmp + '/flood-cap', exist_ok=True)
open(tmp + '/flood-cap/session.json', 'w').write(json.dumps(base))
with open(tmp + '/flood-cap/events.ndjson', 'wb') as f:
    for i in range(300):
        d = {'schema_version': '0.1.0',
             'session_id': base['session_id'],
             'seq': str(i + 1),
             'ts_ns': str(1000000000 + i * 1000),
             'kind': 'counter_snapshot',
             'source': json.loads(json.dumps(tpl['source'])),
             'data': {'counter_id': 'vendor.flood-%d' % i,
                      'epoch': '3',
                      'scope': {'device_id': None,
                                'profile_id': 'synthetic-attempts-1'},
                      'value': '10', 'unit': 'count'}}
        f.write(json.dumps(d, separators=(', ', ': ')).encode() + b'\n')
PYEOF
    expect_error "f7-many-devices" 2 report "$TMP/manydev-cap"
    "$BIN" report --format json "$TMP/flood-cap" \
        >"$TMP/flood.json" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne 0 ]; then
        report_bad "f7-counter-flood: exit $rc, want 0"
    else
        rm -rf "$TMP/flood-check"
        mkdir -p "$TMP/flood-check"
        cp "$TMP/flood-cap/session.json" "$TMP/flood-check/session.json"
        cp "$TMP/flood-cap/events.ndjson" "$TMP/flood-check/events.ndjson"
        cp "$TMP/flood.json" "$TMP/flood-check/report.json"
        counts=$("$ROOT/tools/validate-schemas" "$TMP/flood-check" 2>&1)
        rc=$?
        if [ "$rc" -ne 0 ]; then
            report_bad "f7-counter-flood: oracle rejected: $counts"
        elif [ "$counts" != "capture OK: 300 events, 0 attempts, 0 requested bytes" ]; then
            report_bad "f7-counter-flood: counts '$counts'"
        elif ! grep -q -F 'further limitations withheld.' "$TMP/flood.json"; then
            report_bad "f7-counter-flood: report lacks withheld note"
        else
            report_ok "f7-counter-flood (exit 0, $counts)"
        fi
    fi

    expect_error "badkind" 2 report "$ROOT/tests/fixtures/reader/badkind"
    expect_error "partial-tail-strict" 2 \
        report "$ROOT/tests/fixtures/reader/partial-tail"
    expect_error "corrupt-tail-allowed" 2 report --allow-partial \
        "$ROOT/tests/fixtures/reader/corrupt-tail"
    expect_error "valid-no-newline-strict" 2 \
        report "$ROOT/tests/fixtures/reader/valid-no-newline"
    expect_error "valid-no-newline-allowed" 2 report --allow-partial \
        "$ROOT/tests/fixtures/reader/valid-no-newline"
    expect_error "tail-foreign-allowed" 2 report --allow-partial \
        "$ROOT/tests/fixtures/reader/tail-foreign"
    expect_error "f2-unknown-device" 2 \
        report "$ROOT/tests/fixtures/reader/f2-unknown-device"
    expect_error "f2-unknown-snapshot-device" 2 \
        report "$ROOT/tests/fixtures/reader/f2-unknown-snapshot-device"
    expect_error "f2-duplicate-op" 2 \
        report "$ROOT/tests/fixtures/reader/f2-duplicate-op"
    expect_error "f2-duplicate-mapping" 2 \
        report "$ROOT/tests/fixtures/reader/f2-duplicate-mapping"
    expect_error "f2-early-unmap" 2 \
        report "$ROOT/tests/fixtures/reader/f2-early-unmap"
    expect_error "f2-unknown-copy" 2 \
        report "$ROOT/tests/fixtures/reader/f2-unknown-copy"
    expect_error "f2-unknown-sync" 2 \
        report "$ROOT/tests/fixtures/reader/f2-unknown-sync"
    expect_error "f2-double-unmap" 2 \
        report "$ROOT/tests/fixtures/reader/f2-double-unmap"
    expect_error "f2-contradictory-provenance" 2 \
        report "$ROOT/tests/fixtures/reader/f2-contradictory-provenance"
    expect_error "f3-sum-overflow" 2 \
        report "$ROOT/tests/fixtures/reader/f3-sum-overflow"
    expect_error "f3-span-sync" 2 \
        report "$ROOT/tests/fixtures/reader/f3-span-sync"
    expect_error "f3-span-transition" 2 \
        report "$ROOT/tests/fixtures/reader/f3-span-transition"
    expect_error "f3-baseline" 2 \
        report "$ROOT/tests/fixtures/reader/f3-baseline"
    expect_error "missing-dir" 2 report "$ROOT/tests/fixtures/reader/no-such"
    expect_error "unknown-format" 2 report --format yaml \
        "$ROOT/tests/fixtures/attempts"
    expect_error "equals-format" 2 report --format=json \
        "$ROOT/tests/fixtures/attempts"
    expect_error "unknown-flag" 2 report --nope \
        "$ROOT/tests/fixtures/attempts"
    expect_error "report-no-dir" 2 report
    expect_error "no-subcommand" 2
    expect_error "unknown-subcommand" 2 frobnicate

    # F5: the --horizon flag is gone; counts always cover the whole
    # capture window, so any horizon argument is a usage error.
    expect_error "horizon-removed" 2 report --horizon 2500000000 \
        "$ROOT/tests/fixtures/attempts"

    "$BIN" --help >"$TMP/out" 2>"$TMP/err"
    if [ "$?" -ne 0 ] || [ ! -s "$TMP/out" ]; then
        report_bad "top-help: must exit 0 with usage on stdout"
    else
        report_ok "top-help (exit 0)"
    fi
    "$BIN" report --help >"$TMP/out" 2>"$TMP/err"
    if [ "$?" -ne 0 ] || [ ! -s "$TMP/out" ]; then
        report_bad "report-help: must exit 0 with usage on stdout"
    else
        report_ok "report-help (exit 0)"
    fi
    "$BIN" --version >"$TMP/out" 2>"$TMP/err"
    if [ "$?" -ne 0 ]; then
        report_bad "version: must exit 0"
    elif [ "$(cat "$TMP/out")" != "memveil-0.1.0" ]; then
        report_bad "version: unexpected output '$(cat "$TMP/out")'"
    else
        report_ok "version (memveil-0.1.0)"
    fi

    if ldd "$BIN" 2>/dev/null | grep -qi bpf; then
        report_bad "isolation: binary references bpf (native bridge leak)"
    else
        report_ok "isolation (no bpf linkage)"
    fi

    echo "PREVIOUS_DIAGNOSTIC" >"$TMP/stderr.log"
    "$BIN" report 2>>"$TMP/stderr.log" >"$TMP/out"
    if [ "$?" -ne 2 ]; then
        report_bad "stderr-append: want exit 2"
    elif ! head -1 "$TMP/stderr.log" | grep -q "PREVIOUS_DIAGNOSTIC"; then
        report_bad "stderr-append: prior diagnostics truncated"
    elif ! tail -1 "$TMP/stderr.log" | grep -q "memveil report:"; then
        report_bad "stderr-append: new diagnostic missing"
    else
        report_ok "stderr-append (prior diagnostics preserved)"
    fi

    echo "reports: $report_pass passed, $report_fail failed"
    if [ "$report_fail" -ne 0 ]; then
        return 1
    fi
    return 0
}

if [ $# -eq 0 ]; then
    usage >&2
    exit 2
fi
if [ $# -gt 1 ]; then
    echo "test: too many arguments" >&2
    usage >&2
    exit 2
fi
case "$1" in
    --help|-h)
        usage
        ;;
    schemas)
        exec "$ROOT/tools/validate-schemas"
        ;;
    unit)
        suite_unit
        ;;
    reports)
        suite_reports
        ;;
    profiles|doctor|attempts|writer|vm-attempts|package)

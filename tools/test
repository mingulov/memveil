    dp = b['then']['properties']['data']['properties']
    skeys[k] = set(dp.keys())
    if k == 'counter_snapshot':
        skeys['scope'] = set(dp['scope']['properties'].keys())
for n, ctx in ctx_of.items():
    if pkeys[n] != mine.get(ctx, set()):
        raise SystemExit(
            'drift parser-vs-mirror at %s: %s vs %s'
            % (ctx, sorted(pkeys[n]), sorted(mine.get(ctx, set()))))
    if pkeys[n] != skeys.get(ctx, set()):
        raise SystemExit(
            'drift parser-vs-schema at %s: %s vs %s'
            % (ctx, sorted(pkeys[n]), sorted(skeys.get(ctx, set()))))
LEAD_OF = {'parse_string': 's', '_parse_id': 's',
           'parse_u64_field': 's', 'parse_bool': 'b',
           'parse_int': 'n', 'parse_maybe_string': 'S',
           '_parse_maybe_id': 'S', 'parse_maybe_u64': 'S',
           'parse_maybe_int': 'N', '_parse_source': 'o',
           '_parse_observer': 'o', '_parse_snapshot_scope': 'o',
           'skip_value': 'o'}
TOK = re.compile(r'(parse_maybe_u64|parse_maybe_int|'
                 r'parse_maybe_string|_parse_maybe_id|_parse_id|'
                 r'parse_u64_field|parse_bool|parse_int|parse_string|'
                 r'_parse_source|_parse_observer|'
                 r'_parse_snapshot_scope|skip_value)\s*\(')
ptypes = {}
for n in names:
    for sec in re.split(r'\n\s*(?:if|elif) key == "', bodies[n])[1:]:
        key = sec.split('"', 1)[0]
        m = TOK.search(sec)
        if not m:
            raise SystemExit('no value parser for %s %s' % (n, key))
        ptypes[(ctx_of[n], key)] = LEAD_OF[m.group(1)]
m = re.search(r'\ndef _type_rows\(.*?\n(.*?)\n\n\ndef ', src, re.S)
if not m:
    raise SystemExit('missing mirror _type_rows')
mine_types = {}
for row in re.findall(r'out\.append\(String\("([^"]+)"\)\)',
                      m.group(1)):
    parts = row.split(',')
    if len(parts) != 4:
        raise SystemExit('bad type row %r' % row)
    ctx, kind, key, lead = parts
    mine_types[(ctx, kind, key)] = lead
want_types = {}
for (c0, key), lead in ptypes.items():
    if c0 in ('top', 'source', 'observer', 'scope'):
        want_types[(c0, '', key)] = lead
    else:
        want_types[('data', c0, key)] = lead
if want_types != mine_types:
    only_parser = sorted(set(want_types) - set(mine_types))
    only_mine = sorted(set(mine_types) - set(want_types))
    clash = sorted(k for k in set(want_types) & set(mine_types)
                   if want_types[k] != mine_types[k])
    raise SystemExit(
        'type drift parser-only=%s mine-only=%s clash=%s'
        % (only_parser, only_mine,
           [(k, want_types[k], mine_types[k]) for k in clash]))
print('mirror sets match parser and schema')
PYEOF
        report_ok "f4-key-mirror (sets match parser and schema)"
    else
        report_bad "f4-key-mirror: accepted-key sets drifted"
    fi
    expect_error "overflow-rejected" 2 \
        report "$ROOT/tests/fixtures/reader/overflow"

    # F1: the reader streams events in 64 KiB chunks, so resident size
    # stays flat no matter how large events.ndjson is. Both captures
    # below are generated into $TMP (never committed); RSS is the
    # child's getrusage maxrss in KiB. The 270MB capture must exit 2
    # for exceeding the 256MiB bound while staying far below the
    # 945MB RSS the whole-file reader needed for the same input.
    python3 - "$TMP" "$ROOT/tests/fixtures/reader/corrupt-tail" <<'PYEOF'
import json, os, sys
tmp, src = sys.argv[1], sys.argv[2]
tpl = json.loads(
    open(src + '/events.ndjson', 'rb').read().split(b'\n')[0]
)
sess = open(src + '/session.json', 'rb').read()
def line(i):
    d = dict(tpl)
    d['seq'] = str(i)
    d['ts_ns'] = str(1000000000 + i * 1000)
    dd = dict(tpl['data'])
    dd['operation_id'] = 'op-%d' % i
    d['data'] = dd
    return json.dumps(d, separators=(', ', ': ')).encode() + b'\n'
os.makedirs(tmp + '/sparse-cap', exist_ok=True)
open(tmp + '/sparse-cap/session.json', 'wb').write(sess)
with open(tmp + '/sparse-cap/events.ndjson', 'wb') as f:
    i = 1
    while f.tell() <= 270000000:
        f.write(line(i))
        i += 1
os.makedirs(tmp + '/bigsession-cap', exist_ok=True)
trimmed = sess.rstrip()
pad = trimmed[:-1] + b', "pad": "' + b'x' * 17000000 + b'"}\n'
open(tmp + '/bigsession-cap/session.json', 'wb').write(pad)
open(tmp + '/bigsession-cap/events.ndjson', 'wb').write(
    open(src + '/events.ndjson', 'rb').read())
os.makedirs(tmp + '/large-cap', exist_ok=True)
open(tmp + '/large-cap/session.json', 'wb').write(sess)
with open(tmp + '/large-cap/events.ndjson', 'wb') as f:
    for i in range(1, 164001):
        f.write(line(i))
PYEOF
    python3 - "$BIN" report "$TMP/sparse-cap" \
        "$TMP/sparse" >"$TMP/measure" 2>&1 <<'PYEOF'
import subprocess, resource, sys
binary, args, prefix = sys.argv[1], sys.argv[2:-1], sys.argv[-1]
p = subprocess.run([binary] + args, capture_output=True)
open(prefix + '.out', 'wb').write(p.stdout)
open(prefix + '.err', 'wb').write(p.stderr)
open(prefix + '.rc', 'w').write(str(p.returncode))
ru = resource.getrusage(resource.RUSAGE_CHILDREN)
print(ru.ru_maxrss)
PYEOF
    rc=$(cat "$TMP/sparse.rc")
    rss=$(cat "$TMP/measure")
    if [ "$rc" -ne 2 ]; then
        report_bad "streaming-reject: exit $rc, want 2"
    elif [ -s "$TMP/sparse.out" ]; then
        report_bad "streaming-reject: stdout must be empty on exit 2"
    elif [ ! -s "$TMP/sparse.err" ]; then
        report_bad "streaming-reject: stderr must explain exit 2"
    elif [ "$rss" -gt 200000 ]; then
        report_bad "streaming-reject: RSS ${rss}KiB exceeds 200000KiB"
    else
        report_ok "streaming-reject (exit 2, ${rss}KiB RSS)"
    fi
    python3 - "$BIN" report "$TMP/large-cap" \
        "$TMP/large" >"$TMP/measure" 2>&1 <<'PYEOF'

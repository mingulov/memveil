            tests/fixtures/reader/adv-nul/events.ndjson|\
            tests/fixtures/reader/adv-unknown-field/events.ndjson|\
            tests/fixtures/reader/badkind/events.ndjson|\
            tests/fixtures/reader/baseline-after-window/session.json|\
            tests/fixtures/reader/compat-major/session.json|\
            tests/fixtures/reader/corrupt-tail/events.ndjson|\
            tests/fixtures/reader/f2-contradictory-provenance/session.json|\
            tests/fixtures/reader/f3-baseline/session.json|\
            tests/fixtures/reader/f3-span-sync/events.ndjson|\
            tests/fixtures/reader/f3-span-transition/events.ndjson|\
            tests/fixtures/reader/f4-definitive-dupkey/events.ndjson|\
            tests/fixtures/reader/f4-definitive-version/events.ndjson|\
            tests/fixtures/reader/f4-nocolon-dupkey/events.ndjson|\
            tests/fixtures/reader/f4-nocolon-unknown/events.ndjson|\
            tests/fixtures/reader/f4-truncated-nested/events.ndjson|\
            tests/fixtures/reader/f4-truncated-primitive/events.ndjson|\
            tests/fixtures/reader/f4-truncated-scope-device/events.ndjson|\
            tests/fixtures/reader/f4-truncated-scope-profile/events.ndjson|\
            tests/fixtures/reader/interior-corrupt/events.ndjson|\
            tests/fixtures/reader/partial-tail/events.ndjson|\
            tests/fixtures/reader/size-ok/events.ndjson|\
            tests/fixtures/reader/size-over/events.ndjson|\
            tests/fixtures/reader/unsanitized-error/events.ndjson|\
            tests/fixtures/reader/unsanitized-session/session.json)
                if [ "$rc" -ne 2 ]; then
                    echo "writer: $rel exits $rc, want 2" >&2
                    failed=1
                fi
                ;;
            *)
                if [ "$rc" -ne 0 ]; then
                    echo "writer: $rel exits $rc, want 0" >&2
                    cat /tmp/rt-out.log >&2
                    failed=1
                fi
                ;;
        esac
    done <<EOF
$(cd "$ROOT" && find tests/fixtures -name events.ndjson -o -name session.json | sort)
EOF
    if [ "$failed" -ne 0 ]; then
        echo "writer: round-trip FAILED ($checked files)" >&2
        return 1
    fi
    echo "writer: encoder and round-trip passed ($checked files)"
    # EventWriter file primitive (creation, gates, groups, finalize):
    # unit tests, then LD_PRELOAD fault injection plus a
    # live path-replacement race. All unprivileged; every
    # pwrite count is asserted so the short:N modes stay
    # anchored to a verified op->call mapping.
    run_unit_file tests/unit/test_writer.mojo || return 1
    SHIM="$ROOT/build/shim/mvshim.so"
    if [ ! -f "$SHIM" ]; then
        echo "writer: missing $SHIM (run tools/build first)" >&2
        return 1
    fi
    mkdir -p "$ROOT/build/probe"
    (cd "$ROOT" && pixi run --frozen mojo build -I src \
        --target-cpu x86-64-v2 \
        -o "$ROOT/build/probe/shim_probe" \
        tests/unit/shim_probe.mojo) || return 1
    PROBE="$ROOT/build/probe/shim_probe"
    WTMP=$(mktemp -d)
    trap 'rm -rf "$WTMP"' EXIT
    wfailed=0
    run_script() { # <case> [<modes>]
        if [ $# -ge 2 ]; then
            MVSHIM="$2" MVSHIM_COUNT="$WTMP/$1.count" \
                LD_PRELOAD="$SHIM" \
                "$PROBE" script "$WTMP/$1" >"$WTMP/$1.log" 2>&1
        else
            "$PROBE" script "$WTMP/$1" >"$WTMP/$1.log" 2>&1
        fi
        rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "writer: case $1 exits $rc" >&2
            cat "$WTMP/$1.log" >&2
            wfailed=1
        fi
    }
    want() { # <case> <fixed-string>
        grep -qF "$2" "$WTMP/$1.log" || {
            echo "writer: case $1 missing [$2]" >&2
            cat "$WTMP/$1.log" >&2
            wfailed=1
        }
    }
    want_count() { # <case> <n>
        got=$(cat "$WTMP/$1.count" 2>/dev/null || echo "?")
        if [ "$got" != "$2" ]; then
            echo "writer: case $1 pwrite count $got, want $2" >&2
            wfailed=1
        fi
    }
    want_file() { # <case> <rel> <expected>
        cmp -s "$WTMP/$1/$2" "$3" || {
            echo "writer: case $1 file $2 differs" >&2
            ls -la "$WTMP/$1" >&2
            wfailed=1
        }
    }
    want_missing() { # <case> <rel>
        if [ -e "$WTMP/$1/$2" ]; then
            echo "writer: case $1 has unexpected $2" >&2
            wfailed=1
        fi
    }
    bytes_of() { # <char> <count> <file>
        printf "$1%.0s" $(seq "$2") >"$3"
    }
    bytes_of A 99 "$WTMP/cA"
    bytes_of B 99 "$WTMP/cB"
    bytes_of C 99 "$WTMP/cC"
    bytes_of D 99 "$WTMP/cD"
    bytes_of E 99 "$WTMP/cE"
    bytes_of '{' 49 "$WTMP/cS49"
    for c in A B C D E; do printf '\n' >>"$WTMP/c$c"; done
    printf '\n' >>"$WTMP/cS49"
    cat "$WTMP/cA" "$WTMP/cB" "$WTMP/cE" >"$WTMP/full300"
    cat "$WTMP/cA" >"$WTMP/pre100"
    cat "$WTMP/cA" "$WTMP/cB" >"$WTMP/pre200"
    cat "$WTMP/cA" "$WTMP/cB" "$WTMP/cC" "$WTMP/cD" >"$WTMP/full400"
    head -c 50 "$WTMP/cC" >"$WTMP/torn250head"
    cat "$WTMP/pre200" "$WTMP/torn250head" >"$WTMP/torn250"
    : >"$WTMP/empty"
    run_script pure
    want pure "append1 ok committed=100"
    want pure "append2 ok committed=200"
    want pure "group ok mark=200 committed=200"
    want pure "append3 ok committed=300"
    want pure "finalize status=finalized"
    want pure "events_len=300"
    want pure "session_len=50"
    want_file pure events.ndjson "$WTMP/full300"
    want_file pure session.json "$WTMP/cS49"
    run_script baseline ""
    want baseline "finalize status=finalized"
    want baseline "events_len=300"
    want_count baseline 6
    want_file baseline events.ndjson "$WTMP/full300"
    run_script short2 "short:2"
    want short2 "append2 ok committed=200"
    want short2 "finalize status=finalized"
    want_count short2 7
    want_file short2 events.ndjson "$WTMP/full300"
    run_script after2 "enospc_after:2"
    want after2 "append1 ok committed=100"
    want after2 "append2 error kind=append_failed"
    want after2 "group error op=gc kind=append_failed"
    want after2 "append3 error kind=append_failed"
    want after2 "finalize status=unfinalized"
    want after2 "events_len=100"
    want after2 "session MISSING"
    want_count after2 5
    want_file after2 events.ndjson "$WTMP/pre100"
    want_missing after2 session.json
    run_script torn "short:3,enospc_after:4"
    want torn "append2 ok committed=200"
    want torn "group error op=gc kind=append_failed"
    want torn "finalize status=unfinalized"
    want torn "events_len=200"
    want_count torn 6
    want_file torn events.ndjson "$WTMP/pre200"
    run_script fatal "short:3,enospc_after:4,fail_truncate"
    want fatal "group error op=gc kind=fatal"
    want fatal "append3 error kind=misuse"
    want fatal "finalize error kind=misuse"
    want fatal "events_len=250"
    want_count fatal 4
    want_file fatal events.ndjson "$WTMP/torn250"
    run_script truncfail "fail_truncate"
    want truncfail "group error op=abort kind=fatal"
    want truncfail "append3 error kind=misuse"
    want truncfail "events_len=400"
    want_count truncfail 4
    want_file truncfail events.ndjson "$WTMP/full400"
    run_script evfull "enospc_events"
    want evfull "append1 error kind=append_failed"
    want evfull "finalize status=finalized"
    want evfull "events_len=0"
    want evfull "session_len=50"
    want_count evfull 5
    want_file evfull events.ndjson "$WTMP/empty"
    want_file evfull session.json "$WTMP/cS49"
    run_script tmpspc "enospc_tmp"
    want tmpspc "append3 ok committed=300"
    want tmpspc "finalize status=unfinalized"
    want tmpspc "events_len=300"
    want tmpspc "session MISSING"
    want_count tmpspc 5
    want_file tmpspc events.ndjson "$WTMP/full300"
    want_missing tmpspc session.json
    run_script norename "fail_rename"
    want norename "finalize status=unfinalized"
    want norename "session MISSING"
    want_count norename 6
    want_file norename events.ndjson "$WTMP/full300"
    want_missing norename session.json
    run_script dirfsync "fsync_dir"
    want dirfsync "finalize status=present_unsynced"
    want dirfsync "session_len=50"
    want dirfsync "events_len=300"
    want_count dirfsync 6
    want_file dirfsync events.ndjson "$WTMP/full300"
    want_file dirfsync session.json "$WTMP/cS49"
    PARENT_REAL=$(realpath "$WTMP")
    run_script parfsync "fsync_parent:$PARENT_REAL"
    want parfsync "finalize status=present_unsynced note=parent fsync: $PARENT_REAL: errno 5"
    want parfsync "session_len=50"
    want parfsync "events_len=300"
    want_count parfsync 6
    want_file parfsync events.ndjson "$WTMP/full300"
    want_file parfsync session.json "$WTMP/cS49"
    run_createonly() { # <case> <modes>
        MVSHIM="$2" MVSHIM_COUNT="$WTMP/$1.count" \
            LD_PRELOAD="$SHIM" \
            "$PROBE" createonly "$WTMP/$1" >"$WTMP/$1.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "writer: case $1 exits $rc" >&2
            cat "$WTMP/$1.log" >&2
            wfailed=1
        fi
    }
    # Construction pin failures unwind: a failed fstat on
    # either the events file or the fresh dir raises io and
    # leaves no directory behind.
    run_createonly fstatev "fstat_fail_events"
    want fstatev "createonly error kind=io"
    if [ -e "$WTMP/fstatev" ]; then
        echo "writer: fstatev left residual dir" >&2
        ls -la "$WTMP/fstatev" >&2
        wfailed=1
    fi
    FSTATDIR_REAL=$(realpath -m "$WTMP/fstatdir")
    run_createonly fstatdir "fstat_fail_dir:$FSTATDIR_REAL"
    want fstatdir "createonly error kind=io"
    if [ -e "$WTMP/fstatdir" ]; then
        echo "writer: fstatdir left residual dir" >&2
        ls -la "$WTMP/fstatdir" >&2
        wfailed=1
    fi
    run_livecreate() { # <case> <modes>
        MVSHIM="$2" MVSHIM_COUNT="$WTMP/$1.count" \
            LD_PRELOAD="$SHIM" \
            "$PROBE" live-create "$WTMP/$1" >"$WTMP/$1.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "writer: case $1 exits $rc" >&2
            cat "$WTMP/$1.log" >&2
            wfailed=1
        fi
    }
    # Stuck construction unwind: fstat fails plus the events
    # unlink fails, so artifacts remain and the LiveWriter
    # abandon reports them (not a clean rollback).
    run_livecreate stuckunwind "fstat_fail_events,fail_unlink_events"
    want stuckunwind "live-create error kind=io"
    want stuckunwind "live-create abandon=construction residuals: events,dir"
    # Single-report boundary: the creation error keeps the
    # cause without the residual suffix, and the second
    # abandon drains nothing.
    if grep -qF "; residuals:" "$WTMP/stuckunwind.log"; then
        echo "writer: stuckunwind repeats residuals in error" >&2
        cat "$WTMP/stuckunwind.log" >&2
        wfailed=1
    fi
    if ! grep -qxF "live-create abandon2=" "$WTMP/stuckunwind.log"; then
        echo "writer: stuckunwind second abandon not empty" >&2
        cat "$WTMP/stuckunwind.log" >&2
        wfailed=1
    fi
    if [ ! -d "$WTMP/stuckunwind" ]; then
        echo "writer: stuckunwind unexpectedly clean" >&2
        wfailed=1
    fi
    run_mutate() { # <mode> <case>
        "$PROBE" "$1" "$WTMP/$2" >"$WTMP/$2.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "writer: case $2 exits $rc" >&2
            cat "$WTMP/$2.log" >&2
            wfailed=1
        fi
    }
    bytes_of J 10 "$WTMP/junk11"
    printf '\n' >>"$WTMP/junk11"
    run_mutate rename_events rnev
    want rnev "mutate ok"
    want rnev "finalize status=unfinalized note=namespace: events file replaced"
    want_missing rnev session.json
    want_file rnev events.ndjson "$WTMP/junk11"
    run_mutate rename_dir rndir
    want rndir "mutate ok"
    want rndir "finalize status=unfinalized note=namespace: output dir lookup failed"
    want_missing rndir.bak session.json
    if [ ! -f "$WTMP/rndir.bak/events.ndjson" ]; then
        echo "writer: rndir.bak lost its events file" >&2
        wfailed=1
    fi
    # Live path-replacement race: an attacker loop swaps the
    # output path between symlink (to an outside canary),
    # file, dir, and missing while createonly runs. Every
    # outcome must stay in the safe set; the canary must
    # never be created. The mkdir->openat hit window is
    # probabilistic, but safety is asserted on all 200 runs.
    # Calm iterations kill the attacker outright so their
    # success is deterministic (no STOP/CONT flake).
    bytes_of x 1 "$WTMP/x1raw"
    printf '\n' >>"$WTMP/x1raw"
    bytes_of '{' 9 "$WTMP/s10raw"
    printf '\n' >>"$WTMP/s10raw"
    if ! (
        RACE="$WTMP/race"
        mkdir -p "$RACE"
        CANARY="$WTMP/canary-target"
        rm -rf "$CANARY"
        start_attacker() {
            (
                while true; do
                    ln -sfn "$CANARY" "$RACE/target" 2>/dev/null
                    rm -f "$RACE/target" 2>/dev/null
                    touch "$RACE/target" 2>/dev/null
                    rm -f "$RACE/target" 2>/dev/null
                    mkdir "$RACE/target" 2>/dev/null
                    rmdir "$RACE/target" 2>/dev/null
                done
            ) &
            ATTACKER=$!
        }
        start_attacker
        trap 'kill -9 $ATTACKER 2>/dev/null' EXIT
        ok_count=0
        io_count=0
        for i in $(seq 1 200); do
            if [ $((i % 10)) -eq 0 ]; then
                kill -9 "$ATTACKER" 2>/dev/null
                wait "$ATTACKER" 2>/dev/null
                rm -rf "$RACE/target" 2>/dev/null
                out=$("$PROBE" createonly "$RACE/target" 2>&1)
                rc=$?
                if [ "$out" != \
                    "createonly ok status=finalized committed=2" ]; then
                    rm -rf "$RACE/target" 2>/dev/null
                    out=$("$PROBE" createonly "$RACE/target" 2>&1)
                    rc=$?
                fi
                if [ "$out" != \
                    "createonly ok status=finalized committed=2" ]; then
                    rm -rf "$RACE/target" 2>/dev/null
                    out=$("$PROBE" createonly "$RACE/target" 2>&1)
                    rc=$?
                fi
                start_attacker
            else
                rm -rf "$RACE/target" 2>/dev/null
                out=$("$PROBE" createonly "$RACE/target" 2>&1)
                rc=$?
            fi
            if [ "$rc" -ne 0 ]; then
                echo "race iter $i exits $rc: $out" >&2
                exit 1
            fi
            case "$out" in
                "createonly ok status=finalized committed=2")
                    ok_count=$((ok_count + 1))
                    cmp -s "$RACE/target/events.ndjson" \
                        "$WTMP/x1raw" || {
                        echo "race iter $i bad events" >&2
                        exit 1
                    }
                    cmp -s "$RACE/target/session.json" \
                        "$WTMP/s10raw" || {
                        echo "race iter $i bad session" >&2
                        exit 1
                    }
                    ;;
                "createonly error kind=exists") ;;
                "createonly error kind=io")
                    io_count=$((io_count + 1))
                    ;;
                *)
                    echo "race iter $i unsafe output: $out" >&2
                    exit 1
                    ;;
            esac
        done
        kill -9 "$ATTACKER" 2>/dev/null
        trap - EXIT
        if [ -e "$CANARY" ]; then
            echo "race: CANARY ESCAPE at $CANARY" >&2
            exit 1
        fi
        if [ "$ok_count" -lt 20 ]; then
            echo "race: only $ok_count successes" >&2
            exit 1
        fi
        echo "race: $ok_count/200 ok, ${io_count} io, canary absent"
    ); then wfailed=1; fi
    if [ "$wfailed" -ne 0 ]; then
        echo "writer: EventWriter FAILED" >&2
        return 1
    fi
    echo "writer: EventWriter primitive passed (unit + 17 shim cases + race)"
    return 0
}

suite_doctor() {
    run_unit_file tests/unit/test_doctor.mojo || return 1
    BIN="$ROOT/build/memveil"
    if [ ! -x "$BIN" ]; then
        echo "doctor: missing $BIN (run tools/build first)" >&2
        return 1
    fi
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    failed=0

    (cd "$ROOT" && "$BIN" doctor --json >"$TMP/live.json" 2>"$TMP/err")
    rc=$?
    # No validated profile is admitted yet, so the live verdict is
    # unavailable (exit 3) on every host; only the reason varies.
    if [ "$rc" -ne 3 ]; then
        echo "doctor: live doctor --json exit $rc, want 3" >&2
        failed=1
    fi
    if ! "$ROOT/tools/validate-schemas" --check-doctor \
        "$TMP/live.json" >/dev/null 2>&1; then
        echo "doctor: oracle rejected live JSON" >&2
        failed=1
    fi
    if ! python3 - "$TMP/live.json" <<'PYEOF'; then
import json, os, sys
doc = json.load(open(sys.argv[1]))
un = os.uname()
assert doc["mode"] == "passive", "mode"
assert doc["kernel"]["release"] == un.release, "release"
assert doc["kernel"]["arch"] == un.machine, "arch"
assert doc["privilege"]["euid"] == os.geteuid(), "euid"
assert doc["verdict"] == "unavailable", "verdict"
PYEOF
        echo "doctor: live facts mismatch uname/id" >&2
        failed=1
    fi

    (cd "$ROOT" && "$BIN" doctor >"$TMP/live.txt" 2>"$TMP/err")
    rc=$?
    if [ "$rc" -ne 3 ]; then
        echo "doctor: live doctor exit $rc, want 3" >&2
        failed=1
    elif ! head -1 "$TMP/live.txt" | grep -q "memveil doctor (passive, live evidence)"; then
        echo "doctor: live text lacks header" >&2
        failed=1
    fi

    (cd "$ROOT" && "$BIN" doctor --help >"$TMP/out" 2>"$TMP/err")
    if [ "$?" -ne 0 ] || [ ! -s "$TMP/out" ]; then
        echo "doctor: --help must exit 0 with usage" >&2
        failed=1
    fi
    (cd "$ROOT" && "$BIN" doctor --bogus >"$TMP/out" 2>"$TMP/err")
    if [ "$?" -ne 2 ]; then
        echo "doctor: --bogus must exit 2" >&2
        failed=1
    elif [ -s "$TMP/out" ]; then
        echo "doctor: --bogus must keep stdout empty" >&2
        failed=1
    elif [ ! -s "$TMP/err" ]; then
        echo "doctor: --bogus must explain on stderr" >&2
        failed=1
    fi

    if [ "$failed" -ne 0 ]; then
        echo "doctor: FAILED" >&2
        return 1
    fi
    echo "doctor: unit suite plus live checks passed"
    return 0
}

suite_signals() {
    run_unit_file tests/unit/test_signal.mojo || return 1
    mkdir -p "$ROOT/build/probe"
    # shellcheck disable=SC2046
    (cd "$ROOT" && pixi run --frozen mojo build -I src \
        $(mojo_inc_flags) -I tests/unit \
        --target-cpu x86-64-v2 \
        -o "$ROOT/build/probe/signal_probe" \
        tests/unit/signal_probe.mojo) || return 1
    PROBE="$ROOT/build/probe/signal_probe"
    STMP=$(mktemp -d)
    trap 'rm -rf "$STMP"' EXIT
    failed=0
    expect_line() { # <file> <line>
        if ! grep -qxF "$2" "$1"; then
            echo "signals: missing '$2' in $1" >&2
            cat "$1" >&2
            failed=1
        fi
    }
    "$PROBE" none >"$STMP/none.log" 2>&1 || {
        echo "signals: none exits nonzero" >&2
        failed=1
    }
    expect_line "$STMP/none.log" "sigblk_initial=0000000000000000"
    expect_line "$STMP/none.log" "setup=ok"
    expect_line "$STMP/none.log" "check1=none"
    expect_line "$STMP/none.log" "check2=none"
    expect_line "$STMP/none.log" "sigblk_armed=0000000000004002"
    expect_line "$STMP/none.log" "sigblk_restored=0000000000000000"
    expect_line "$STMP/none.log" "post_teardown=error"
    "$PROBE" repeat >"$STMP/repeat.log" 2>&1 || {
        echo "signals: repeat exits nonzero" >&2
        failed=1
    }
    expect_line "$STMP/repeat.log" "setup=ok"
    expect_line "$STMP/repeat.log" "check1=pending"
    expect_line "$STMP/repeat.log" "check2=pending"
    expect_line "$STMP/repeat.log" "check3=none"
    # Re-exec proof: the child sees the sentinel and every
    # thread (main plus runtime workers) blocks SIGINT and
    # SIGTERM, so no process-directed stop signal can land
    # in a worker and miss signalfd.
    "$PROBE" threads >"$STMP/threads.log" 2>&1 || {
        echo "signals: threads exits nonzero" >&2
        failed=1
    }
    expect_line "$STMP/threads.log" "sentinel_before=1"
    nthreads=$(grep -c '^sigblk\[' "$STMP/threads.log" || true)
    if [ "$nthreads" -lt 2 ]; then
        echo "signals: want >=2 threads, got $nthreads" >&2
        failed=1
    fi
    bad=0
    while IFS= read -r line; do
        hex=${line##*=}
        last4=$(printf '%s' "$hex" | tail -c 4)
        v=$((0x$last4))
        if [ $((v & 0x4002)) -ne $((0x4002)) ]; then
            echo "signals: thread mask missing bits: $line" >&2
            bad=1
        fi
    done <<EOF
$(grep '^sigblk\[' "$STMP/threads.log" || true)
EOF
    if [ "$bad" -ne 0 ]; then
        failed=1
    fi
    # Spoofed sentinel: a pre-set MEMVEIL_SIGBLK=1 without the
    # inherited mask must refuse (exit 3), never run with
    # unblocked workers. Re-execing would loop, so refusal is
    # the only fail-closed answer.
    MEMVEIL_SIGBLK=1 "$PROBE" threads >"$STMP/spoof.log" 2>&1
    rc=$?
    if [ "$rc" -ne 3 ]; then
        echo "signals: spoofed sentinel exits $rc, want 3" >&2
        failed=1
    fi
    expect_line "$STMP/spoof.log" "reexec_refused=signal mask not inherited (MEMVEIL_SIGBLK set, SIGINT/SIGTERM unblocked); refusing"
    # Big environment: ~1.2 MiB across 20 variables must
    # still re-exec exactly once (getenv lookup, no read
    # cap). timeout -s KILL bounds a re-exec loop: SIGTERM
    # is blocked by design, so plain timeout cannot stop one.
    if ! python3 - "$PROBE" "$STMP/bigenv.log" <<'PYEOF'
import os, subprocess, sys
env = dict(os.environ)
for i in range(20):
    env["MV_BIG%02d" % i] = "x" * 60000
p = subprocess.run(
    ["timeout", "-s", "KILL", "60", sys.argv[1], "threads"],
    capture_output=True, text=True, env=env,
)
open(sys.argv[2], "w").write(p.stdout)
sys.exit(0 if p.returncode == 0 else 1)
PYEOF
    then
        echo "signals: big-environment run failed" >&2
        failed=1
    fi
    expect_line "$STMP/bigenv.log" "sentinel_before=1"
    bad=0
    while IFS= read -r line; do
        case "$line" in
            sigblk\[*\]=*)
                mask=${line#*=}
                dec=$((16#$mask))
                if [ $((dec & 0x4002)) -ne $((0x4002)) ]; then
                    echo "signals: big-env unblocked: $line" >&2
                    bad=1
                fi
                ;;
        esac
    done <"$STMP/bigenv.log"
    if [ "$bad" -ne 0 ]; then
        failed=1
    fi
    run_collector_case() { # <name> <mode> <signo>
        dir="$STMP/$1"
        "$PROBE" "$2" "$3" "$dir" >"$STMP/$1.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "signals: $1 exits $rc" >&2
            failed=1
            return
        fi
        expect_line "$STMP/$1.log" "exit=4"
        expect_line "$STMP/$1.log" "end=signal"
        expect_line "$STMP/$1.log" "outcome=finalized"
    }
    run_collector_case latch15 latch 15
    run_collector_case latch2 latch 2
    expect_line "$STMP/latch15.log" "polls=105"
    expect_line "$STMP/latch15.log" "stats=5"
    expect_line "$STMP/latch15.log" "snaps=4"
    expect_line "$STMP/latch15.log" "reads=14"
    expect_line "$STMP/latch15.log" "committed=1494"
    run_collector_case inhand15 inhand 15
    expect_line "$STMP/inhand15.log" "polls=103"
    expect_line "$STMP/inhand15.log" "stats=5"
    expect_line "$STMP/inhand15.log" "snaps=4"
    expect_line "$STMP/inhand15.log" "reads=12"
    expect_line "$STMP/inhand15.log" "committed=1495"
    for which in mask signalfd; do
        dir="$STMP/fail-$which"
        "$PROBE" setup_fail "$which" "$dir" >"$STMP/fail-$which.log" 2>&1
        rc=$?
        if [ "$rc" -ne 0 ]; then
            echo "signals: setup_fail $which exits $rc" >&2
            failed=1
        fi
        expect_line "$STMP/fail-$which.log" "exit=3"
        expect_line "$STMP/fail-$which.log" "end=unknown"
        expect_line "$STMP/fail-$which.log" "outcome=refused"
        expect_line "$STMP/fail-$which.log" \
            "diag=signal setup: test $which failure"
        expect_line "$STMP/fail-$which.log" \
            "sigblk_initial=0000000000004002"
        expect_line "$STMP/fail-$which.log" \
            "sigblk_restored=0000000000004002"
    done
    # External process-directed signals: the probe runs to
    # ready (printed after signalfd setup), then the lane
    # kills it. A lost signal would hang to the timeout.
    run_kill_case() { # <name> <signo>
        dir="$STMP/$1"
        "$PROBE" sigterm_run "$dir" >"$STMP/$1.log" 2>&1 &
        pid=$!
        (sleep 25; kill -KILL "$pid" 2>/dev/null) &
        wd=$!
        ready=0
        for _ in $(seq 1 100); do
            if grep -q '^ready session=' "$STMP/$1.log" 2>/dev/null; then
                ready=1
                break
            fi
            sleep 0.1
        done
        if [ "$ready" -ne 1 ]; then
            echo "signals: $1 never reached ready" >&2
            kill -KILL "$pid" 2>/dev/null
            wait "$pid" 2>/dev/null
            kill "$wd" 2>/dev/null
            wait "$wd" 2>/dev/null
            failed=1
            return
        fi
        kill "-$2" "$pid" 2>/dev/null
        wait "$pid"
        rc=$?
        kill "$wd" 2>/dev/null
        wait "$wd" 2>/dev/null
        if [ "$rc" -ne 0 ]; then
            echo "signals: $1 exits $rc (want 0)" >&2
            cat "$STMP/$1.log" >&2
            failed=1
            return
        fi
        expect_line "$STMP/$1.log" "end=signal"
        expect_line "$STMP/$1.log" "outcome=finalized"
    }
    run_kill_case killterm TERM
    run_kill_case killint INT
    if [ "$failed" -ne 0 ]; then
        echo "signals: FAILED" >&2
        return 1
    fi
    echo "signals: live signalfd, re-exec, and kill cases passed"
    return 0
}

suite_package() {
    if [ -z "${LMB_PACKAGE:-}" ]; then
        echo "package: LMB_PACKAGE is not set" >&2
        return 1
    fi
    if ! command -v python3 >/dev/null 2>&1; then
        echo "package: python3 not found" >&2
        return 1
    fi
    if ! python3 -m pytest --version >/dev/null 2>&1; then
        echo "package: pytest not importable" >&2
        return 1
    fi
    if ! command -v strace >/dev/null 2>&1; then
        echo "package: strace not found (clean-room audit needs it)" >&2
        return 1
    fi
    PTMP=$(mktemp -d)
    trap 'rm -rf "$PTMP"' EXIT
    if ! LMB_PACKAGE="$LMB_PACKAGE" "$ROOT/tools/package" \
        >"$PTMP/package.log" 2>&1; then
        echo "package: tools/package failed" >&2
        cat "$PTMP/package.log" >&2
        return 1
    fi
    TARBALL=$(sed -n 's/^package: \(.*\.tar\.gz\)$/\1/p' \
        "$PTMP/package.log" | tail -1)
    if [ -z "$TARBALL" ] || [ ! -f "$TARBALL" ]; then
        echo "package: no tarball in package log" >&2
        cat "$PTMP/package.log" >&2
        return 1
    fi
    if ! MV_BUNDLE_TARBALL="$TARBALL" MV_REPO="$ROOT" \
        MV_VALID_EMPTY="$ROOT/tests/package/valid-empty" \
        python3 -m pytest tests/package/ \
        >"$PTMP/pytest.log" 2>&1; then
        echo "package: clean-runtime tests failed" >&2
        cat "$PTMP/pytest.log" >&2
        return 1
    fi
    tail -1 "$PTMP/pytest.log"
    echo "package: owner bundle and clean-room replay passed"
    return 0
}

suite_record() {
    run_unit_file tests/unit/test_hash.mojo || return 1
    run_unit_file tests/unit/test_gzip.mojo || return 1
    run_unit_file tests/unit/test_clock.mojo || return 1
    run_unit_file tests/unit/test_kernel.mojo || return 1
    run_unit_file tests/unit/test_live.mojo || return 1
    run_unit_file tests/unit/test_btf.mojo || return 1
    echo "record: unit suites passed"
    BIN="$ROOT/build/memveil"
    if [ ! -x "$BIN" ]; then
        echo "record: missing $BIN (run tools/build first)" >&2
        return 1
    fi
    TMP=$(mktemp -d)
    trap 'rm -rf "$TMP"' EXIT
    rfailed=0
    rexpect() { # <case> <want-exit> <want-err> <residual-or-empty> -- <args...>
        cname=$1; want_exit=$2; want_err=$3; residual=$4
        shift 4
        if [ "$1" = "--" ]; then shift; fi
        "$BIN" record "$@" >"$TMP/$cname.out" 2>"$TMP/$cname.err"
        rc=$?
        if [ "$rc" -ne "$want_exit" ]; then
            echo "record: case $cname exit $rc, want $want_exit" >&2
            cat "$TMP/$cname.err" >&2
            rfailed=1
            return 0
        fi
        if ! grep -qF "$want_err" "$TMP/$cname.err"; then
            echo "record: case $cname missing [$want_err]" >&2
            cat "$TMP/$cname.err" >&2
            rfailed=1
            return 0
        fi
        if [ -n "$residual" ] && [ -e "$residual" ]; then
            echo "record: case $cname left residual $residual" >&2
            rfailed=1
            return 0
        fi
        echo "ok record-cli $cname (exit $rc)"
    }
    "$BIN" record --help >"$TMP/help.out" 2>"$TMP/help.err"
    rc=$?
    if [ "$rc" -ne 0 ] || ! grep -qF "usage: memveil record" "$TMP/help.out"; then
        echo "record: case help failed (exit $rc)" >&2
        rfailed=1
    else
        echo "ok record-cli help (exit 0)"
    fi
    rexpect no-args 2 "missing --output" "" --
    rexpect unknown-flag 2 "unknown option" "" -- --bogus
    rexpect bad-duration 2 "bad decimal" "" -- \
        --output "$TMP/r" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --duration 0
    rexpect duration-suffix 2 "bad decimal" "" -- \
        --output "$TMP/r" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --duration 60s
    rexpect budget-low 3 "below 131072" "$TMP/r-low" -- \
        --output "$TMP/r-low" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --bridge "$TMP/nolib.so" --max-events-bytes 131071
    rexpect budget-high 3 "above 4294967296" "$TMP/r-high" -- \
        --output "$TMP/r-high" --object "$ROOT/tests/fixtures/elf/ok.o" \
        --bridge "$TMP/nolib.so" --max-events-bytes 4294967297
    env -u LMB_NATIVE_LIB "$BIN" record --output "$TMP/r-nobridge" \
        --object "$ROOT/tests/fixtures/elf/ok.o" \
        >"$TMP/nobridge.out" 2>"$TMP/nobridge.err"
    rc=$?
    if [ "$rc" -ne 3 ] || ! grep -qF "no bridge" "$TMP/nobridge.err" \
        || [ -e "$TMP/r-nobridge" ]; then
        echo "record: case no-bridge failed (exit $rc)" >&2
        cat "$TMP/nobridge.err" >&2
        rfailed=1
    else
        echo "ok record-cli no-bridge (exit 3)"
    fi
    host_ok=0
    if [ "$(uname -m)" = "x86_64" ]; then
        kmaj=$(uname -r | cut -d. -f1)
        case $kmaj in
            '' | *[!0-9]*) ;;
            *) if [ "$kmaj" -ge 7 ]; then host_ok=1; fi ;;
        esac
    fi
    if [ "$host_ok" -eq 1 ]; then
        rexpect bad-object 3 "object refused: not a BPF object" \
            "$TMP/r-badobj" -- \
            --output "$TMP/r-badobj" \
            --object "$ROOT/tests/fixtures/elf/badarch.o" \
            --bridge "$TMP/nolib.so"
        rexpect profile-miss 3 "unknown --profile" "$TMP/r-miss" -- \
            --output "$TMP/r-miss" \
            --object "$ROOT/tests/fixtures/elf/ok.o" \
            --bridge "$TMP/nolib.so" --profile definitely-not-a-profile
        if [ ! -f /sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format ]; then
            rexpect no-format 3 "format unreadable" "$TMP/r-nofmt" -- \
                --output "$TMP/r-nofmt" \
                --object "$ROOT/tests/fixtures/elf/ok.o" \
                --bridge "$TMP/nolib.so"
        else
            echo "record-cli: no-format skipped (live hook present)"
        fi
    else
        echo "record-cli: env cases skipped (needs x86_64 kernel >= 7)"
    fi
    if [ "$rfailed" -ne 0 ]; then
        return 1
    fi
    echo "record: CLI refusal cases passed"
    return 0
}


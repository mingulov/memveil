suite_release_runtime() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "release-runtime: python3 not found" >&2
        return 1
    fi
    if ! python3 -m pytest --version >/dev/null 2>&1; then
        echo "release-runtime: pytest not importable" >&2
        return 1
    fi
    TARBALL="${MV_BUNDLE_TARBALL:-}"
    if [ -z "$TARBALL" ]; then
        if [ -z "${LMB_PACKAGE:-}" ]; then
            echo "release-runtime: BLOCKED: MV_BUNDLE_TARBALL is not" \
                "set and LMB_PACKAGE is not set (build the candidate" \
                "with tools/package from a clean tree first)" >&2
            return 1
        fi
        RTMP=$(mktemp -d)
        trap 'rm -rf "$RTMP"' EXIT
        if ! LMB_PACKAGE="$LMB_PACKAGE" "$ROOT/tools/package" \
            >"$RTMP/package.log" 2>&1; then
            echo "release-runtime: BLOCKED: tools/package failed" >&2
            cat "$RTMP/package.log" >&2
            return 1
        fi
        TARBALL=$(sed -n 's/^package: \(.*\.tar\.gz\)$/\1/p' \
            "$RTMP/package.log" | tail -1)
        if [ -z "$TARBALL" ] || [ ! -f "$TARBALL" ]; then
            echo "release-runtime: no tarball in package log" >&2
            cat "$RTMP/package.log" >&2
            return 1
        fi
    fi
    if [ ! -f "$TARBALL" ]; then
        echo "release-runtime: MV_BUNDLE_TARBALL is not a file:" \
            "$TARBALL" >&2
        return 1
    fi
    (cd "$ROOT" && MV_BUNDLE_TARBALL="$TARBALL" MV_REPO="$ROOT" \
        MV_VALID_EMPTY="$ROOT/tests/package/valid-empty" \
        python3 -m pytest tests/package/test_release_runtime.py)
}


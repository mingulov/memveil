#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
# memveil test runner.
#
# Usage: tools/test <suite> | tools/test --help
#
# Implemented suites: schemas, unit, reports, profiles, doctor, attempts,
# writer, signals, record, vm-attempts, buildcache, package, identity,
# correlation, mappings, lifetimes, pools, regions, diagnostics,
# conversion-normalize, confidential-hooks, region-resolution,
# baseline, confidential-ranges, confidential-inventory,
# confidential-real, confidential-late-attach, top,
# oracle-ledger, vm-oracle, profile-semantics, vm-lifecycle,
# vm-copy, vm-real-io, stop, vm-stop, budgets, quality,
# vm-saturation, reader-adversarial, fuzz-smoke, fuzz-campaign,
# record-failures, output-paths, vm-cleanup, privacy,
# render-escaping, offline-environment, perf-replay,
# perf-workload, soak, preview-package, provenance, source-export,
# release-runtime, docs, examples.
#
# A skipped suite is reported as skipped, never as success.
# Exit 0 only when the suite passes; 1 on test failure; 2 on
# invalid usage; 77 when a suite with unmet inputs skips.
# One suite per invocation; extra arguments are rejected.
#
# The unit suite runs every Mojo unit test through the pinned toolchain.
# The reports suite drives the built report binary end to end: golden
# stdout bytes, exact exit codes (0 sufficient, 4 materially
# incomplete, 2 invalid input), and independently recomputed counts
# from tools/validate-schemas over generated JSON reports.
# The profiles suite runs the reader/evidence/profile/discovery unit
# tests. The doctor suite runs the doctor unit tests, then the built
# doctor verb live: oracle-checked JSON, identity cross-checks against
# uname/id, exit/verdict consistency, and usage errors.

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
}

mojo_inc_flags() {
    # Extra -I flags, one per line, when the unpacked libbpf-mojo
    # tree is present (tools/build prepares it from LMB_PACKAGE).
    if [ -d "$ROOT/build/deps/lmb/mojo/libbpf_mojo" ]; then
        printf '%s\n' "-I" "$ROOT/build/deps/lmb/mojo"
    fi
}

run_unit_file() {
    file=$1
    # shellcheck disable=SC2046
    out=$(cd "$ROOT" && pixi run --frozen mojo run -I src \
        $(mojo_inc_flags) "$file" 2>&1)
    rc=$?
    summary=$(printf '%s\n' "$out" | grep -E '[0-9]+ tests run' | tail -1)
    if [ "$rc" -eq 0 ] && printf '%s\n' "$out" | grep -q '0 failed'; then
        echo "ok $file: $summary"
        return 0
    fi
    echo "FAIL $file (exit $rc)"
    printf '%s\n' "$out"
    return 1
}

suite_unit() {
    failed=0
    for t in tests/unit/test_reader.mojo \
             tests/unit/test_attempts.mojo \
             tests/unit/test_report.mojo; do
        run_unit_file "$t" || failed=1
    done
    if [ "$failed" -ne 0 ]; then
        echo "unit: FAILED" >&2
        return 1
    fi
    echo "unit: all suites passed"
    return 0
}

report_pass=0
report_fail=0

report_ok() {
    echo "ok $1"
    report_pass=$((report_pass + 1))
}

report_bad() {
    echo "FAIL $1" >&2
    report_fail=$((report_fail + 1))
}

# expect_stdout <label> <golden> <expected-exit> <args...>
expect_stdout() {
    label=$1
    golden=$2
    want_exit=$3
    shift 3
    if [ ! -f "$ROOT/$golden" ]; then
        report_bad "$label: missing golden $golden"
        return 0
    fi
    "$BIN" "$@" >"$TMP/out" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    if ! cmp -s "$TMP/out" "$ROOT/$golden"; then
        report_bad "$label: stdout differs from $golden"
        return 0
    fi
    report_ok "$label (exit $rc, golden match)"
}

# expect_json <label> <fixture> <expected-exit> <counts-line> [extra args...]
expect_json() {
    label=$1
    fixture=$2
    want_exit=$3
    want_counts=$4
    shift 4
    rm -rf "$TMP/cap"
    mkdir -p "$TMP/cap"
    cp "$ROOT/$fixture/session.json" "$TMP/cap/session.json"
    cp "$ROOT/$fixture/events.ndjson" "$TMP/cap/events.ndjson"
    "$BIN" report "$@" --format json "$ROOT/$fixture" \
        >"$TMP/cap/report.json" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    counts=$("$ROOT/tools/validate-schemas" "$TMP/cap" 2>&1)
    rc=$?
    if [ "$rc" -ne 0 ]; then
        report_bad "$label: oracle rejected generated report: $counts"
        return 0
    fi
    if [ "$counts" != "$want_counts" ]; then
        report_bad "$label: counts '$counts', want '$want_counts'"
        return 0
    fi
    report_ok "$label (exit $want_exit, $counts)"
}

# expect_error <label> <expected-exit> <args...>
expect_error() {
    label=$1
    want_exit=$2
    shift 2
    "$BIN" "$@" >"$TMP/out" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    if [ -s "$TMP/out" ]; then
        report_bad "$label: stdout must be empty on exit $rc"
        return 0
    fi
    if [ ! -s "$TMP/err" ]; then
        report_bad "$label: stderr must explain exit $rc"
        return 0
    fi
    report_ok "$label (exit $rc, quiet stdout)"
}

# expect_text_exit <label> <fixture> <expected-exit> [extra args...]
expect_text_exit() {
    label=$1
    fixture=$2
    want_exit=$3
    shift 3
    "$BIN" report "$@" "$ROOT/$fixture" >"$TMP/out" 2>"$TMP/err"
    rc=$?
    if [ "$rc" -ne "$want_exit" ]; then
        report_bad "$label: exit $rc, want $want_exit"
        return 0
    fi
    if [ ! -s "$TMP/out" ]; then
        report_bad "$label: exit $rc must still print a report"
        return 0
    fi
    report_ok "$label (exit $rc)"
}


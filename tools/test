    # ONLY for the listed intentionally-invalid fixtures.
    # Baseline region detail round-trips exactly since the parser
    # retains every observation. Exit 1 (mismatch) always fails.
    ROUNDTRIP="$ROOT/build/roundtrip_check"
    (cd "$ROOT" && pixi run --frozen mojo build -I src \
        --target-cpu x86-64-v2 \
        -o "$ROUNDTRIP" tests/unit/roundtrip_check.mojo) || return 1
    failed=0
    checked=0
    while IFS= read -r file; do
        rel=${file#"$ROOT"/}
        "$ROUNDTRIP" "$file" >/tmp/rt-out.log 2>&1
        rc=$?
        checked=$((checked + 1))
        case "$rel" in
            tests/fixtures/reader/adv-bad-seq-int/events.ndjson|\

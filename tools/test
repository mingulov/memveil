suite_buildcache() {
    # Warm-cache verification: tampered or incomplete caches
    # heal from verified bytes, stale digests rebuild with a
    # tarball and fail fast without any source. Needs
    # LMB_PACKAGE (the pinned tarball path).
    if [ -z "${LMB_PACKAGE:-}" ] || [ ! -f "$LMB_PACKAGE" ]; then
        echo "buildcache: skipped (set LMB_PACKAGE to the pinned tarball)"
        return 77
    fi
    BTMP=$(mktemp -d)
    trap 'rm -rf "$BTMP"' EXIT
    bfailed=0
    bpin=$(python3 -c "
import json
lock = json.load(open('$ROOT/toolchain.lock.json'))
print(lock['dependencies']['libbpf-mojo']['tarball_sha256'])
")
    bver=$(python3 -c "
import json
lock = json.load(open('$ROOT/toolchain.lock.json'))
print(lock['dependencies']['libbpf-mojo']['version'])
")
    bvendored="$ROOT/third_party/libbpf-mojo-$bver.tar.gz"
    # Case 1: combined tampering (edited lmb source, edited
    # header, deleted header) heals in one build.
    echo "BUILDCACHE-TAMPER" >>"$ROOT/build/deps/lmb/mojo/libbpf_mojo/session.mojo"
    echo "BUILDCACHE-TAMPER" >>"$ROOT/build/deps/include/bpf/bpf_helpers.h"
    rm "$ROOT/build/deps/include/bpf/bpf_endian.h"
    if ! LMB_PACKAGE="$LMB_PACKAGE" "$ROOT/tools/build" \
        >"$BTMP/heal.log" 2>&1; then
        echo "buildcache: heal build failed" >&2
        tail -20 "$BTMP/heal.log" >&2
        bfailed=1
    fi
    grep -q "libbpf-mojo .* refresh" "$BTMP/heal.log" || {
        echo "buildcache: lmb tamper not detected" >&2
        bfailed=1
    }
    grep -q "libbpf headers refresh" "$BTMP/heal.log" || {
        echo "buildcache: libbpf tamper not detected" >&2
        bfailed=1
    }
    if grep -rq "BUILDCACHE-TAMPER" \
        "$ROOT/build/deps/lmb/mojo/libbpf_mojo/session.mojo" \
        "$ROOT/build/deps/include/bpf/bpf_helpers.h"; then
        echo "buildcache: tamper marker survives heal" >&2
        bfailed=1
    fi
    if [ ! -f "$ROOT/build/deps/include/bpf/bpf_endian.h" ]; then
        echo "buildcache: deleted header not restored" >&2
        bfailed=1
    fi
    if [ ! -f "$ROOT/build/deps/lmb-package.tgz" ] \
        || [ ! -f "$ROOT/build/deps/libbpf.tgz" ]; then
        echo "buildcache: verified tarballs not kept" >&2
        bfailed=1
    fi
    # Case 2: a stale digest rebuilds with a tarball.
    echo "deadbeef" >"$ROOT/build/deps/lmb/.digest"
    if ! LMB_PACKAGE="$LMB_PACKAGE" "$ROOT/tools/build" \
        >"$BTMP/stale.log" 2>&1; then
        echo "buildcache: stale rebuild failed" >&2
        tail -20 "$BTMP/stale.log" >&2
        bfailed=1
    fi
    grep -q "libbpf-mojo .* refresh" "$BTMP/stale.log" || {
        echo "buildcache: stale digest not detected" >&2
        bfailed=1
    }
    if [ "$(cat "$ROOT/build/deps/lmb/.digest")" != "$bpin" ]; then
        echo "buildcache: digest not re-pinned after rebuild" >&2
        bfailed=1
    fi
    # Case 3: a stale digest without any source fails fast
    # and removes the untrusted cache; then restore. Every
    # source (environment, kept copy, vendored tarball) is
    # stashed so the premise holds.
    echo "deadbeef" >"$ROOT/build/deps/lmb/.digest"
    mv "$ROOT/build/deps/lmb-package.tgz" "$BTMP/lmb-package.tgz"
    if [ -f "$bvendored" ]; then
        mv "$bvendored" "$BTMP/lmb-vendored.tgz"
    fi
    if env -u LMB_PACKAGE "$ROOT/tools/build" \
        >"$BTMP/offline.log" 2>&1; then
        echo "buildcache: sourceless stale build exits 0" >&2
        bfailed=1
    fi
    grep -q "FAIL libbpf-mojo cache missing, stale, or tampered" \
        "$BTMP/offline.log" || {
        echo "buildcache: missing stale-cache diagnostic" >&2
        bfailed=1
    }
    if [ -e "$ROOT/build/deps/lmb" ]; then
        echo "buildcache: untrusted cache not removed" >&2
        bfailed=1
    fi
    mv "$BTMP/lmb-package.tgz" "$ROOT/build/deps/lmb-package.tgz"
    if [ -f "$BTMP/lmb-vendored.tgz" ]; then
        mv "$BTMP/lmb-vendored.tgz" "$bvendored"
    fi
    if ! LMB_PACKAGE="$LMB_PACKAGE" "$ROOT/tools/build" \
        >"$BTMP/restore.log" 2>&1; then
        echo "buildcache: restore build failed (tree unhealthy)" >&2
        tail -20 "$BTMP/restore.log" >&2
        bfailed=1
    fi
    # Case 4: tampering heals from the kept tarball with no
    # LMB_PACKAGE in the environment (offline byte-compare).
    echo "BUILDCACHE-TAMPER" >>"$ROOT/build/deps/lmb/mojo/libbpf_mojo/batch.mojo"
    if ! env -u LMB_PACKAGE "$ROOT/tools/build" \
        >"$BTMP/kept.log" 2>&1; then
        echo "buildcache: kept-tarball heal failed" >&2
        tail -20 "$BTMP/kept.log" >&2
        bfailed=1
    fi
    grep -q "libbpf-mojo .* refresh" "$BTMP/kept.log" || {
        echo "buildcache: kept-tarball tamper not detected" >&2
        bfailed=1
    }
    if grep -q "BUILDCACHE-TAMPER" \
        "$ROOT/build/deps/lmb/mojo/libbpf_mojo/batch.mojo"; then
        echo "buildcache: tamper marker survives kept heal" >&2
        bfailed=1
    fi
    # Case 5: a valid stamp without any archive still fails
    # when sources are tampered: stamps alone prove nothing.
    # Every source (environment, kept copy, vendored tarball)
    # is stashed so the premise holds.
    echo "BUILDCACHE-TAMPER" >>"$ROOT/build/deps/lmb/mojo/libbpf_mojo/error.mojo"
    mv "$ROOT/build/deps/lmb-package.tgz" "$BTMP/lmb-package.tgz"
    if [ -f "$bvendored" ]; then
        mv "$bvendored" "$BTMP/lmb-vendored.tgz"
    fi
    if env -u LMB_PACKAGE "$ROOT/tools/build" \
        >"$BTMP/archivless.log" 2>&1; then
        echo "buildcache: archivless tampered build exits 0" >&2
        bfailed=1
    fi
    grep -q "FAIL libbpf-mojo cache missing, stale, or tampered" \
        "$BTMP/archivless.log" || {
        echo "buildcache: missing archivless diagnostic" >&2
        bfailed=1
    }
    if [ -e "$ROOT/build/deps/lmb" ]; then
        echo "buildcache: untrusted cache not removed" >&2
        bfailed=1
    fi
    mv "$BTMP/lmb-package.tgz" "$ROOT/build/deps/lmb-package.tgz"
    if [ -f "$BTMP/lmb-vendored.tgz" ]; then
        mv "$BTMP/lmb-vendored.tgz" "$bvendored"
    fi
    if ! env -u LMB_PACKAGE "$ROOT/tools/build" \
        >"$BTMP/restore2.log" 2>&1; then
        echo "buildcache: kept restore failed (tree unhealthy)" >&2
        tail -20 "$BTMP/restore2.log" >&2
        bfailed=1
    fi
    # Case 6: with the kept tarball stashed and no LMB_PACKAGE,
    # a tampered cache heals from the vendored tarball alone,
    # and the kept copy is refreshed from it; then restore.
    echo "BUILDCACHE-TAMPER" >>"$ROOT/build/deps/lmb/mojo/libbpf_mojo/session.mojo"
    mv "$ROOT/build/deps/lmb-package.tgz" "$BTMP/lmb-package.tgz"
    if ! env -u LMB_PACKAGE "$ROOT/tools/build" \
        >"$BTMP/vendored.log" 2>&1; then
        echo "buildcache: vendored-tarball heal failed" >&2
        tail -20 "$BTMP/vendored.log" >&2
        bfailed=1
    fi
    grep -q "vendored third_party tarball" "$BTMP/vendored.log" || {
        echo "buildcache: vendored source not used" >&2
        bfailed=1
    }
    grep -q "libbpf-mojo .* refresh" "$BTMP/vendored.log" || {
        echo "buildcache: vendored tamper not detected" >&2
        bfailed=1
    }
    if grep -q "BUILDCACHE-TAMPER" \
        "$ROOT/build/deps/lmb/mojo/libbpf_mojo/session.mojo"; then
        echo "buildcache: tamper marker survives vendored heal" >&2
        bfailed=1
    fi
    if [ ! -f "$ROOT/build/deps/lmb-package.tgz" ]; then
        echo "buildcache: kept copy not refreshed from vendored" >&2
        bfailed=1
    fi
    mv "$BTMP/lmb-package.tgz" "$ROOT/build/deps/lmb-package.tgz"
    if [ "$bfailed" -ne 0 ]; then
        echo "buildcache: FAILED" >&2
        return 1
    fi
    echo "buildcache: tamper-heal, stale, kept-tarball, vendored-tarball, and refusal cases passed"
    return 0
}

suite_writer() {

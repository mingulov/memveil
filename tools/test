#!/usr/bin/env bash
# memveil test runner.
#
# Usage: tools/test <suite> | tools/test --help
#
# Implemented suites: schemas.
#
# Planned suites: unit, reports, profiles, doctor, attempts, writer,
# vm-attempts, package.
# A skipped privileged test is reported as skipped, never as success.
# Exit 0 only when the suite passes; 1 on test failure; 2 on invalid usage.
# One suite per invocation; extra arguments are rejected.

set -u

ROOT="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
    sed -n '2,/^$/p' "$0" | sed 's/^# //; s/^#//'
}

if [ $# -eq 0 ]; then
    usage >&2
    exit 2
fi
if [ $# -gt 1 ]; then
    echo "test: too many arguments" >&2
    usage >&2
    exit 2
fi
case "$1" in
    --help|-h)
        usage
        ;;
    schemas)
        exec "$ROOT/tools/validate-schemas"
        ;;
    unit|reports|profiles|doctor|attempts|writer|vm-attempts|package)
        echo "test: suite '$1' is not implemented yet" >&2
        exit 2
        ;;
    *)
        echo "test: unknown suite: $1" >&2
        usage >&2
        exit 2
        ;;
esac

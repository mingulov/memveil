#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Build the third-party memveil .deb from the tested owner bundle.

Runs tools/package (exact pinned bridge, closure-checked lib set,
license texts, MANIFEST.json) and rearranges the staged tree into
the installed FHS layout the Phase A discovery constants resolve
with zero flags or environment::

    usr/bin/memveil                 binary (RUNPATH $ORIGIN/../lib/memveil),
                                    stripped
    usr/lib/memveil/*.so*           Mojo runtime closure + libbpf_mojo.so.1,
                                    stripped (--strip-unneeded)
    usr/lib/memveil/*.bpf.o         production BPF objects (attempt,
                                    lifecycle, copy) beside the bridge:
                                    arch-dependent ELF under /usr/share
                                    is a packaging error
    usr/share/memveil/profiles/     manifest plus shipped profiles
    usr/share/memveil/docs/         the full manuals tree plus the worked
                                    example (docs/examples/real-capture)
    usr/share/doc/memveil/          copyright stub plus every license and
                                    notice text the bundle redistributes,
                                    plus the generated changelog.Debian.gz
                                    non-native packages must ship
    usr/share/man/man1/             memveil.1 plus one memveil-<verb>.1
                                    per verb, generated at build time
                                    from the --help texts
    usr/share/bash-completion/      static memveil completions from the
    completions/ + zsh              frozen verb/flag sets (bash plus
    vendor-completions/             zsh vendor dir)
    usr/share/lintian/overrides/    justified lintian overrides (BPF arch
    memveil                         false positive, uncompressed man)
    var/lib/memveil/receipts/       empty state dir (0755 root:root)

Control notes: manual ``Depends: libelf1t64 | libelf1, zlib1g,
libc6 (>= X.Y)`` (dpkg's t64 transition left no libelf1
candidate on current systems; the alternation installs on
pre-t64 and current ones while staying dh_shlibs-free; the
libc6 floor is derived at build time from the staged ELF
files, never hardcoded); no maintainer scripts (the private
lib needs no ldconfig, no collection runs at install);
DEBIAN/md5sums is generated over the payload for dpkg --verify;
no setuid bits or file capabilities. X-Memveil-Revision and
X-LMB-Tarball-SHA256 record the exact source and bridge bytes.

Third-party origin: the conda/pixi Mojo toolchain cannot enter
Debian, so this package is built outside the archive for a
third-party repo. Installed runs need no flags or
environment: profiles resolve from the installed share dir
and qualify receipts land under /var/lib/memveil/receipts.
Man pages are generated at build time from the --help texts
(tools/gen-man) and completions from the frozen verb/flag
sets (tools/gen-completions); the same generators feed the
.rpm, so both formats ship identical pages.

Usage: tools/package-deb [--out DIR] [--tag STEM]
  --out DIR   output directory (default: dist/)
  --tag STEM  .deb file stem (default: memveil_<version>-1_amd64)

Requires LMB_PACKAGE (pinned libbpf-mojo tarball, checked by
tools/package against the lock), a clean tree (enforced by
tools/package), patchelf, and dpkg-deb.
"""

import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

PACKAGE = "memveil"
SECTION = "utils"
PRIORITY = "optional"
ARCH = "amd64"
DEB_DEPENDS_BASE = "libelf1t64 | libelf1, zlib1g"
MAINTAINER = "Denis Mingulov <denis@mingulov.com>"
SHORT_DESC = ("swiotlb bounce-attempt capture and offline replay "
              "on x86-64 Linux")
LONG_DESC = (
    " Record swiotlb bounce activity, mapping lifetimes, and executed\n"
    " copies into a self-describing capture directory, then replay it\n"
    " offline as text, JSON, or Markdown. Counts are try-counts with\n"
    " requested bytes; actual copies come from the copy channel.\n"
    " .\n"
    " Third-party binary package: the conda/pixi Mojo toolchain cannot\n"
    " enter Debian, so this .deb is built outside the archive. Installed\n"
    " runs need no flags or environment: profiles resolve from\n"
    " the installed share dir and qualify receipts land under\n"
    " /var/lib/memveil/receipts."
)
COPYRIGHT = """\
Format: https://www.debian.org/doc/packaging-manuals/copyright-format/1.0/
Source: third-party binary build; see X-Memveil-Revision in DEBIAN/control

Files: *
Copyright: See LICENSE and THIRD-PARTY-NOTICES.md in this directory.
License: GPL-3.0-or-later
 The MemVeil sources are available under GPL-3.0-or-later; the full
 license text is in LICENSE. On Debian systems the GPL-3 text is
 also in /usr/share/common-licenses/GPL-3. BPF objects are
 GPL-2.0-only (LICENSES/). Redistributed third-party texts,
 including the libbpf-mojo bridge license, live in licenses/,
 with notices in THIRD-PARTY-NOTICES.md
 and THIRD-PARTY-NOTICES.libbpf-mojo.md.
"""

BPF_OBJECTS = (
    "swiotlb_attempt.bpf.o",
    "swiotlb_lifecycle.bpf.o",
    "swiotlb_copy.bpf.o",
)

# /usr/share/lintian/overrides/memveil: exactly two
# justified tags, pinned line by line by
# test_lintian_overrides_exact. The BPF objects are eBPF
# bytecode (EM_BPF), cross-architecture by nature, so
# binary-from-other-architecture is a false positive on
# them. The man pages stay uncompressed on purpose: the
# same generators feed the .rpm, whose post-processing is
# off, so both formats ship identical pages.
OVERRIDES = """\
# eBPF bytecode is cross-architecture by nature; these objects
# are intentionally shipped beside the bridge under /usr/lib.
memveil: binary-from-other-architecture usr/lib/memveil/swiotlb_attempt.bpf.o
memveil: binary-from-other-architecture usr/lib/memveil/swiotlb_copy.bpf.o
memveil: binary-from-other-architecture usr/lib/memveil/swiotlb_lifecycle.bpf.o
# Both formats ship identical pages from the same generators;
# compressing only the .deb side would break that identity.
memveil: uncompressed-manual-page usr/share/man/man1/memveil.1
memveil: uncompressed-manual-page usr/share/man/man1/memveil-record.1
memveil: uncompressed-manual-page usr/share/man/man1/memveil-report.1
memveil: uncompressed-manual-page usr/share/man/man1/memveil-top.1
memveil: uncompressed-manual-page usr/share/man/man1/memveil-doctor.1
memveil: uncompressed-manual-page usr/share/man/man1/memveil-qualify.1
"""

BIN_RUNPATH = "$ORIGIN/../lib/memveil"


def fail(message):
    print("package-deb: %s" % message, file=sys.stderr)
    sys.exit(1)


def run(argv, **kwargs):
    proc = subprocess.run(
        argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
        text=True, cwd=ROOT, **kwargs,
    )
    return proc


def needed(path):
    proc = run(["readelf", "-d", path])
    if proc.returncode != 0:
        fail("readelf failed on %s:\n%s" % (path, proc.stderr))
    return [line.split("[")[1].split("]")[0]
            for line in proc.stdout.splitlines()
            if "(NEEDED)" in line and "[" in line]


def parse_glibc_floor(version_info):
    """Max GLIBC_x.y need in readelf -V output, as (x, y) or None.

    Pure parser over the `.gnu.version_r` listing: every
    `GLIBC_<major>.<minor>` token is a minimum libc the
    file must load against, so the max wins. Non-glibc
    tokens (ELFUTILS_, GCC_, GLIBC_PRIVATE) never match.
    """
    floor = None
    for major, minor in re.findall(r"GLIBC_(\d+)\.(\d+)",
                                   version_info):
        need = (int(major), int(minor))
        if floor is None or need > floor:
            floor = need
    return floor


def glibc_floor(paths):
    """Max GLIBC_x.y need across staged ELF files, as "X.Y".

    Runs readelf -V over the staged binary plus every
    shipped .so and takes the max, so the Depends libc6
    floor always matches the bytes being shipped, never a
    stale literal. Fails closed when readelf fails or no
    GLIBC need is found.
    """
    floor = None
    for path in sorted(paths):
        proc = run(["readelf", "-V", path])
        if proc.returncode != 0:
            fail("readelf -V failed on %s:\n%s"
                 % (path, proc.stderr))
        need = parse_glibc_floor(proc.stdout)
        if need is not None and (floor is None or need > floor):
            floor = need
    if floor is None:
        fail("no GLIBC version need in staged ELF: %s"
             % sorted(paths))
    return "%d.%d" % floor


def strip_staged(binary, libdir):
    """Strip the staged release ELF, never the BPF objects.

    The binary is stripped fully and each staged .so with
    --strip-unneeded (lintian
    unstripped-binary-or-object); the dynamic section
    (NEEDED, RUNPATH, version needs) is untouched, so the
    Depends floor derivation still reads the staged bytes.
    Runs before the BPF objects are staged, so their
    symtabs cannot pass through here.
    """
    proc = run(["strip", binary])
    if proc.returncode != 0:
        fail("strip failed on %s:\n%s" % (binary, proc.stderr))
    for name in sorted(os.listdir(libdir)):
        if not re.fullmatch(r"[^/]+\.so(\..*)?", name):
            continue
        path = os.path.join(libdir, name)
        if not os.path.isfile(path):
            continue
        proc = run(["strip", "--strip-unneeded", path])
        if proc.returncode != 0:
            fail("strip failed on %s:\n%s" % (path, proc.stderr))


def sha256_file(path):
    import hashlib

    digest = hashlib.sha256()
    with open(path, "rb") as handle:
        for chunk in iter(lambda: handle.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def validate_stem(stem):
    """.deb file stem: a single safe path segment."""
    if not stem or stem in (".", ".."):
        raise ValueError("bad .deb stem %r" % stem)
    if "/" in stem or "\\" in stem or "\x00" in stem:
        raise ValueError("bad .deb stem %r" % stem)
    if stem.startswith("-"):
        raise ValueError("bad .deb stem %r" % stem)
    return stem


def validate_upstream(version):
    """Upstream version: Debian-safe dotted identifier."""
    if not re.fullmatch(r"[0-9][A-Za-z0-9.+~]*", version):
        raise ValueError("bad upstream version %r" % version)
    return version


def contained(path, directory):
    """True when path stays inside directory after normalization."""
    base = os.path.realpath(directory)
    full = os.path.realpath(path)
    return full == base or full.startswith(base + os.sep)


def fix_modes(root):
    """Staging modes: dirs 0755, files 0644, binary 0755.

    Ownership is forced to root:root by dpkg-deb
    --root-owner-group at build time, so no chown (and no
    privilege) is needed here.
    """
    binary = os.path.join(root, "usr", "bin", "memveil")
    for base, dirs, files in os.walk(root):
        for name in dirs:
            os.chmod(os.path.join(base, name), 0o755)
        for name in files:
            full = os.path.join(base, name)
            if os.path.realpath(full) == os.path.realpath(binary):
                os.chmod(full, 0o755)
            else:
                os.chmod(full, 0o644)
    os.chmod(root, 0o755)


def write_md5sums(root):
    """DEBIAN/md5sums over every payload file (dpkg --verify).

    debhelper's dh_md5sums normally writes this; raw staging
    generates the same "<md5>  <path>" lines with root-relative
    paths, sorted, covering payload files only (never DEBIAN/).
    """
    import hashlib

    entries = []
    for base, _, files in os.walk(root):
        for name in sorted(files):
            full = os.path.join(base, name)
            rel = os.path.relpath(full, root)
            if rel == "DEBIAN" or rel.startswith("DEBIAN/"):
                continue
            digest = hashlib.md5()
            with open(full, "rb") as handle:
                for chunk in iter(lambda: handle.read(65536), b""):
                    digest.update(chunk)
            entries.append("%s  %s\n" % (digest.hexdigest(), rel))
    entries.sort(key=lambda line: line.split("  ", 1)[1])
    with open(os.path.join(root, "DEBIAN", "md5sums"), "w") as handle:
        handle.writelines(entries)


def changelog_epoch():
    """Changelog clock: SOURCE_DATE_EPOCH or the current time.

    Honors the reproducible-builds epoch when set and
    falls back to now, so a pinned environment regenerates
    the same entry while ordinary builds stamp build time.
    """
    import time

    try:
        return int(os.environ.get("SOURCE_DATE_EPOCH") or time.time())
    except ValueError:
        return int(time.time())


def changelog_text(upstream, memveil_rev, epoch):
    """The Debian changelog entry for this third-party build.

    Non-native packages must ship changelog.Debian.gz
    (lintian no-changelog); the single entry names the
    engine version, the memveil revision the bundle
    recorded, and the control maintainer.
    """
    import datetime
    import email.utils

    stamp = email.utils.format_datetime(
        datetime.datetime.fromtimestamp(
            epoch, tz=datetime.timezone.utc))
    lines = [
        "memveil (%s-1) unstable; urgency=medium" % upstream,
        "",
        "  * Third-party binary build from memveil revision:",
        "    %s" % memveil_rev,
        "    The conda/pixi Mojo toolchain cannot enter Debian,",
        "    so this package is built outside the archive.",
        "",
        " -- %s  %s" % (MAINTAINER, stamp),
        "",
    ]
    return "\n".join(lines)


def write_changelog(licdir, upstream, memveil_rev):
    """Gzip the Debian changelog into the doc dir (mtime pinned).

    Policy wants changelog.Debian.gz; the gzip mtime is the
    changelog clock so SOURCE_DATE_EPOCH pins the bytes.
    """
    import gzip
    import io

    epoch = changelog_epoch()
    text = changelog_text(upstream, memveil_rev, epoch)
    buffer = io.BytesIO()
    with gzip.GzipFile(filename="", mode="wb", compresslevel=9,
                       mtime=epoch, fileobj=buffer) as handle:
        handle.write(text.encode("utf-8"))
    with open(os.path.join(licdir, "changelog.Debian.gz"),
              "wb") as handle:
        handle.write(buffer.getvalue())


def control_text(upstream, memveil_rev, lmb_sha, depends):
    lines = [
        "Package: %s" % PACKAGE,
        "Version: %s-1" % upstream,
        "Section: %s" % SECTION,
        "Priority: %s" % PRIORITY,
        "Architecture: %s" % ARCH,
        "Depends: %s" % depends,
        "Maintainer: %s" % MAINTAINER,
        "Description: %s" % SHORT_DESC,
        LONG_DESC,
        "X-Memveil-Revision: %s" % memveil_rev,
        "X-LMB-Tarball-SHA256: %s" % lmb_sha,
        "",
    ]
    return "\n".join(lines)


def main(argv):
    out_dir = os.path.join(ROOT, "dist")
    stem = None
    args = list(argv)
    while args:
        opt = args.pop(0)
        if opt in ("--help", "-h"):
            print(__doc__)
            return 0
        if opt == "--out" and args:
            out_dir = args.pop(0)
            continue
        if opt == "--tag" and args:
            stem = args.pop(0)
            continue
        fail("unknown option: %s" % opt)
    if not os.environ.get("LMB_PACKAGE"):
        fail("LMB_PACKAGE is not set; refusing an unpinned bridge")
    if not os.path.isfile(os.environ["LMB_PACKAGE"]):
        fail("LMB_PACKAGE is not a file: %s" % os.environ["LMB_PACKAGE"])
    if shutil.which("dpkg-deb") is None:
        fail("dpkg-deb is required to assemble the .deb")
    if shutil.which("patchelf") is None:
        fail("patchelf is required to retarget the FHS RUNPATH "
             "(apt install patchelf)")
    if shutil.which("readelf") is None:
        fail("readelf is required to verify the FHS binary")
    if shutil.which("strip") is None:
        fail("strip is required to strip the staged release ELF "
             "(apt install binutils)")

    work = tempfile.mkdtemp(prefix="memveil-deb-")
    try:
        bundle_parent = os.path.join(work, "bundle-build")
        os.makedirs(bundle_parent)
        build = run([os.path.join(ROOT, "tools", "package"),
                     "--out", bundle_parent, "--tag", "bundle"])
        if build.returncode != 0:
            print(build.stdout)
            print(build.stderr, file=sys.stderr)
            fail("tools/package failed")
        bundle = os.path.join(bundle_parent, "bundle")
        manifest = json.load(open(
            os.path.join(bundle, "MANIFEST.json")))
        try:
            upstream = validate_upstream(
                manifest["engine_version"])
        except ValueError as err:
            fail(str(err))
        memveil_rev = manifest["memveil_revision"]
        lmb_sha = manifest["libbpf_mojo"]["tarball_used_sha256"]
        if stem is None:
            stem = "%s_%s-1_%s" % (PACKAGE, upstream, ARCH)
        try:
            validate_stem(stem)
        except ValueError as err:
            fail(str(err))

        root = os.path.join(work, "root")
        bindir = os.path.join(root, "usr", "bin")
        libdir = os.path.join(root, "usr", "lib", "memveil")
        profdir = os.path.join(root, "usr", "share", "memveil",
                               "profiles")
        docdir = os.path.join(root, "usr", "share", "memveil", "docs")
        licdir = os.path.join(root, "usr", "share", "doc", "memveil")
        receipts = os.path.join(root, "var", "lib", "memveil",
                                "receipts")
        debdir = os.path.join(root, "DEBIAN")
        for path in (bindir, libdir, profdir, docdir, licdir,
                     receipts, debdir):
            os.makedirs(path)

        for name in sorted(os.listdir(os.path.join(bundle, "lib"))):
            shutil.copy2(os.path.join(bundle, "lib", name),
                         os.path.join(libdir, name))
        if not os.path.isfile(os.path.join(
                libdir, "libbpf_mojo.so.1")):
            fail("staged lib/ lacks the native bridge")

        binary = os.path.join(bindir, "memveil")
        shutil.copy2(os.path.join(bundle, "bin", "memveil"), binary)
        before = needed(binary)
        rewrite = run(["patchelf", "--set-rpath", BIN_RUNPATH,
                       binary])
        if rewrite.returncode != 0:
            fail("patchelf RUNPATH rewrite failed:\n%s"
                 % rewrite.stderr)
        if needed(binary) != before:
            fail("RUNPATH rewrite changed NEEDED: %r -> %r"
                 % (before, needed(binary)))
        dyn = run(["readelf", "-d", binary])
        if dyn.returncode != 0:
            fail("readelf failed on FHS binary:\n%s" % dyn.stderr)
        if BIN_RUNPATH not in dyn.stdout:
            fail("FHS binary lacks RUNPATH %s:\n%s"
                 % (BIN_RUNPATH, dyn.stdout))
        for line in dyn.stdout.splitlines():
            match = re.search(
                r"Library (?:runpath|rpath): \[(.*)\]", line)
            if not match:
                continue
            for entry in match.group(1).split(":"):
                if entry and not entry.startswith("$ORIGIN"):
                    fail("FHS binary keeps absolute RUNPATH entry "
                         "%r:\n%s" % (entry, dyn.stdout))
        strip_staged(binary, libdir)
        rerun = run([binary, "version"])
        if rerun.returncode != 0 \
                or rerun.stdout.strip() != "memveil-" + upstream:
            fail("FHS binary fails to start after RUNPATH "
                 "rewrite: %r" % rerun.stdout)

        for name in BPF_OBJECTS:
            src = os.path.join(bundle, "bpf", name)
            if not os.path.isfile(src):
                fail("bundle lacks BPF object %s" % name)
            shutil.copy2(src, os.path.join(libdir, name))
        for name in sorted(os.listdir(
                os.path.join(bundle, "profiles"))):
            shutil.copy2(os.path.join(bundle, "profiles", name),
                         os.path.join(profdir, name))
        if not os.path.isfile(os.path.join(profdir, "manifest.txt")):
            fail("staged profiles/ lacks manifest.txt")
        for base, dirs, files in os.walk(
                os.path.join(bundle, "docs")):
            dirs.sort()
            for name in sorted(files):
                src = os.path.join(base, name)
                rel = os.path.relpath(
                    src, os.path.join(bundle, "docs"))
                dest = os.path.join(docdir, rel)
                os.makedirs(os.path.dirname(dest), exist_ok=True)
                shutil.copy2(src, dest)
        shutil.copytree(os.path.join(bundle, "examples",
                                     "real-capture"),
                        os.path.join(docdir, "examples",
                                     "real-capture"))
        with open(os.path.join(licdir, "copyright"), "w") as handle:
            handle.write(COPYRIGHT)
        for name in ("LICENSE", "THIRD-PARTY-NOTICES.md",
                     "THIRD-PARTY-NOTICES.libbpf-mojo.md"):
            shutil.copy2(os.path.join(bundle, name),
                         os.path.join(licdir, name))
        for name in ("LICENSES", "licenses"):
            shutil.copytree(os.path.join(bundle, name),
                            os.path.join(licdir, name))
        write_changelog(licdir, upstream, memveil_rev)

        mandir = os.path.join(root, "usr", "share", "man", "man1")
        os.makedirs(mandir)
        gen_man = run([os.path.join(ROOT, "tools", "gen-man"),
                       "--binary", binary, "--out", mandir])
        if gen_man.returncode != 0:
            print(gen_man.stdout)
            print(gen_man.stderr, file=sys.stderr)
            fail("tools/gen-man failed")
        comp_parent = os.path.join(work, "completions")
        os.makedirs(comp_parent)
        gen_comp = run([os.path.join(ROOT, "tools",
                                     "gen-completions"),
                        "--out", comp_parent])
        if gen_comp.returncode != 0:
            print(gen_comp.stdout)
            print(gen_comp.stderr, file=sys.stderr)
            fail("tools/gen-completions failed")
        bashcomp = os.path.join(root, "usr", "share",
                                "bash-completion", "completions")
        zshcomp = os.path.join(root, "usr", "share", "zsh",
                               "vendor-completions")
        os.makedirs(bashcomp)
        os.makedirs(zshcomp)
        shutil.copy2(os.path.join(comp_parent, "memveil"),
                     os.path.join(bashcomp, "memveil"))
        shutil.copy2(os.path.join(comp_parent, "_memveil"),
                     os.path.join(zshcomp, "_memveil"))
        overdir = os.path.join(root, "usr", "share", "lintian",
                               "overrides")
        os.makedirs(overdir)
        with open(os.path.join(overdir, "memveil"), "w") as handle:
            handle.write(OVERRIDES)
        staged_elf = [binary]
        for name in sorted(os.listdir(libdir)):
            if re.fullmatch(r"[^/]+\.so(\..*)?", name) \
                    and os.path.isfile(
                        os.path.join(libdir, name)):
                staged_elf.append(os.path.join(libdir, name))
        depends = "%s, libc6 (>= %s)" % (
            DEB_DEPENDS_BASE, glibc_floor(staged_elf))
        with open(os.path.join(debdir, "control"), "w") as handle:
            handle.write(control_text(upstream, memveil_rev,
                                      lmb_sha, depends))

        write_md5sums(root)
        fix_modes(root)
        out = os.path.join(out_dir, stem + ".deb")
        if not contained(out, out_dir):
            fail(".deb target escapes output dir: %s" % stem)
        os.makedirs(out_dir, exist_ok=True)
        if os.path.exists(out):
            os.remove(out)
        deb = run(["dpkg-deb", "--root-owner-group", "--build",
                   root, out])
        if deb.returncode != 0:
            print(deb.stdout)
            print(deb.stderr, file=sys.stderr)
            fail("dpkg-deb --build failed")
    finally:
        shutil.rmtree(work, ignore_errors=True)
    print("package-deb: %s" % out)
    print("package-deb: sha256 %s" % sha256_file(out))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

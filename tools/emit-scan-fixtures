"""Generate admission-scan fixtures (roots + bound profile docs).

Roots under tests/fixtures/scan/<ok,skew,noconfig,diffconfig,moved>/
mirror the narrow/ok identity tree with a tracepoint format,
plus a boot_id file:
  ok         references every source for a bound decision.
  skew       replaces the disk image (bid still matches).
  noconfig   drops both config sources (config uncheckable).
  diffconfig swaps config.gz bytes (config mismatch).
  moved      swaps the format for layout/moved.format (the
             size field drifted; admission must refuse with
             the named field diff).

Profiles under tests/fixtures/scan/profiles/ carry section 5
grammar bindings computed from the CURRENT fixture bytes:
  valid.json   validated, bindings match ok/ + elf/ok.o.
  ref.json     reference-unvalidated, same bindings.
  badbind.json validated, object binding names elf/badring.o.
  unbound.json reference-unvalidated, free-text note.
  sat.json     reference-unvalidated, object+badring ring
               (saturation mechanism stand-in).
  ref-stale.json reference-unvalidated, current bindings;
               its receipt still names the previous format
               hash (stale-receipt stand-in).
  valid-lc.json validated, 12-field note binding elf/lc-ok.o
               and elf/cp-ok.o with both caps supported and the
               frozen tracing hook sets.
  lc-skew.json validated, 12-field note with a skewed
               lc_object binding (extended mismatch).
  lc-wrongfunc.json, lc-wrongattach.json, lc-missing.json,
               lc-extra.json, lc-badsig.json: single-deviation
               tracing-binding variants of valid-lc.json.
Manifest lists valid.json only; tests address the rest by
path. All hashes are recomputed here, so editing any input
fixture regenerates consistent bindings.

Receipts under profiles/receipts/ back the reference docs
for local-auto admission tests:
  scan-ref.json       attempt-trace receipt for scan-ref.
  scan-ref-lc.json    three-capability receipt for scan-ref-lc.
  scan-ref-stale.json attempt-trace receipt for scan-ref-stale
                      with a superseded format binding.
"""
import hashlib
import json
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
NARROW = ROOT / "tests/fixtures/narrow/ok"
LAYOUT = ROOT / "tests/fixtures/layout/ok.format"
LAYOUT_MOVED = ROOT / "tests/fixtures/layout/moved.format"
ELF_OK = ROOT / "tests/fixtures/elf/ok.o"
ELF_BADRING = ROOT / "tests/fixtures/elf/badring.o"
ELF_LC_OK = ROOT / "tests/fixtures/elf/lc-ok.o"
ELF_CP_OK = ROOT / "tests/fixtures/elf/cp-ok.o"
SCAN = ROOT / "tests/fixtures/scan"
REL = "7.0.0-test"
FMT_PATH = "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format"
BOOT_ID = "00112233-4455-6677-8899-aabbccddeeff\n"


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def gunzip_first(path: Path) -> bytes:
    import gzip

    raw = path.read_bytes()
    if raw[:2] == b"\x1f\x8b":
        with gzip.open(path, "rb") as fh:
            return fh.read()
    return raw


def write_tree(
    dst: Path,
    config: bytes | None,
    image: bytes | None,
    fmt: Path | None = None,
) -> None:
    if dst.exists():
        shutil.rmtree(dst)
    dst.mkdir(parents=True)
    (dst / "meta.txt").write_text(
        f"arch=x86_64\nrelease={REL}\neuid=0\n"
    )
    (dst / "proc/sys/kernel/random").mkdir(parents=True)
    (dst / "proc").mkdir(exist_ok=True)
    (dst / "sys/kernel/btf").mkdir(parents=True)
    (dst / "sys/kernel/tracing/events/swiotlb/swiotlb_bounced").mkdir(
        parents=True
    )
    (dst / "sys/kernel").mkdir(exist_ok=True)
    (dst / "boot").mkdir(exist_ok=True)
    if config is not None:
        (dst / "proc/config.gz").write_bytes(config)
    shutil.copy(NARROW / "sys/kernel/btf/vmlinux", dst / "sys/kernel/btf/vmlinux")
    shutil.copy(
        LAYOUT if fmt is None else fmt,
        dst / ("sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format"),
    )
    shutil.copy(NARROW / "sys/kernel/notes", dst / "sys/kernel/notes")
    if config is not None:
        shutil.copy(
            NARROW / f"boot/config-{REL}", dst / f"boot/config-{REL}"
        )
    if image is None:
        image = (NARROW / f"boot/vmlinuz-{REL}").read_bytes()
    (dst / f"boot/vmlinuz-{REL}").write_bytes(image)
    (dst / "proc/sys/kernel/random/boot_id").write_text(BOOT_ID)


TRACE_HOOKS = [
    (
        "fexit:swiotlb_tbl_map_single",
        "swiotlb_tbl_map_single",
        "fexit",
        "phys_addr_t swiotlb_tbl_map_single(struct device *dev,"
        " phys_addr_t orig_addr, size_t mapping_size,"
        " unsigned int alloc_align_mask, enum dma_data_direction dir,"
        " unsigned long attrs)",
    ),
    (
        "fentry:__swiotlb_tbl_unmap_single",
        "__swiotlb_tbl_unmap_single",
        "fentry",
        "void __swiotlb_tbl_unmap_single(struct device *dev,"
        " phys_addr_t tlb_addr, size_t mapping_size,"
        " enum dma_data_direction dir, unsigned long attrs,"
        " struct io_tlb_pool *pool)",
    ),
    (
        "fentry:__swiotlb_sync_single_for_device",
        "__swiotlb_sync_single_for_device",
        "fentry",
        "void __swiotlb_sync_single_for_device(struct device *dev,"
        " phys_addr_t tlb_addr, size_t size,"
        " enum dma_data_direction dir, struct io_tlb_pool *pool)",
    ),
    (
        "fentry:__swiotlb_sync_single_for_cpu",
        "__swiotlb_sync_single_for_cpu",
        "fentry",
        "void __swiotlb_sync_single_for_cpu(struct device *dev,"
        " phys_addr_t tlb_addr, size_t size,"
        " enum dma_data_direction dir, struct io_tlb_pool *pool)",
    ),
    (
        "fentry:swiotlb_bounce",
        "swiotlb_bounce",
        "fentry",
        "void swiotlb_bounce(struct device *dev, phys_addr_t tlb_addr,"
        " size_t size, enum dma_data_direction dir,"
        " struct io_tlb_pool *mem)",
    ),
]

LC_HOOK_NAMES = [TRACE_HOOKS[0][0], TRACE_HOOKS[1][0]]
CP_HOOK_NAMES = [TRACE_HOOKS[2][0], TRACE_HOOKS[3][0], TRACE_HOOKS[4][0]]


def tracing_hook(name: str, function: str, attach: str, signature: str) -> dict:
    return {
        "name": name,
        "kind": "tracing",
        "function": function,
        "attach": attach,
        "signature": signature,
        "note": "Scan-fixture hook.",
    }


def all_hooks() -> list:
    hooks = [
        {
            "name": "swiotlb:swiotlb_bounced",
            "kind": "tracepoint",
            "id_path": "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/id",
            "format_path": FMT_PATH,
            "format_text": LAYOUT.read_text(),
            "note": "Scan-fixture hook.",
        }
    ]
    for name, function, attach, signature in TRACE_HOOKS:
        hooks.append(tracing_hook(name, function, attach, signature))
    return hooks


def profile_doc(
    pid: str,
    status: str,
    note: str,
    attempt: str,
    format_text: str | None = None,
    hooks: list | None = None,
    lifecycle: str = "unsupported",
    copycap: str = "unsupported",
    lc_hooks: list | None = None,
    cp_hooks: list | None = None,
) -> dict:
    if hooks is None:
        if format_text is None:
            format_text = LAYOUT.read_text()
        hooks = [
            {
                "name": "swiotlb:swiotlb_bounced",
                "kind": "tracepoint",
                "id_path": "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/id",
                "format_path": FMT_PATH,
                "format_text": format_text,
                "note": "Scan-fixture hook.",
            }
        ]
    caps = [
        {
            "id": "mapping-lifecycle",
            "status": lifecycle,
            "hooks": lc_hooks if lc_hooks is not None else [],
            "reason": "Scan fixture.",
        },
        {
            "id": "copy-actual",
            "status": copycap,
            "hooks": cp_hooks if cp_hooks is not None else [],
            "reason": "Scan fixture.",
        },
    ]
    if hooks:
        caps.insert(
            0,
            {
                "id": "attempt-trace",
                "status": attempt,
                "hooks": ["swiotlb:swiotlb_bounced"],
                "reason": "Scan fixture.",
            },
        )
    return {
        "schema_version": "0.1.1",
        "profile_id": pid,
        "status": status,
        "identity": {
            "arch": "x86_64",
            "min_kernel": "7.0",
            "source": {"origin": "test", "revision": REL, "note": note},
            "note": "Scan-fixture identity; never ship.",
        },
        "hooks": hooks,
        "capabilities": caps,
        "notes": ["Scan fixture; regenerated by tools/emit-scan-fixtures."],
    }


def note_for(bind: dict, extra: dict | None = None) -> str:
    parts = [
        f"config=sha256:{bind['config']}",
        f"config_src={bind['config_src']}",
        f"btf=sha256:{bind['btf']}",
        f"format=sha256:{bind['format']}",
        f"object=sha256:{bind['object']}",
        f"image=sha256:{bind['image']}",
        f"image_bid={bind['image_bid']}",
        f"ring_bytes={bind['ring']}",
    ]
    if extra is not None:
        parts += [
            f"lc_object=sha256:{extra['lc_object']}",
            f"lc_ring_bytes={extra['lc_ring']}",
            f"cp_object=sha256:{extra['cp_object']}",
            f"cp_ring_bytes={extra['cp_ring']}",
        ]
    note = " ".join(parts)
    assert len(note) <= 1024, "note exceeds 1024"
    return note


def parse_bid(notes_path: Path) -> str:
    import struct

    data = notes_path.read_bytes()
    pos = 0
    while pos + 12 <= len(data):
        namesz, descsz, ntype = struct.unpack_from("<III", data, pos)
        pos += 12
        name_end = pos + ((namesz + 3) // 4) * 4
        is_gnu = (
            ntype == 3
            and namesz == 4
            and data[pos : pos + 4] == b"GNU\x00"
        )
        pos = name_end
        desc_end = pos + ((descsz + 3) // 4) * 4
        if is_gnu:
            assert descsz == 20, "build-id length"
            return data[pos : pos + 20].hex()
        pos = desc_end
    raise AssertionError("no build-id note")


def receipt_doc(
    pid: str, bind: dict, caps: dict, objects: dict | None = None
) -> dict:
    return {
        "schema_version": "0.1.0",
        "kind": "memveil-qualification-receipt",
        "profile_id": pid,
        "grade": "local-auto",
        "created_ns": "123456789",
        "kernel": {"arch": "x86_64", "release": REL},
        "bindings": {
            "config": f"sha256:{bind['config']}",
            "config_src": bind["config_src"],
            "btf": f"sha256:{bind['btf']}",
            "format": f"sha256:{bind['format']}",
            "image": f"sha256:{bind['image']}",
            "image_bid": bind["image_bid"],
        },
        "capabilities": {
            cid: {"status": "qualified", "detail": detail}
            for cid, detail in caps.items()
        },
        "artifacts": {
            "memveil": "0.1.0",
            "bridge": "sha256:" + sha(ELF_OK),
            "objects": {"attempt": "sha256:" + sha(ELF_OK)}
            | (objects or {}),
        },
        "workload": {
            "kind": "smoke",
            "duration_s": "3",
            "traffic_required": False,
            "note": "scan fixture receipt",
        },
    }


def main() -> int:
    for need in [
        NARROW,
        LAYOUT,
        LAYOUT_MOVED,
        ELF_OK,
        ELF_BADRING,
        ELF_LC_OK,
        ELF_CP_OK,
    ]:
        if not need.exists():
            print(f"missing {need}", file=sys.stderr)
            return 1
    config_gz = (NARROW / "proc/config.gz").read_bytes()
    write_tree(SCAN / "ok", config_gz, None)
    write_tree(SCAN / "skew", config_gz, b"skewed-image-bytes")
    write_tree(SCAN / "noconfig", None, None)
    write_tree(SCAN / "diffconfig", b"different-config-bytes", None)
    write_tree(SCAN / "moved", config_gz, None, LAYOUT_MOVED)

    ok = SCAN / "ok"
    bind = {
        "config": hashlib.sha256(gunzip_first(ok / "proc/config.gz")).hexdigest(),
        "config_src": "gz",
        "btf": sha(ok / "sys/kernel/btf/vmlinux"),
        "format": sha(ok / FMT_PATH.lstrip("/")),
        "object": sha(ELF_OK),
        "image": sha(ok / f"boot/vmlinuz-{REL}"),
        "image_bid": parse_bid(ok / "sys/kernel/notes"),
        "ring": "8388608",
    }
    prof = SCAN / "profiles"
    prof.mkdir(exist_ok=True)
    docs = {
        "valid.json": ("scan-valid", "validated", note_for(bind), "supported"),
        "ref.json": (
            "scan-ref",
            "reference-unvalidated",
            note_for(bind),
            "candidate",
        ),
        "ref-stale.json": (
            "scan-ref-stale",
            "reference-unvalidated",
            note_for(bind),
            "candidate",
        ),
        "badbind.json": (
            "scan-badbind",
            "validated",
            note_for({**bind, "object": sha(ELF_BADRING)}),
            "supported",
        ),
        "unbound.json": (
            "scan-unbound",
            "reference-unvalidated",
            "Free text: no grammar bindings here.",
            "candidate",
        ),
        "sat.json": (
            "scan-sat",
            "reference-unvalidated",
            note_for(
                {**bind, "object": sha(ELF_BADRING), "ring": "4194304"}
            ),
            "candidate",
        ),
    }
    for name, (pid, status, note, attempt) in docs.items():
        (prof / name).write_text(
            json.dumps(profile_doc(pid, status, note, attempt), indent=2)
            + "\n"
        )
    (prof / "valid-unbound.json").write_text(
        json.dumps(
            profile_doc(
                "scan-valid-unbound",
                "validated",
                "Validated status with no grammar bindings.",
                "supported",
            ),
            indent=2,
        )
        + "\n"
    )
    (prof / "nohook.json").write_text(
        json.dumps(
            profile_doc(
                "scan-nohook",
                "reference-unvalidated",
                note_for(bind),
                "candidate",
                hooks=[],
            ),
            indent=2,
        )
        + "\n"
    )
    (prof / "notext.json").write_text(
        json.dumps(
            profile_doc(
                "scan-notext",
                "validated",
                note_for(bind),
                "supported",
                format_text=None,
                hooks=[
                    {
                        "name": "swiotlb:swiotlb_bounced",
                        "kind": "tracepoint",
                        "id_path": "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/id",
                        "format_path": FMT_PATH,
                        "format_text": None,
                        "note": "Scan-fixture hook.",
                    }
                ],
            ),
            indent=2,
        )
        + "\n"
    )
    extra = {
        "lc_object": sha(ELF_LC_OK),
        "lc_ring": "8388608",
        "cp_object": sha(ELF_CP_OK),
        "cp_ring": "8388608",
    }
    lc_doc = profile_doc(
        "scan-valid-lc",
        "validated",
        note_for(bind, extra),
        "supported",
        hooks=all_hooks(),
        lifecycle="supported",
        copycap="supported",
        lc_hooks=list(LC_HOOK_NAMES),
        cp_hooks=list(CP_HOOK_NAMES),
    )
    (prof / "valid-lc.json").write_text(json.dumps(lc_doc, indent=2) + "\n")
    skewed = dict(extra)
    skewed["lc_object"] = sha(ELF_CP_OK)
    (prof / "lc-skew.json").write_text(
        json.dumps(
            profile_doc(
                "scan-lc-skew",
                "validated",
                note_for(bind, skewed),
                "supported",
                hooks=all_hooks(),
                lifecycle="supported",
                copycap="supported",
                lc_hooks=list(LC_HOOK_NAMES),
                cp_hooks=list(CP_HOOK_NAMES),
            ),
            indent=2,
        )
        + "\n"
    )

    def mutate(pid: str, fn) -> dict:
        import copy

        doc = copy.deepcopy(lc_doc)
        doc["profile_id"] = pid
        fn(doc)
        return doc

    def hook_by_name(doc: dict, name: str) -> dict:
        for hook in doc["hooks"]:
            if hook["name"] == name:
                return hook
        raise AssertionError(f"missing hook {name}")

    def cap_by_id(doc: dict, cid: str) -> dict:
        for cap in doc["capabilities"]:
            if cap["id"] == cid:
                return cap
        raise AssertionError(f"missing cap {cid}")

    variants = {
        # One wrong function field; name join key unchanged.
        "lc-wrongfunc.json": (
            "scan-lc-wrongfunc",
            lambda d: hook_by_name(
                d, "fentry:__swiotlb_tbl_unmap_single"
            ).update({"function": "__swiotlb_tbl_unmap_sg"}),
        ),
        # Map hook attached at entry instead of exit.
        "lc-wrongattach.json": (
            "scan-lc-wrongattach",
            lambda d: hook_by_name(
                d, "fexit:swiotlb_tbl_map_single"
            ).update({"attach": "fentry"}),
        ),
        # Lifecycle cap names only the map hook.
        "lc-missing.json": (
            "scan-lc-missing",
            lambda d: cap_by_id(d, "mapping-lifecycle").update(
                {"hooks": ["fexit:swiotlb_tbl_map_single"]}
            ),
        ),
        # Lifecycle cap adds the tracepoint hook.
        "lc-extra.json": (
            "scan-lc-extra",
            lambda d: cap_by_id(d, "mapping-lifecycle").update(
                {"hooks": LC_HOOK_NAMES + ["swiotlb:swiotlb_bounced"]}
            ),
        ),
        # Map signature text corrupted by one byte.
        "lc-badsig.json": (
            "scan-lc-badsig",
            lambda d: hook_by_name(
                d, "fexit:swiotlb_tbl_map_single"
            ).update(
                {
                    "signature": hook_by_name(
                        d, "fexit:swiotlb_tbl_map_single"
                    )["signature"].replace("attrs)", "attrs!)", 1)
                }
            ),
        ),
    }
    for name, (pid, fn) in variants.items():
        (prof / name).write_text(
            json.dumps(mutate(pid, fn), indent=2) + "\n"
        )
    import copy

    ref_lc = copy.deepcopy(lc_doc)
    ref_lc["profile_id"] = "scan-ref-lc"
    ref_lc["status"] = "reference-unvalidated"
    (prof / "ref-lc.json").write_text(
        json.dumps(ref_lc, indent=2) + "\n"
    )
    receipts = prof / "receipts"
    receipts.mkdir(exist_ok=True)
    (receipts / "scan-ref.json").write_text(
        json.dumps(
            receipt_doc(
                "scan-ref",
                bind,
                {"attempt-trace": "smoke attached, layout holds"},
            ),
            indent=2,
        )
        + "\n"
    )
    stale_bind = dict(bind)
    stale_bind["format"] = "0" * 64
    (receipts / "scan-ref-stale.json").write_text(
        json.dumps(
            receipt_doc(
                "scan-ref-stale",
                stale_bind,
                {"attempt-trace": "smoke attached, layout holds"},
            ),
            indent=2,
        )
        + "\n"
    )
    (receipts / "scan-ref-lc.json").write_text(
        json.dumps(
            receipt_doc(
                "scan-ref-lc",
                bind,
                {
                    "attempt-trace": "smoke attached, layout holds",
                    "mapping-lifecycle": "fentry/fexit smoke ok",
                    "copy-actual": "fentry smoke ok",
                },
                {
                    "lifecycle": "sha256:" + sha(ELF_LC_OK),
                    "copy": "sha256:" + sha(ELF_CP_OK),
                },
            ),
            indent=2,
        )
        + "\n"
    )
    (prof / "manifest.txt").write_text("valid.json\n")
    print(f"wrote scan fixtures to {SCAN}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

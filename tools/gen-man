#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Render memveil man pages from the live --help texts.

The CLI help is the single source of truth: every page embeds
the exact bytes of `memveil --help` (for memveil.1) or
`memveil <verb> --help` (for memveil-<verb>.1), so a help
change without regeneration is impossible -- the pages are
rebuilt from the binary on every package build. Output is
deterministic (no dates or timestamps).

Usage: tools/gen-man --binary PATH --out DIR
  --binary PATH   memveil binary to query (required)
  --out DIR       directory receiving memveil.1 plus one
                  memveil-<verb>.1 per help-bearing verb

Fails closed when the binary is missing or any --help call
fails. Hyphens stay literal on purpose: the drift guard
asserts every --help line appears verbatim in its page, so
only backslashes and leading ./"'" escapes are applied.
"""

import os
import re
import subprocess
import sys

VERBS = ("record", "report", "top", "doctor", "qualify")


def fail(message):
    print("gen-man: %s" % message, file=sys.stderr)
    sys.exit(1)


def run_help(binary, verb):
    argv = [binary] if verb == "" else [binary, verb]
    try:
        proc = subprocess.run(
            argv + ["--help"], stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, timeout=120)
    except OSError as err:
        fail("cannot run %s: %s" % (" ".join(argv), err))
    if proc.returncode != 0:
        fail("%s --help exits %d:\n%s" % (
            verb or "(top)", proc.returncode, proc.stderr))
    if not proc.stdout.strip():
        fail("%s --help printed nothing" % (verb or "(top)"))
    return proc.stdout


def roff_escape(line):
    out = line.replace("\\", "\\(rs")
    if out.startswith(".") or out.startswith("'"):
        out = "\\&" + out
    return out


def verb_summary(top_help, verb):
    for line in top_help.splitlines():
        match = re.match(r"  (%s)\s+(.*)$" % verb, line)
        if match:
            return match.group(2)
    fail("top --help names no %r row" % verb)


def render_page(title, name, short, version, ref, help_text):
    lines = [
        ".TH %s 1 \"\" \"%s\" \"User Commands\"" % (title, version),
        ".\\\" Generated by tools/gen-man from '%s'; do not edit."
        % ref,
        ".SH NAME",
        "%s \\- %s" % (name, short),
        ".SH SYNOPSIS",
        ".nf",
    ]
    synopsis = help_text.split("\n\n")[0]
    if "usage:" not in synopsis:
        fail("%s has no usage paragraph" % ref)
    lines.extend(roff_escape(line) for line in synopsis.split("\n"))
    lines.append(".fi")
    lines.append(".SH DESCRIPTION")
    lines.append(".nf")
    lines.extend(roff_escape(line) for line in
                 help_text.split("\n"))
    lines.append(".fi")
    lines.append("")
    return "\n".join(lines)


def main(argv):
    binary = None
    out_dir = None
    args = list(argv)
    while args:
        opt = args.pop(0)
        if opt in ("--help", "-h"):
            print(__doc__)
            return 0
        if opt == "--binary" and args:
            binary = args.pop(0)
            continue
        if opt == "--out" and args:
            out_dir = args.pop(0)
            continue
        fail("unknown option: %s" % opt)
    if not binary:
        fail("--binary PATH is required")
    if not os.path.isfile(binary):
        fail("binary is not a file: %s" % binary)
    if not out_dir:
        fail("--out DIR is required")
    os.makedirs(out_dir, exist_ok=True)

    try:
        proc = subprocess.run(
            [binary, "version"], stdout=subprocess.PIPE,
            stderr=subprocess.PIPE, text=True, timeout=120)
    except OSError as err:
        fail("cannot run %s version: %s" % (binary, err))
    if proc.returncode != 0 or not proc.stdout.strip():
        fail("%s version failed" % binary)
    version = proc.stdout.strip()

    top_help = run_help(binary, "")
    short = None
    for line in top_help.splitlines():
        if line.endswith(" Verbs:"):
            short = line[:-len(" Verbs:")]
            short = short[:1].lower() + short[1:]
    if not short:
        fail("top --help lost its summary line")
    pages = {"memveil.1": ("MEMVEIL", "memveil", short,
                           "memveil --help", top_help)}
    for verb in VERBS:
        text = run_help(binary, verb)
        short = verb_summary(top_help, verb)
        title = "MEMVEIL-" + verb.upper()
        pages["memveil-%s.1" % verb] = (
            title, "memveil-" + verb, short,
            "memveil %s --help" % verb, text)
    for name in sorted(pages):
        title, page, short, ref, text = pages[name]
        with open(os.path.join(out_dir, name), "w") as handle:
            handle.write(render_page(title, page, short, version,
                                     ref, text))
    print("gen-man: %d pages -> %s" % (len(pages), out_dir))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

# SPDX-License-Identifier: GPL-3.0-or-later
"""Render static memveil shell completions from frozen sets.

The FROZEN_* sets below are the completion source. They are
pinned a second time, as independent literals, in
tests/package/test_deb.py, which also proves them against the
live --help texts: a new verb, flag, or --format value fails
naming the exact token until the generator AND the test pins
are updated together. The -h alias is completed everywhere
--help is; it appears in no --help text, so a live -h guard
in the test pins (not the text comparisons) binds it.

Usage: tools/gen-completions --out DIR
  --out DIR   directory receiving `memveil` (bash) and
              `_memveil` (zsh)

Deterministic: same bytes on every run. `--flag=value` needs
no handling: the parser only accepts space-separated values.
"""

import os
import sys

FROZEN_VERBS = ("record", "report", "top", "doctor", "qualify",
                "help", "version")
FROZEN_TOP_FLAGS = ("--help", "--version", "-h")
FROZEN_FLAGS = {
    "record": ("--bridge", "--capability", "--cp-object",
               "--device", "--duration", "--help", "--lc-object",
               "--max-events-bytes", "--object", "--output",
               "--profile", "--profiles-dir", "-h"),
    "report": ("--allow-partial", "--format", "--help",
               "--long-lived-after", "--max-events-bytes",
               "--max-line-bytes", "--max-session-bytes", "-h"),
    "top": ("--bridge", "--capability", "--cp-object",
            "--device", "--duration", "--help", "--interval",
            "--lc-object", "--long-lived-after",
            "--max-events-bytes", "--max-line-bytes",
            "--max-session-bytes", "--object", "--output",
            "--profile", "--profiles-dir", "-h"),
    "doctor": ("--bridge", "--capability", "--cp-object",
               "--help", "--json", "--lc-object", "--load-check",
               "--object", "--profiles-dir", "-h"),
    "qualify": ("--bridge", "--capability", "--cp-object",
                "--help", "--lc-object", "--object",
                "--output", "--profile", "--profiles-dir", "-h"),
}
FROZEN_FORMAT_VALUES = ("text", "json", "markdown")
FROZEN_NOVALUE_FLAGS = ("--help", "--allow-partial", "--json",
                          "--load-check", "-h")

# One-line zsh descriptions; flag presence (not these words)
# is what the drift guard pins.
_ZSH_DESC = {
    "-h": "show help",
    "--allow-partial": "drop a truncated final record",
    "--bridge": "explicit bridge path",
    "--capability": "extra channel ids",
    "--cp-object": "copy channel object",
    "--device": "device rows to show",
    "--duration": "capture seconds",
    "--format": "output format",
    "--help": "show help",
    "--interval": "refresh interval",
    "--json": "print the JSON report",
    "--lc-object": "lifecycle channel object",
    "--load-check": "load objects without attaching",
    "--long-lived-after": "long-lived finding age",
    "--max-events-bytes": "total work cap",
    "--max-line-bytes": "per-record cap",
    "--max-session-bytes": "session file cap",
    "--object": "attempt channel object",
    "--output": "capture directory",
    "--profile": "profile id or path",
    "--profiles-dir": "profiles directory",
}


def fail(message):
    print("gen-completions: %s" % message, file=sys.stderr)
    sys.exit(1)


def render_bash():
    lines = [
        "# bash completion for memveil "
        "(generated by tools/gen-completions; do not edit).",
        '_memveil_verbs="%s"' % " ".join(FROZEN_VERBS),
        '_memveil_top_flags="%s"' % " ".join(FROZEN_TOP_FLAGS),
    ]
    for verb in sorted(FROZEN_FLAGS):
        lines.append('_memveil_flags_%s="%s"' % (
            verb, " ".join(FROZEN_FLAGS[verb])))
    lines.append('_memveil_format_values="%s"' % " ".join(
        FROZEN_FORMAT_VALUES))
    lines.extend([
        "_memveil() {",
        "    local cur verb prev flags",
        "    COMPREPLY=()",
        '    cur="${COMP_WORDS[COMP_CWORD]:-}"',
        '    if [ "${COMP_CWORD}" -eq 1 ]; then',
        '        if [[ "$cur" == -* ]]; then',
        "            COMPREPLY=( $(compgen -W "
        '"$_memveil_top_flags" -- "$cur") )',
        "        else",
        "            COMPREPLY=( $(compgen -W "
        '"$_memveil_verbs" -- "$cur") )',
        "        fi",
        "        return 0",
        "    fi",
        '    verb="${COMP_WORDS[1]:-}"',
        '    case "$verb" in',
    ])
    for verb in sorted(FROZEN_FLAGS):
        lines.append('        %s) flags="$_memveil_flags_%s" ;;'
                     % (verb, verb))
    lines.extend([
        "        *) return 0 ;;",
        "    esac",
        '    if [[ "$cur" == -* ]]; then',
        "        COMPREPLY=( $(compgen -W "
        '"$flags" -- "$cur") )',
        "        return 0",
        "    fi",
        '    prev="${COMP_WORDS[COMP_CWORD-1]:-}"',
        '    if [ "$prev" = "--format" ]; then',
        "        COMPREPLY=( $(compgen -W "
        '"$_memveil_format_values" -- "$cur") )',
        "        return 0",
        "    fi",
        "    return 0",
        "}",
        "complete -F _memveil -o default memveil",
        "",
    ])
    return "\n".join(lines)


def _zsh_opt(verb, flag):
    desc = _ZSH_DESC[flag]
    if flag == "--format":
        # Two colons: _arguments reads `opt[descr]:name:action`,
        # so the enum must sit in the action slot. A single
        # colon parks the values in the message and completes
        # nothing.
        return "'--format[%s]:format:(%s)'" % (
            desc, " ".join(FROZEN_FORMAT_VALUES))
    if flag in FROZEN_NOVALUE_FLAGS:
        return "'%s[%s]'" % (flag, desc)
    return "'%s[%s]:value:_files'" % (flag, desc)


def render_zsh():
    lines = [
        "#compdef memveil",
        "# zsh completion for memveil "
        "(generated by tools/gen-completions; do not edit).",
        "_memveil() {",
        "    local -a verbs",
        "    verbs=(%s)" % " ".join(FROZEN_VERBS),
        "    if (( CURRENT == 2 )); then",
        "        _describe -t verbs 'memveil verb' verbs",
        "        _arguments -s -S '--help[top-level help]' "
        "'--version[engine version]' '-h[top-level help]'",
        "        return",
        "    fi",
        '    case "$words[2]" in',
    ]
    for verb in sorted(FROZEN_FLAGS):
        lines.append("        %s)" % verb)
        lines.append("            _arguments -s -S \\")
        opts = [_zsh_opt(verb, flag)
                for flag in FROZEN_FLAGS[verb]]
        opts.append("'*::file:_files'")
        for opt in opts[:-1]:
            lines.append("                %s \\" % opt)
        lines.append("                %s" % opts[-1])
        lines.append("            ;;")
    lines.extend([
        "        help|version) ;;",
        "        *) _message 'unknown verb' ;;",
        "    esac",
        "}",
        '_memveil "$@"',
        "",
    ])
    return "\n".join(lines)


def main(argv):
    out_dir = None
    args = list(argv)
    while args:
        opt = args.pop(0)
        if opt in ("--help", "-h"):
            print(__doc__)
            return 0
        if opt == "--out" and args:
            out_dir = args.pop(0)
            continue
        fail("unknown option: %s" % opt)
    if not out_dir:
        fail("--out DIR is required")
    for verb in sorted(FROZEN_FLAGS):
        for flag in FROZEN_FLAGS[verb]:
            if flag not in _ZSH_DESC:
                fail("no zsh description for %s %s" % (verb, flag))
    os.makedirs(out_dir, exist_ok=True)
    with open(os.path.join(out_dir, "memveil"), "w") as handle:
        handle.write(render_bash())
    with open(os.path.join(out_dir, "_memveil"), "w") as handle:
        handle.write(render_zsh())
    print("gen-completions: bash+zsh -> %s" % out_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

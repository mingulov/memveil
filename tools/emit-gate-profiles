#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Author the gate profile docs from dumped guest identity.

Inputs: guest identity JSON (release, config_src, config/btf/
format/image shas, image bid) plus the live format text, plus
the current production and saturation object builds.
Outputs:
  profiles/linux-x86_64-7.0.0-34-generic.json (reference-
    unvalidated until the promotion commit flips ONLY the
    status line)
  tests/fixtures/profiles/saturation-candidate.json (test
    expectation, explicit path only, never scanned)

Re-running after a kernel/producer change re-qualifies the
bindings; the gate itself enforces the checked-in values.
"""
import hashlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
DOC = ROOT / "profiles/linux-x86_64-7.0.0-34-generic.json"
SAT = ROOT / "tests/fixtures/profiles/saturation-candidate.json"
PROD_OBJ = ROOT / "build/bpf/swiotlb_attempt.bpf.o"
SAT_OBJ = ROOT / "build/bpf/swiotlb_attempt-test.bpf.o"
FMT_PATH = "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format"


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def note_for(b: dict) -> str:
    note = " ".join(
        [
            f"config=sha256:{b['config']}",
            f"config_src={b['config_src']}",
            f"btf=sha256:{b['btf']}",
            f"format=sha256:{b['format']}",
            f"object=sha256:{b['object']}",
            f"image=sha256:{b['image']}",
            f"image_bid={b['image_bid']}",
            f"ring_bytes={b['ring']}",
        ]
    )
    assert len(note) <= 512, "note exceeds 512"
    return note


def doc_for(
    pid: str, status: str, rev: str, note: str, fmt_text: str, attempt: str
) -> dict:
    return {
        "schema_version": "0.1.1",
        "profile_id": pid,
        "status": status,
        "identity": {
            "arch": "x86_64",
            "min_kernel": "7.0.0",
            "source": {"origin": "distro", "revision": rev, "note": note},
            "note": (
                "Narrow identity for the qualified gate kernel. The "
                "bindings name the exact config, BTF, tracepoint "
                "format, object, image, and build-id qualified by "
                "the live cross-check; any change fails admission "
                "until re-qualification."
            ),
        },
        "hooks": [
            {
                "name": "swiotlb:swiotlb_bounced",
                "kind": "tracepoint",
                "id_path": "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/id",
                "format_path": FMT_PATH,
                "format_text": fmt_text,
                "note": (
                    "Exact tracepoint format bytes recorded during "
                    "qualification; admission requires byte-equality."
                ),
            }
        ],
        "capabilities": [
            {
                "id": "attempt-trace",
                "status": attempt,
                "hooks": ["swiotlb:swiotlb_bounced"],
                "reason": (
                    "Supported on this exact kernel when the VM-gate "
                    "live cross-check holds; the narrow bindings "
                    "refuse every other identity."
                ),
            },
            {
                "id": "mapping-lifecycle",
                "status": "unsupported",
                "hooks": [],
                "reason": "No validated lifecycle mechanism exists.",
            },
            {
                "id": "copy-actual",
                "status": "unsupported",
                "hooks": [],
                "reason": "No validated executed-length source exists.",
            },
        ],
        "notes": [
            "Generated by tools/emit-gate-profiles from dumped guest identity.",
            "Distro patch set, kernel config, and BTF build are pinned by hash in the narrow bindings.",
        ],
    }


def main() -> int:
    if len(sys.argv) != 3:
        print(
            "usage: emit-gate-profiles IDENTITY_JSON LIVE_FORMAT",
            file=sys.stderr,
        )
        return 2
    ident = json.loads(Path(sys.argv[1]).read_text())
    fmt_text = Path(sys.argv[2]).read_text()
    for key in (
        "release",
        "config_src",
        "config_sha",
        "btf_sha",
        "format_sha",
        "image_sha",
        "image_bid",
    ):
        if not ident.get(key):
            print(f"identity lacks {key}", file=sys.stderr)
            return 1
    if hashlib.sha256(fmt_text.encode()).hexdigest() != ident["format_sha"]:
        print("format text does not match format_sha", file=sys.stderr)
        return 1
    bind = {
        "config": ident["config_sha"],
        "config_src": ident["config_src"],
        "btf": ident["btf_sha"],
        "format": ident["format_sha"],
        "object": sha(PROD_OBJ),
        "image": ident["image_sha"],
        "image_bid": ident["image_bid"],
        "ring": "8388608",
    }
    DOC.write_text(
        json.dumps(
            doc_for(
                "linux-x86_64-7.0.0-34-generic",
                "reference-unvalidated",
                ident["release"],
                note_for(bind),
                fmt_text,
                "supported",
            ),
            indent=2,
        )
        + "\n"
    )
    SAT.parent.mkdir(parents=True, exist_ok=True)
    SAT.write_text(
        json.dumps(
            doc_for(
                "saturation-candidate",
                "reference-unvalidated",
                ident["release"],
                note_for(
                    {**bind, "object": sha(SAT_OBJ), "ring": "4096"}
                ),
                fmt_text,
                "candidate",
            ),
            indent=2,
        )
        + "\n"
    )
    print(f"wrote {DOC.relative_to(ROOT)}")
    print(f"wrote {SAT.relative_to(ROOT)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

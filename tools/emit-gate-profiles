#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Author the gate profile docs from dumped guest identity.

Inputs: guest identity JSON (release, config_src, config/btf/
format/image shas, image bid) plus the live format text, plus
the production, saturation, lifecycle, and copy objects
(the current builds, or explicit inputs a sealed leg
resolves under its verified root), plus an explicit output
path.
Outputs:
  the named gate doc (schema 0.1.2
    with the built objects' CO-RE layouts; reference-
    unvalidated until the promotion commit flips ONLY the
    status line; tracing caps supported with frozen hooks
    and current lc/cp bindings)

The tracing transform is the record3 minter's shared
implementation, so re-mints cannot drift from the qualified
lanes. gate_docs is also the transform tests/vm/gate_kernel.py
uses to mint the gate and saturation-candidate profiles for
the running kernel on every armed VM run. Re-running after a
kernel/producer change produces provisional bindings requiring new live
qualification; generation itself never qualifies them. The gate enforces
the checked-in values.
"""
import hashlib
import importlib.util
import json
import subprocess
import sys
from importlib.machinery import SourceFileLoader
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PROD_OBJ = ROOT / "build/bpf/swiotlb_attempt.bpf.o"
SAT_OBJ = ROOT / "build/bpf/swiotlb_attempt-test.bpf.o"
LC_OBJ = ROOT / "build/bpf/swiotlb_lifecycle.bpf.o"
CP_OBJ = ROOT / "build/bpf/swiotlb_copy.bpf.o"
LAYOUTS_TOOL = ROOT / "tools/emit-core-layouts"
MINTER = ROOT / "tests/vm/mint_record3_profile.py"
FMT_PATH = "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format"
LC_REASON = (
    "Supported on this exact kernel: lifecycle collection "
    "qualified by VM-gate lanes; narrow bindings refuse every "
    "other identity."
)
CP_REASON = (
    "Supported on this exact kernel: executed-copy collection "
    "qualified by VM-gate lanes; narrow bindings refuse every "
    "other identity."
)
HOOK_NOTE = "Frozen tracing hook; admission requires the exact signature."


def minter():
    loader = SourceFileLoader("gate_profile_minter", str(MINTER))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


def sha(path) -> str:
    return hashlib.sha256(Path(path).read_bytes()).hexdigest()


def note_for(b: dict) -> str:
    note = " ".join(
        [
            f"config=sha256:{b['config']}",
            f"config_src={b['config_src']}",
            f"btf=sha256:{b['btf']}",
            f"format=sha256:{b['format']}",
            f"object=sha256:{b['object']}",
            f"image=sha256:{b['image']}",
            f"image_bid={b['image_bid']}",
            f"ring_bytes={b['ring']}",
        ]
    )
    assert len(note) <= 512, "note exceeds 512"
    return note


def doc_for(
    pid: str, status: str, rev: str, note: str, fmt_text: str, attempt: str
) -> dict:
    return {
        "schema_version": "0.1.1",
        "profile_id": pid,
        "status": status,
        "identity": {
            "arch": "x86_64",
            "min_kernel": "7.0.0",
            "source": {"origin": "distro", "revision": rev, "note": note},
            "note": (
                "Narrow identity for the qualified gate kernel. The "
                "bindings name the exact config, BTF, tracepoint "
                "format, object, image, and build-id qualified by "
                "the live cross-check; any change fails admission "
                "until re-qualification."
            ),
        },
        "hooks": [
            {
                "name": "swiotlb:swiotlb_bounced",
                "kind": "tracepoint",
                "id_path": "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/id",
                "format_path": FMT_PATH,
                "format_text": fmt_text,
                "note": (
                    "Exact tracepoint format bytes recorded during "
                    "qualification; admission requires byte-equality."
                ),
            }
        ],
        "capabilities": [
            {
                "id": "attempt-trace",
                "status": attempt,
                "hooks": ["swiotlb:swiotlb_bounced"],
                "reason": (
                    "Supported on this exact kernel when the VM-gate "
                    "live cross-check holds; the narrow bindings "
                    "refuse every other identity."
                ),
            },
            {
                "id": "mapping-lifecycle",
                "status": "unsupported",
                "hooks": [],
                "reason": "No validated lifecycle mechanism exists.",
            },
            {
                "id": "copy-actual",
                "status": "unsupported",
                "hooks": [],
                "reason": "No validated executed-length source exists.",
            },
        ],
        "notes": [
            "Generated by tools/emit-gate-profiles from dumped guest identity.",
            "Distro patch set, kernel config, and BTF build are pinned by hash in the narrow bindings.",
        ],
    }


DEV_OBJECTS = {
    "attempt": PROD_OBJ,
    "saturation": SAT_OBJ,
    "lc": LC_OBJ,
    "cp": CP_OBJ,
}

ATTEMPT_RING_VAR = "mv_attempts"


def resolve_objects(objects) -> dict:
    """Object inputs keyed by channel, defaulting to the builds.

    An explicit mapping must name every channel: a sealed
    leg that forgot one would otherwise silently bind a
    build-tree object.
    """
    if objects is None:
        return dict(DEV_OBJECTS)
    missing = [key for key in DEV_OBJECTS if key not in objects]
    if missing:
        raise ValueError(
            "gate objects lack channels: %s" % ", ".join(missing))
    return {key: objects[key] for key in DEV_OBJECTS}


def core_layouts(objects=None) -> list:
    """0.1.2 layouts from the inputs' CO-RE set."""
    resolved = resolve_objects(objects)
    proc = subprocess.run(
        [sys.executable, str(LAYOUTS_TOOL),
         "--object", "attempt-trace=%s" % resolved["attempt"],
         "--object", "mapping-lifecycle=%s" % resolved["lc"],
         "--object", "copy-actual=%s" % resolved["cp"],
         "--print"],
        capture_output=True, text=True)
    if proc.returncode != 0:
        raise ValueError(
            "layout extraction failed: %s" % proc.stderr.strip())
    return json.loads(proc.stdout)


def gate_docs(ident: dict, fmt_text: str, gate_id: str,
              objects=None) -> tuple:
    """Gate and saturation docs for one measured identity.

    objects names the attempt, saturation, lifecycle, and
    copy inputs; without it the current builds apply. Ring
    bindings are parsed from those same inputs, so a sealed
    leg binds its verified bytes end to end.
    """
    for key in (
        "release",
        "config_src",
        "config_sha",
        "btf_sha",
        "format_sha",
        "image_sha",
        "image_bid",
    ):
        if not ident.get(key):
            raise ValueError(f"identity lacks {key}")
    if hashlib.sha256(fmt_text.encode()).hexdigest() != ident["format_sha"]:
        raise ValueError("format text does not match format_sha")
    resolved = resolve_objects(objects)
    mint = minter()
    bind = {
        "config": ident["config_sha"],
        "config_src": ident["config_src"],
        "btf": ident["btf_sha"],
        "format": ident["format_sha"],
        "object": sha(resolved["attempt"]),
        "image": ident["image_sha"],
        "image_bid": ident["image_bid"],
        "ring": str(mint.btf_ring_bytes(
            resolved["attempt"], ATTEMPT_RING_VAR)),
    }
    gate = doc_for(
        gate_id,
        "reference-unvalidated",
        ident["release"],
        note_for(bind),
        fmt_text,
        "supported",
    )
    mint.apply_tracing(
        gate, resolved["lc"], resolved["cp"],
        LC_REASON, CP_REASON, HOOK_NOTE
    )
    # The gate doc carries the objects' CO-RE layouts, so a
    # re-emit reproduives the shipped narrow profile exactly.
    gate["layouts"] = core_layouts(resolved)
    gate["schema_version"] = "0.1.2"
    sat = doc_for(
        "saturation-candidate",
        "reference-unvalidated",
        ident["release"],
        note_for({**bind,
                  "object": sha(resolved["saturation"]),
                  "ring": str(mint.btf_ring_bytes(
                      resolved["saturation"],
                      ATTEMPT_RING_VAR))}),
        fmt_text,
        "candidate",
    )
    return gate, sat


def main() -> int:
    if len(sys.argv) != 4:
        print(
            "usage: emit-gate-profiles IDENTITY_JSON "
            "LIVE_FORMAT OUT_PATH",
            file=sys.stderr,
        )
        return 2
    ident = json.loads(Path(sys.argv[1]).read_text())
    fmt_text = Path(sys.argv[2]).read_text()
    out = Path(sys.argv[3])
    try:
        gate, _ = gate_docs(
            ident, fmt_text,
            "linux-x86_64-" + ident["release"]
        )
    except ValueError as exc:
        print(exc, file=sys.stderr)
        return 1
    except KeyError:
        print("identity lacks release", file=sys.stderr)
        return 1
    out.write_text(json.dumps(gate, indent=2) + "\n")
    try:
        shown = out.relative_to(ROOT)
    except ValueError:
        shown = out
    print(f"wrote {shown}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

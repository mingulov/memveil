"""Generate qualify-plan fixtures (host root + candidate docs).

The host root under tests/fixtures/qualify/host/ copies the
scan ok/ identity tree with the BTF file replaced by the
funcproto.bin fixture (holding FUNC test_fn), so signature
checks run against known bytes; host-arm/ is the same tree
reporting aarch64 for no-coverage tests, and host-old/ is
the same tree reporting 5.15.0-test for floor tests. Profiles under
tests/fixtures/qualify/profiles/ carry section 5 grammar
bindings computed from the CURRENT host bytes:
  qual-ref.json      reference-unvalidated, matching note,
                     tracing hook fentry:test_fn.
  qual-unbound.json  reference-unvalidated, free-text note.
  qual-badsig.json   same note, one-byte signature skew.
  qual-nofunc.json   same note, unknown function nope.
  qual-nohook.json   same note, no hooks at all.
Manifest lists qual-ref.json only; tests address the rest
by path. Requires tests/fixtures/scan/ok (run
tools/emit-scan-fixtures first). All hashes are recomputed
here, so editing any input regenerates consistent bindings.
"""
import hashlib
import json
import shutil
import struct
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
SCAN_OK = ROOT / "tests/fixtures/scan/ok"
FUNC_BIN = ROOT / "tests/fixtures/btf/funcproto.bin"
LAYOUT = ROOT / "tests/fixtures/layout/ok.format"
ELF_OK = ROOT / "tests/fixtures/elf/ok.o"
QUAL = ROOT / "tests/fixtures/qualify"
REL = "7.0.0-test"
FMT_PATH = "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/format"
TRACE_HOOK = {
    "name": "swiotlb:swiotlb_bounced",
    "kind": "tracepoint",
    "id_path": "/sys/kernel/tracing/events/swiotlb/swiotlb_bounced/id",
    "format_path": FMT_PATH,
    "format_text": None,  # filled from LAYOUT at emit time
    "note": "Qualify-fixture hook.",
}


def sha(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def gunzip_first(path: Path) -> bytes:
    import gzip

    raw = path.read_bytes()
    if raw[:2] == b"\x1f\x8b":
        with gzip.open(path, "rb") as fh:
            return fh.read()
    return raw


def parse_bid(notes_path: Path) -> str:
    data = notes_path.read_bytes()
    pos = 0
    while pos + 12 <= len(data):
        namesz, descsz, ntype = struct.unpack_from("<III", data, pos)
        pos += 12
        name_end = pos + ((namesz + 3) // 4) * 4
        is_gnu = (
            ntype == 3
            and namesz == 4
            and data[pos : pos + 4] == b"GNU\x00"
        )
        pos = name_end
        desc_end = pos + ((descsz + 3) // 4) * 4
        if is_gnu:
            return data[pos : pos + descsz].hex()
        pos = desc_end
    raise AssertionError("no GNU build id in notes")


def note_for(bind: dict) -> str:
    note = " ".join(
        [
            f"config=sha256:{bind['config']}",
            f"config_src={bind['config_src']}",
            f"btf=sha256:{bind['btf']}",
            f"format=sha256:{bind['format']}",
            f"object=sha256:{bind['object']}",
            f"image=sha256:{bind['image']}",
            f"image_bid={bind['image_bid']}",
            f"ring_bytes={bind['ring']}",
        ]
    )
    assert len(note) <= 1024, "note exceeds 1024"
    return note


def tracing_hook(function: str, signature: str) -> dict:
    return {
        "name": f"fentry:{function}",
        "kind": "tracing",
        "function": function,
        "attach": "fentry",
        "signature": signature,
        "note": "Qualify-fixture hook.",
    }


def profile_doc(pid: str, note: str, hooks: list) -> dict:
    return {
        "schema_version": "0.1.1",
        "profile_id": pid,
        "status": "reference-unvalidated",
        "identity": {
            "arch": "x86_64",
            "min_kernel": "7.0",
            "source": {"origin": "test", "revision": REL, "note": note},
            "note": "Qualify-fixture identity; never ship.",
        },
        "hooks": hooks,
        "capabilities": [
            {
                "id": "attempt-trace",
                "status": "candidate",
                "hooks": ["swiotlb:swiotlb_bounced"],
                "reason": "Qualify fixture.",
            },
            {
                "id": "mapping-lifecycle",
                "status": "candidate",
                "hooks": ["fentry:test_fn"],
                "reason": "Qualify fixture.",
            },
            {
                "id": "copy-actual",
                "status": "unsupported",
                "hooks": [],
                "reason": "Qualify fixture.",
            },
        ],
        "notes": ["Qualify fixture; regenerated by tools/emit-qualify-fixtures."],
    }


def main() -> int:
    for need in [SCAN_OK, FUNC_BIN, LAYOUT, ELF_OK]:
        if not need.exists():
            print(f"missing {need}", file=sys.stderr)
            return 1
    host = QUAL / "host"
    if host.exists():
        shutil.rmtree(host)
    shutil.copytree(SCAN_OK, host)
    shutil.copy(FUNC_BIN, host / "sys/kernel/btf/vmlinux")
    arm = QUAL / "host-arm"
    if arm.exists():
        shutil.rmtree(arm)
    shutil.copytree(host, arm)
    (arm / "meta.txt").write_text(f"arch=aarch64\nrelease={REL}\neuid=0\n")
    old = QUAL / "host-old"
    if old.exists():
        shutil.rmtree(old)
    shutil.copytree(host, old)
    (old / "meta.txt").write_text("arch=x86_64\nrelease=5.15.0-test\neuid=0\n")
    bind = {
        "config": hashlib.sha256(
            gunzip_first(host / "proc/config.gz")
        ).hexdigest(),
        "config_src": "gz",
        "btf": sha(host / "sys/kernel/btf/vmlinux"),
        "format": sha(host / FMT_PATH.lstrip("/")),
        "object": sha(ELF_OK),
        "image": sha(host / f"boot/vmlinuz-{REL}"),
        "image_bid": parse_bid(host / "sys/kernel/notes"),
        "ring": "8388608",
    }
    hook = dict(TRACE_HOOK)
    hook["format_text"] = LAYOUT.read_text()
    good_sig = "int test_fn(struct device *dev, size_t size)"
    prof = QUAL / "profiles"
    prof.mkdir(parents=True, exist_ok=True)
    note = note_for(bind)
    (prof / "qual-ref.json").write_text(
        json.dumps(
            profile_doc(
                "qual-ref",
                note,
                [hook, tracing_hook("test_fn", good_sig)],
            ),
            indent=2,
        )
        + "\n"
    )
    (prof / "qual-unbound.json").write_text(
        json.dumps(
            profile_doc(
                "qual-unbound",
                "Free text: no grammar bindings here.",
                [hook, tracing_hook("test_fn", good_sig)],
            ),
            indent=2,
        )
        + "\n"
    )
    (prof / "qual-badsig.json").write_text(
        json.dumps(
            profile_doc(
                "qual-badsig",
                note,
                [
                    hook,
                    tracing_hook(
                        "test_fn",
                        "int test_fn(struct device *dev, size_t length)",
                    ),
                ],
            ),
            indent=2,
        )
        + "\n"
    )
    nofunc = profile_doc(
        "qual-nofunc",
        note,
        [hook, tracing_hook("nope", "int nope(int x)")],
    )
    for cap in nofunc["capabilities"]:
        if cap["id"] == "mapping-lifecycle":
            cap["hooks"] = ["fentry:nope"]
    (prof / "qual-nofunc.json").write_text(
        json.dumps(nofunc, indent=2) + "\n"
    )
    nohook = profile_doc("qual-nohook", note, [])
    for cap in nohook["capabilities"]:
        cap["hooks"] = []
    (prof / "qual-nohook.json").write_text(
        json.dumps(nohook, indent=2) + "\n"
    )
    (prof / "manifest.txt").write_text("qual-ref.json\n")
    print(f"wrote qualify fixtures to {QUAL}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

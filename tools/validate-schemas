        check_text(ident["note"], 512, "profile.identity.note",
                   allow_empty=True)
    hooks = obj["hooks"]
    if not isinstance(hooks, list) or len(hooks) > 32:
        fail("bad-type", "profile.hooks")
    names = set()
    for hook in hooks:
        check_keys(hook, ("name", "kind", "id_path", "format_path"),
                   ("format_text", "note"), "profile.hooks[]")
        check_text(hook["name"], 128, "profile.hooks[].name")
        if hook["name"] in names:
            fail("duplicate-key", "profile hook %r" % hook["name"])
        names.add(hook["name"])
        if hook["kind"] != "tracepoint":
            fail("bad-enum", "profile.hooks[].kind")
        check_text(hook["id_path"], 256, "profile.hooks[].id_path")
        if not HOOK_PATH_RE.fullmatch(hook["id_path"]):
            fail("bad-path", "profile.hooks[].id_path not canonical")
        check_text(hook["format_path"], 256, "profile.hooks[].format_path")
        if not HOOK_PATH_RE.fullmatch(hook["format_path"]):
            fail("bad-path", "profile.hooks[].format_path not canonical")
        if "format_text" in hook and hook["format_text"] is not None:
            check_text(hook["format_text"], 65536,
                       "profile.hooks[].format_text", allow_empty=True)
        if "note" in hook:
            check_text(hook["note"], 512, "profile.hooks[].note",
                       allow_empty=True)
    caps = obj["capabilities"]
    if not isinstance(caps, list) or len(caps) > 16:
        fail("bad-type", "profile.capabilities")
    seen = set()
    for cap in caps:
        check_keys(cap, ("id", "status", "hooks", "reason"), (),
                   "profile.capabilities[]")
        check_enum(cap["id"], PROFILE_CAPABILITIES,
                   "profile.capabilities[].id")
        if cap["id"] in seen:
            fail("duplicate-key", "profile capability %r" % cap["id"])
        seen.add(cap["id"])
        check_enum(cap["status"], ("candidate", "supported", "unsupported"),
                   "profile.capabilities[].status")
        if not isinstance(cap["hooks"], list) or len(cap["hooks"]) > 32:
            fail("bad-type", "profile.capabilities[].hooks")
        for name in cap["hooks"]:
            check_text(name, 128, "profile.capabilities[].hooks[]")
            if name not in names:
                fail("unknown-hook", "capability hook %r" % name)
        check_text(cap["reason"], 512, "profile.capabilities[].reason",
                   allow_empty=True)
    if "notes" in obj:
        if not isinstance(obj["notes"], list) or len(obj["notes"]) > 32:
            fail("bad-type", "profile.notes")
        for note in obj["notes"]:
            check_text(note, 512, "profile.notes[]", allow_empty=True)
    return obj



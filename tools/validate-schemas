def main(argv):
    if len(argv) == 2 and argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if len(argv) == 3 and argv[1] == "--check-profile":
        try:
            check_profile(read_json_file(argv[2], argv[2]))
        except Error as exc:
            print("invalid: %s" % exc)
            return 1
        print("profile OK: %s" % argv[2])
        return 0
    if len(argv) == 3 and argv[1] == "--check-doctor":
        try:
            check_doctor(read_json_file(argv[2], argv[2]))
        except Error as exc:
            print("invalid: %s" % exc)
            return 1
        print("doctor report OK: %s" % argv[2])
        return 0
    if len(argv) == 1:
        results = run_selftest()
        failed = 0
        for passed, message in results:
            print(("ok " if passed else "FAIL ") + message)
            if not passed:
                failed += 1
        print("%d passed, %d failed, %d total"
              % (len(results) - failed, failed, len(results)))
        return 1 if failed else 0
    if len(argv) == 2:
        try:
            session, summary = validate_capture(argv[1])
        except Error as exc:
            print("invalid: %s" % exc)
            return 1
        report_path = os.path.join(argv[1], "report.json")
        if os.path.isfile(report_path):
            try:
                compare_report(report_path, session, summary)
            except Error as exc:
                print("report mismatch: %s" % exc)
                return 1
        print("capture OK: %d events, %d attempts, %d requested bytes"
              % (summary["count"], summary["attempts"],
                 summary["requested"]))
        return 0
    print("usage: tools/validate-schemas [CAPTURE_DIR]", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))

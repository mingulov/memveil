def compare_report_obj(obj, session, summary):
    check_keys(obj,
               ("schema_version", "session_id", "synthetic",
                "engine_version", "environment", "device_catalog",
                "quality", "metrics", "findings", "limitations"), (),
               "report")
    if obj["schema_version"] != VERSION:
        fail("bad-version", "report schema_version")
    if obj["session_id"] != session["id"]:
        fail("session-mismatch", "report session reference")
    if not isinstance(obj["synthetic"], bool):
        fail("bad-type", "report synthetic must be a boolean")
    if obj["synthetic"] != session["synthetic"]:
        fail("provenance-lost", "report synthetic flag differs")
    check_text(obj["engine_version"], 64, "engine_version")
    check_environment(obj["environment"], "report.environment")
    if obj["environment"] != session["environment"]:
        fail("environment-mismatch",
             "report environment differs from session")
    check_device_catalog(obj["device_catalog"], "report.device_catalog")
    if obj["device_catalog"] != session["catalog"]:
        fail("catalog-mismatch",
             "report device catalog differs from session")
    check_quality(obj["quality"], "report.quality")
    metrics = obj["metrics"]
    if not isinstance(metrics, list) or len(metrics) > 4096:
        fail("bad-type", "report.metrics")
    found = {}
    for metric in metrics:
        check_keys(metric,
                   ("name", "value", "unit", "measurement", "coverage",
                    "confidence", "aggregation", "sample_count",
                    "dimensions", "scope", "notes"), (), "metric")
        check_text(metric["name"], 128, "metric.name")
        if metric["value"] is not None:
            check_u64(metric["value"], "metric.value")
        elif metric["measurement"] != "unavailable":
            fail("null-without-unavailable",
                 "metric %s is null but %s"
                 % (metric["name"], metric["measurement"]))
        check_text(metric["unit"], 32, "metric.unit")
        check_enum(metric["measurement"],
                   ("observed", "derived", "estimated", "unavailable"),
                   "metric.measurement")
        check_enum(metric["coverage"],
                   ("complete_for_scope", "partial", "unavailable",
                    "not_applicable"), "metric.coverage")
        check_enum(metric["confidence"],
                   ("high", "medium", "proxy"), "metric.confidence")
        if metric["aggregation"] is not None:
            check_enum(metric["aggregation"],
                       ("counter", "gauge", "mean", "p50", "p95", "p99"),
                       "metric.aggregation")
        if metric["sample_count"] is not None:
            check_u64(metric["sample_count"], "metric.sample_count")
        if (metric["name"] in METRIC_UNITS
                and metric["unit"] != METRIC_UNITS[metric["name"]]):
            fail("wrong-unit", "metric %s uses unit %r"
                 % (metric["name"], metric["unit"]))
        if metric["value"] is not None and metric["aggregation"] is None:
            fail("missing-aggregation",
                 "metric %s has a value without aggregation"
                 % metric["name"])
        if metric["value"] is None and metric["aggregation"] is not None:
            fail("unexpected-aggregation",
                 "metric %s is null with aggregation %r"
                 % (metric["name"], metric["aggregation"]))
        if metric["value"] is None and metric["coverage"] not in (
                "unavailable", "not_applicable"):
            fail("wrong-coverage",
                 "null metric %s claims coverage %r"
                 % (metric["name"], metric["coverage"]))
        if (metric["value"] is not None
                and metric["coverage"] == "complete_for_scope"
                and session["quality"]["detail"]["status"]
                != "complete_for_scope"):
            fail("wrong-coverage",
                 "metric %s claims complete scope with %s detail channel"
                 % (metric["name"],
                    session["quality"]["detail"]["status"]))
        dimensions = metric["dimensions"]
        check_keys(dimensions, ("device_id", "pool_id"), (),
                   "metric.dimensions")
        for dim in ("device_id", "pool_id"):
            if dimensions[dim] is not None:
                check_id(dimensions[dim], "metric.dimensions.%s" % dim)
        if (dimensions["device_id"] is not None
                and dimensions["device_id"] not in session["devices"]):
            fail("unknown-device", "metric for unknown device %s"
                 % dimensions["device_id"])
        if (dimensions["pool_id"] is not None
                and dimensions["pool_id"] not in summary["pools"]):
            fail("unknown-pool", "metric for unobserved pool %s"
                 % dimensions["pool_id"])
        check_text(metric["scope"], 256, "metric.scope")
        check_text(metric["notes"], 1024, "metric.notes", allow_empty=True)
        key = (metric["name"], dimensions["device_id"],
               dimensions["pool_id"])
        if key in found:
            fail("duplicate-id", "metric %s repeats" % (key,))
        found[key] = metric
    expected = {("bounce_attempts", None, None):
                str(summary["attempts"]),
                ("requested_bounce_bytes", None, None):
                    str(summary["requested"])}
    detailed_ids = sorted(summary["per_device"])[:MAX_DETAILED_DEVICES]
    for device in detailed_ids:
        count, total = summary["per_device"][device]
        expected[("bounce_attempts", device, None)] = str(count)
        expected[("requested_bounce_bytes", device, None)] = str(total)
    for key, value in expected.items():
        metric = found.get(key)
        if metric is None:
            fail("missing-metric", "report lacks %s" % (key,))
        if metric["value"] != value:
            fail("wrong-metric", "%s is %r, recomputed %s"
                 % (key, metric["value"], value))
        if metric["measurement"] != "observed":
            fail("wrong-metric", "%s measurement is %r"
                 % (key, metric["measurement"]))
        if metric["aggregation"] != "counter":
            fail("wrong-metric", "%s aggregation is %r"
                 % (key, metric["aggregation"]))
    for name, sources in METRIC_SOURCES.items():
        if set(sources) & summary["kinds"]:
            continue
        if (name in BASELINE_SOURCED_METRICS
                and session.get("baseline_observations")):
            continue
        metric = found.get((name, None, None))
        if metric is None:
            fail("missing-metric", "report lacks %s" % name)
        if metric["value"] is not None:
            fail("unexpected-value",
                 "%s must be null without %s events"
                 % (name, "/".join(sources)))
    findings = obj["findings"]
    if not isinstance(findings, list) or len(findings) > 2048:
        fail("bad-type", "report.findings")
    for finding in findings:
        check_keys(finding, ("code", "severity", "explanation",
                             "evidence_refs", "scope", "limitations"),
                   (), "finding")
        check_enum(finding["code"],
                   ("CAPTURE_INCOMPLETE", "PROBE_UNAVAILABLE",
                    "UNPAIRED_LIFECYCLE", "CONVERSION_FAILED",
                    "POOL_PRESSURE", "LONG_LIVED_ALLOCATION"),
                   "finding.code")
        check_enum(finding["severity"], ("informational", "warning"),
                   "finding.severity")
        check_text(finding["explanation"], 1024, "finding.explanation")
        refs = finding["evidence_refs"]
        if not isinstance(refs, list) or len(refs) > 32:
            fail("bad-type", "finding.evidence_refs")
        for ref in refs:
            check_text(ref, 256, "finding.evidence_refs[]")
        check_text(finding["scope"], 256, "finding.scope")
        check_text(finding["limitations"], 1024, "finding.limitations",
                   allow_empty=True)
    limitations = obj["limitations"]
    if not isinstance(limitations, list) or len(limitations) > 256:
        fail("bad-type", "report.limitations")
    for limitation in limitations:
        check_text(limitation, 1024, "limitation")
    n_withheld = len(summary["per_device"]) - len(detailed_ids)
    if n_withheld > 0:
        if n_withheld == 1:
            noun = "device lacks detail rows:"
        else:
            noun = "devices lack detail rows:"
        want = "%d %s metric budget exhausted." % (n_withheld, noun)
        if want not in limitations:
            fail("missing-note", "report lacks %r" % want)
        for device in sorted(summary["per_device"])[MAX_DETAILED_DEVICES:]:
            for name in ("bounce_attempts", "requested_bounce_bytes"):
                if (name, device, None) in found:
                    fail("unexpected-metric",
                         "withheld device %s keeps %s rows" % (device, name))
    else:
        for limitation in limitations:
            if "lack detail rows" in limitation:
                fail("unexpected-note", "report notes %r" % limitation)
    return summary



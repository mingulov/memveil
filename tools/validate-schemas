MIN_KERNEL_RE = re.compile(r"[0-9]+\.[0-9]+(\.[0-9]+)?")
_HOOK_SEG = r"([^\x00/.][^\x00/]*|\.[^\x00/.][^\x00/]*|\.\.[^\x00/]+)"
HOOK_PATH_RE = re.compile(r"/" + _HOOK_SEG + r"(/" + _HOOK_SEG + r")*")


def check_profile(obj):
    check_keys(obj, ("schema_version", "profile_id", "status", "identity",
                     "hooks", "capabilities"), ("notes",), "profile")

def repo_path(*parts):
    root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    return os.path.join(root, *parts)


def expect_reject(label, func, reason_part):
    try:
        func()
    except Error as exc:
        if reason_part not in exc.reason:
            return (False, "%s rejected with %s, wanted %s"
                    % (label, exc.reason, reason_part))
        return (True, "%s rejected (%s)" % (label, exc.reason))
    except Exception as exc:  # noqa: BLE001 - a crash is not a rejection
        return (False, "%s raised %r" % (label, exc))
    return (False, "%s was accepted" % label)


def run_selftest():
    results = []

    def check(label, func):
        try:
            detail = func()
        except Error as exc:
            results.append((False, "%s: %s" % (label, exc)))
        except Exception as exc:  # noqa: BLE001 - report, do not crash
            results.append((False, "%s: unexpected %r" % (label, exc)))
        else:
            results.append((True, "%s: %s" % (label, detail or "ok")))

    schemas = ("session-v0.1.0.schema.json", "event-v0.1.0.schema.json",
               "report-v0.1.0.schema.json", "profile-v0.1.0.schema.json",
               "doctor-v0.1.0.schema.json")

    def schema_files():
        for name in schemas:
            path = repo_path("schemas", name)
            with open(path, "r", encoding="utf-8") as handle:
                obj = json.load(handle, object_pairs_hook=_no_dupes)
            want = "https://json-schema.org/draft/2020-12/schema"
            if obj.get("$schema") != want:
                fail("bad-schema", "%s $schema" % name)
            if obj.get("$id") != name:
                fail("bad-schema", "%s $id" % name)
        return "%d schema files declare draft 2020-12" % len(schemas)

    check("schema-files", schema_files)

    def profile_reference():
        obj = read_json_file(
            repo_path("profiles", "linux-x86_64-7.0-reference.json"),
            "reference profile")
        check_profile(obj)
        if obj["status"] == "validated":
            fail("bad-enum", "reference profile must not be validated")
        return "unvalidated reference accepted"

    check("profile-reference", profile_reference)

    def profile_reject_unknown_hook():
        obj = read_json_file(

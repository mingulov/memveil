"""Validate MemVeil captures against the versioned external schemas.

Modes:
  tools/validate-schemas          run the built-in acceptance suite
  tools/validate-schemas DIR      validate one capture directory
  tools/validate-schemas --check-profile FILE
                                  validate one semantic profile document
  tools/validate-schemas --check-doctor FILE
                                  validate one doctor JSON report

Strict producer validation: canonical integers with range checks, required
fields, size/depth bounds enforced before unbounded parsing, and
cross-record rules (session match, increasing sequence, window membership,
identity resolution and uniqueness). Exit 0 on success, 1 on failure.

Only the attempts slice is independently recomputed; lifecycle, region, and
pool metrics need their own checks once captures carry those events.
Mapping references must resolve within the capture in this strict mode;
partial-capture recovery belongs to the product reader, not this tool.

Python standard library only.
"""

import copy
import json
import os
import re
import sys

VERSION = "0.1.0"
U64MAX = 18446744073709551615
U64RE = re.compile(r"(0|[1-9][0-9]{0,19})")
IDRE = re.compile(r"[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}")
MAX_LINE = 65536
MAX_FILE = 16777216
MAX_DEPTH = 64
MAX_DEVICES = 4096
# Devices with per-device detail rows: 2 global rows + 2 rows per
# device + the 9-row fixed tail + 2 reserved counter rows must fit
# the frozen 4096-metric budget. Further devices keep exact global
# accounting; only their per-device rows are withheld with a
# limitation note (analyzer R4D4 withholding rule).
MAX_DETAILED_DEVICES = (4096 - 2 - 9 - 2) // 2

CAPABILITIES = ("bounce_attempts", "mapping_lifecycle", "copy_bytes",
                "sync_requests", "conversion_results", "region_state",
                "pool_stats", "task_context")
CHANNELS = ("detail", "aggregate", "correlation", "baseline", "terminal")
KINDS = ("bounce_attempt", "map_result", "unmap", "copy", "sync_request",
         "transition_result", "pool_sample", "gap", "marker",
         "counter_snapshot")


class Error(Exception):
    def __init__(self, reason, detail):
        super().__init__("%s: %s" % (reason, detail))
        self.reason = reason
        self.detail = detail


def fail(reason, detail):
    raise Error(reason, detail)


def check_u64(value, where):
    if not isinstance(value, str):
        fail("u64-type", "%s must be a decimal string, got %s"
             % (where, type(value).__name__))
    if not U64RE.fullmatch(value):
        fail("u64-canonical", "%s is not canonical: %r" % (where, value))
    number = int(value)
    if number > U64MAX:
        fail("u64-range", "%s exceeds u64: %s" % (where, value))
    return number


def check_id(value, where):
    if not isinstance(value, str) or not IDRE.fullmatch(value):
        fail("bad-id", "%s is not an opaque id: %r" % (where, value))
    return value


def check_enum(value, allowed, where):
    if value not in allowed:
        fail("bad-enum", "%s must be one of %s, got %r"
             % (where, sorted(a for a in allowed if a is not None), value))
    return value


def check_text(value, max_len, where, allow_empty=False):
    if not isinstance(value, str):
        fail("bad-type", "%s must be a string" % where)
    if len(value) > max_len:
        fail("too-long", "%s exceeds %d chars" % (where, max_len))
    if not allow_empty and not value:
        fail("empty", "%s must not be empty" % where)
    return value


def check_keys(obj, required, optional, where):
    if not isinstance(obj, dict):
        fail("bad-type", "%s must be an object" % where)
    keys = set(obj)
    missing = set(required) - keys
    if missing:
        fail("missing-required", "%s lacks %s"
             % (where, sorted(missing)))
    unknown = keys - set(required) - set(optional)
    if unknown:
        fail("unknown-field", "%s has unknown fields %s"
             % (where, sorted(unknown)))


def json_depth(text):
    stack = []
    max_depth = 0
    in_string = False
    escaped = False
    closers = {"]": "[", "}": "{"}
    for char in text:
        if in_string:
            if escaped:
                escaped = False
            elif char == "\\":
                escaped = True
            elif char == '"':
                in_string = False
        elif char == '"':
            in_string = True
        elif char == "[" or char == "{":
            stack.append(char)
            if len(stack) > max_depth:
                max_depth = len(stack)
        elif char == "]" or char == "}":
            if not stack or stack.pop() != closers[char]:
                fail("malformed", "mismatched closing bracket")
    if in_string:
        fail("malformed", "unterminated string")
    if stack:
        fail("malformed", "unbalanced brackets")
    return max_depth


def check_depth(text, where):
    depth = json_depth(text)
    if depth > MAX_DEPTH:
        fail("depth-exceeded", "%s nests to depth %d (limit %d)"
             % (where, depth, MAX_DEPTH))
    return depth


def iter_lines(path):
    """Yield (lineno, line bytes without newline); enforce the line bound."""
    lineno = 0
    pending = bytearray()
    with open(path, "rb") as handle:
        while True:
            chunk = handle.read(65536)
            if not chunk:
                break
            start = 0
            while True:
                end = chunk.find(b"\n", start)
                if end < 0:
                    pending += chunk[start:]
                    if len(pending) > MAX_LINE:
                        fail("line-too-long",
                             "%s line %d exceeds %d bytes"
                             % (path, lineno + 1, MAX_LINE))
                    break
                pending += chunk[start:end]
                if len(pending) + 1 > MAX_LINE:
                    fail("line-too-long",
                         "%s line %d exceeds %d bytes"
                         % (path, lineno + 1, MAX_LINE))
                lineno += 1
                yield lineno, bytes(pending)
                pending = bytearray()
                start = end + 1
    if pending:
        fail("truncated-final-line",
             "%s ends without a newline (%d bytes pending)"
             % (path, len(pending)))


def _no_dupes(pairs):
    obj = {}
    for key, value in pairs:
        if key in obj:
            fail("duplicate-key", "duplicate field %r" % (key,))
        obj[key] = value
    return obj


def parse_json(text, what):
    try:
        return json.loads(text, object_pairs_hook=_no_dupes)
    except Error:
        raise
    except json.JSONDecodeError as exc:
        fail("malformed", "%s is not JSON: %s" % (what, exc))


def read_json_file(path, what):
    with open(path, "rb") as handle:
        raw = handle.read(MAX_FILE + 1)
    if len(raw) > MAX_FILE:
        fail("file-too-large", "%s exceeds %d bytes" % (what, MAX_FILE))
    try:
        text = raw.decode("utf-8")
    except UnicodeDecodeError as exc:
        fail("bad-encoding", "%s is not UTF-8: %s" % (what, exc))
    check_depth(text, what)
    return parse_json(text, what)


def check_quality(quality, where):
    check_keys(quality, CHANNELS, (), where)
    for name in CHANNELS:
        channel = quality[name]
        target = "%s.%s" % (where, name)
        check_keys(channel, ("status", "loss_count", "scope", "reason"),
                   ("evidence_refs",), target)
        check_enum(channel["status"],
                   ("complete_for_scope", "partial", "unavailable",
                    "not_applicable"), target + ".status")
        if channel["loss_count"] is not None:
            check_u64(channel["loss_count"], target + ".loss_count")
        check_text(channel["scope"], 256, target + ".scope")
        check_text(channel["reason"], 512, target + ".reason")
        refs = channel.get("evidence_refs", [])
        if not isinstance(refs, list) or len(refs) > 32:
            fail("bad-type", target + ".evidence_refs")
        for ref in refs:
            check_text(ref, 256, target + ".evidence_refs[]")


def check_device_catalog(catalog, where):
    check_keys(catalog, ("devices",), (), where)
    devices = catalog["devices"]
    if not isinstance(devices, list) or len(devices) > MAX_DEVICES:
        fail("bad-type", "%s.devices" % where)
    seen = set()
    for device in devices:
        check_keys(device, ("device_id", "name", "identity_status"),
                   ("driver",), "%s.devices[]" % where)
        device_id = check_id(device["device_id"],
                             "%s.devices[].device_id" % where)
        if device_id in seen:
            fail("duplicate-id", "device %s listed twice" % device_id)
        seen.add(device_id)
        check_text(device["name"], 256, "device name", allow_empty=True)
        check_enum(device["identity_status"],
                   ("resolved", "unresolved", "exhausted"),
                   "device identity_status")
        if device.get("driver") is not None:
            check_text(device["driver"], 128, "device driver")
    return seen


def check_environment(environment, where):
    check_keys(environment, ("mode", "detection", "attestation", "evidence"),
               ("asserted_mode",), where)
    check_enum(environment["mode"],
               ("none", "sev", "sev_es", "sev_snp", "tdx", "unknown"),
               "%s.mode" % where)
    check_enum(environment["detection"],
               ("kernel_reported", "unverified", "conflicting"),
               "%s.detection" % where)
    if environment.get("asserted_mode") is not None:
        check_enum(environment["asserted_mode"],
                   ("none", "sev", "sev_es", "sev_snp", "tdx", "unknown"),
                   "%s.asserted_mode" % where)
    check_enum(environment["attestation"],
               ("not_performed", "external_verified", "failed"),
               "%s.attestation" % where)
    evidence = environment["evidence"]
    if not isinstance(evidence, list) or len(evidence) > 64:
        fail("bad-type", "%s.evidence" % where)
    for item in evidence:
        check_keys(item, ("type", "source", "interpretation"), (),
                   "%s.evidence[]" % where)
        check_text(item["type"], 64, "evidence type")
        check_text(item["source"], 256, "evidence source")
        check_text(item["interpretation"], 1024, "evidence interpretation",
                   allow_empty=True)


def check_session(obj):
    check_keys(obj,
               ("schema_version", "session_id", "synthetic", "product",
                "environment", "capture", "device_catalog", "baseline",
                "capabilities", "quality"),
               ("boot_id",), "session")
    if obj["schema_version"] != VERSION:
        fail("bad-version", "session schema_version %r"
             % (obj["schema_version"],))
    session_id = check_id(obj["session_id"], "session_id")
    if "boot_id" in obj:
        check_id(obj["boot_id"], "boot_id")
    if not isinstance(obj["synthetic"], bool):
        fail("bad-type", "synthetic must be a boolean")
    product = obj["product"]
    check_keys(product, ("name", "version"), ("build",), "product")
    if product["name"] != "memveil":
        fail("bad-product", "product.name %r" % (product["name"],))
    check_text(product["version"], 64, "product.version")
    if product.get("build") is not None:
        check_text(product["build"], 128, "product.build", allow_empty=True)
    check_environment(obj["environment"], "environment")
    capture = obj["capture"]
    check_keys(capture, ("mode", "window", "filters", "finalized"),
               ("end_reason",), "capture")
    check_enum(capture["mode"], ("live", "synthetic"), "capture.mode")
    window = capture["window"]
    check_keys(window, ("start_ns", "end_ns"), ("baseline_start_ns",),
               "window")
    start = check_u64(window["start_ns"], "window.start_ns")
    end = check_u64(window["end_ns"], "window.end_ns")
    if start > end:
        fail("bad-window", "window start exceeds end")
    window_baseline = None
    if "baseline_start_ns" in window:
        window_baseline = check_u64(window["baseline_start_ns"],
                                    "window.baseline_start_ns")
        if window_baseline > start:
            fail("bad-window", "window baseline exceeds start")
    filters = capture["filters"]
    check_keys(filters, (), ("device",), "filters")
    if filters.get("device") is not None:
        check_text(filters["device"], 256, "filters.device")
    if not isinstance(capture["finalized"], bool):
        fail("bad-type", "capture.finalized must be a boolean")
    if capture.get("end_reason") is not None:
        check_enum(capture["end_reason"],
                   ("duration", "size_limit", "signal", "error", "unknown"),
                   "capture.end_reason")
    if obj["synthetic"] != (capture["mode"] == "synthetic"):
        fail("contradictory-provenance",
             "synthetic flag disagrees with capture mode")
    devices = check_device_catalog(obj["device_catalog"], "device_catalog")
    baseline = obj["baseline"]
    check_keys(baseline, ("complete", "region_observations"), (),
               "baseline")
    if not isinstance(baseline["complete"], bool):
        fail("bad-type", "baseline.complete must be a boolean")
    observations = baseline["region_observations"]
    if not isinstance(observations, list) or len(observations) > 4096:
        fail("bad-type", "baseline.region_observations")
    for obs in observations:
        check_keys(obs, ("region_id", "state", "offset", "length",
                         "address_space", "provenance"),
                   ("generation",), "region_observation")
        check_id(obs["region_id"], "region_id")
        check_enum(obs["state"], ("shared", "private", "unknown"),
                   "region state")
        offset = check_u64(obs["offset"], "region offset")
        length = check_u64(obs["length"], "region length")
        if offset + length > U64MAX:
            fail("u64-range", "region end offset overflows")
        check_enum(obs["address_space"],
                   ("guest_physical", "kernel_virtual", "iova",
                    "identity_only"), "region address_space")
        check_text(obs["provenance"], 512, "region provenance")
        if "generation" in obs:
            check_generation(obs["generation"], "region generation")
    capabilities = obj["capabilities"]
    check_keys(capabilities, CAPABILITIES, (), "capabilities")
    for name in CAPABILITIES:
        capability = capabilities[name]
        check_keys(capability, ("status", "reason", "hooks"),
                   ("profile_id",), "capability.%s" % name)
        check_enum(capability["status"],
                   ("verified", "partial", "unavailable", "disabled"),
                   "capability.%s.status" % name)
        check_text(capability["reason"], 512, "capability reason")
        hooks = capability["hooks"]
        if not isinstance(hooks, list) or len(hooks) > 32:
            fail("bad-type", "capability hooks")
        for hook in hooks:
            check_text(hook, 256, "capability hook")
        if capability.get("profile_id") is not None:
            check_text(capability["profile_id"], 128, "profile_id")
    check_quality(obj["quality"], "quality")
    return {"id": session_id, "synthetic": obj["synthetic"],
            "start": start, "end": end,
            "window_baseline": window_baseline,
            "devices": devices,
            "quality": obj["quality"],
            "environment": obj["environment"],
            "catalog": obj["device_catalog"],
            "baseline_observations": len(observations)}


def check_source(source, where):
    check_keys(source, ("hook", "backend", "profile_id", "measurement",
                        "correlation"), (), where)
    check_text(source["hook"], 256, "%s.hook" % where)
    check_text(source["backend"], 64, "%s.backend" % where)
    check_text(source["profile_id"], 128, "%s.profile_id" % where)
    check_enum(source["measurement"], ("observed", "derived", "estimated"),
               "%s.measurement" % where)
    check_enum(source["correlation"], ("direct", "unpaired"),
               "%s.correlation" % where)


def check_context(context, where):
    check_keys(context, ("relation",),
               ("cpu", "pid", "tgid", "comm", "cgroup_id"), where)
    if context["relation"] != "execution_context_only":
        fail("bad-context", "%s.relation" % where)
    for key, limit in (("cpu", 1048575), ("pid", 4194304),
                       ("tgid", 4194304)):
        if key in context:
            value = context[key]
            if (not isinstance(value, int)
                    or isinstance(value, bool)
                    or value < 0 or value > limit):
                fail("bad-context", "%s.%s out of range" % (where, key))
    if "comm" in context:
        check_text(context["comm"], 64, "%s.comm" % where,
                   allow_empty=True)
    if "cgroup_id" in context:
        check_id(context["cgroup_id"], "%s.cgroup_id" % where)


def check_return_code(value, where):
    if value is not None and (not isinstance(value, int)
                              or isinstance(value, bool)):
        fail("bad-type", "%s must be an integer" % where)


I64MAX = 9223372036854775807


def check_generation(value, where):
    if not isinstance(value, int) or isinstance(value, bool):
        fail("bad-type", "%s must be an integer" % where)
    if value < 1 or value > I64MAX:
        fail("bad-generation", "%s out of range" % where)


def check_span(data, where):
    offset = check_u64(data["offset"], "%s.offset" % where)
    length = check_u64(data["length"], "%s.length" % where)
    if offset + length > U64MAX:
        fail("u64-range", "%s end offset overflows" % where)


def check_data(kind, data, where, devices):
    if not isinstance(data, dict):
        fail("bad-type", "%s must be an object" % where)
    summary = {}
    if kind == "bounce_attempt":
        check_keys(data, ("device_id", "requested_bytes", "forced",
                          "operation_id"), (), where)
        device = check_id(data["device_id"], "%s.device_id" % where)
        if device not in devices:
            fail("unknown-device", "%s.device_id %s" % (where, device))
        summary["bytes"] = check_u64(data["requested_bytes"],
                                     "%s.requested_bytes" % where)
        if not isinstance(data["forced"], bool):
            fail("bad-type", "%s.forced must be a boolean" % where)
        summary["op"] = check_id(data["operation_id"],
                                 "%s.operation_id" % where)
        summary["device"] = device
    elif kind == "map_result":
        check_keys(data, ("operation_id", "success", "mapping_id",
                          "return_code", "mapped_bytes"), (), where)
        summary["op"] = check_id(data["operation_id"],
                                 "%s.operation_id" % where)
        if not isinstance(data["success"], bool):
            fail("bad-type", "%s.success must be a boolean" % where)
        if data["success"]:
            if data["mapping_id"] is None:
                fail("missing-mapping",
                     "%s needs a mapping_id on success" % where)
            summary["mapping"] = check_id(data["mapping_id"],
                                          "%s.mapping_id" % where)
            if data["mapped_bytes"] is None:
                fail("missing-required",
                     "%s needs mapped_bytes on success" % where)
            summary["mapped"] = check_u64(data["mapped_bytes"],
                                          "%s.mapped_bytes" % where)
        else:
            if data["mapping_id"] is not None:
                fail("failed-with-mapping",
                     "%s: failed allocation must not acquire a mapping"
                     % where)
            if data["mapped_bytes"] is not None:
                fail("failed-with-mapping",
                     "%s: failed allocation has no mapped bytes" % where)
        check_return_code(data["return_code"], "%s.return_code" % where)
    elif kind == "unmap":
        check_keys(data, ("mapping_id",), (), where)
        if data["mapping_id"] is not None:
            summary["mapping_ref"] = check_id(data["mapping_id"],
                                              "%s.mapping_id" % where)
    elif kind == "copy":
        check_keys(data, ("operation_id", "mapping_id", "direction",
                          "bytes"), (), where)
        summary["op"] = check_id(data["operation_id"],
                                 "%s.operation_id" % where)
        if data["mapping_id"] is not None:
            summary["mapping_ref"] = check_id(data["mapping_id"],
                                              "%s.mapping_id" % where)
        check_enum(data["direction"],
                   ("original_to_bounce", "bounce_to_original"),
                   "%s.direction" % where)
        summary["copy_bytes"] = check_u64(data["bytes"],
                                          "%s.bytes" % where)
        summary["direction"] = data["direction"]
    elif kind == "sync_request":
        check_keys(data, ("operation_id", "mapping_id", "offset",
                          "length"), (), where)
        summary["op"] = check_id(data["operation_id"],
                                 "%s.operation_id" % where)
        if data["mapping_id"] is not None:
            summary["mapping_ref"] = check_id(data["mapping_id"],
                                              "%s.mapping_id" % where)
        check_span(data, where)
    elif kind == "transition_result":
        check_keys(data, ("region_id", "requested_state", "success",
                          "return_code", "offset", "length"),
                   ("address_space", "resolution", "generation"), where)
        check_id(data["region_id"], "%s.region_id" % where)
        check_enum(data["requested_state"], ("shared", "private"),
                   "%s.requested_state" % where)
        if not isinstance(data["success"], bool):
            fail("bad-type", "%s.success must be a boolean" % where)
        check_return_code(data["return_code"], "%s.return_code" % where)
        check_span(data, where)
        if "address_space" in data:
            check_enum(data["address_space"],
                       ("guest_physical", "kernel_virtual", "iova",
                        "identity_only"),
                       "%s.address_space" % where)
        if "resolution" in data:
            check_enum(data["resolution"], ("resolved", "unresolved"),
                       "%s.resolution" % where)
        if "generation" in data:
            check_generation(data["generation"],
                             "%s.generation" % where)
    elif kind == "pool_sample":
        check_keys(data, ("pool_id", "used_bytes", "capacity_bytes",
                          "unit"),
                   ("allocator", "unit_bytes", "hiwater_bytes",
                    "reason"), where)
        summary["pool"] = check_id(data["pool_id"], "%s.pool_id" % where)
        if data["used_bytes"] is not None:
            check_u64(data["used_bytes"], "%s.used_bytes" % where)
        if data["capacity_bytes"] is not None:
            check_u64(data["capacity_bytes"], "%s.capacity_bytes" % where)
        check_enum(data["unit"], ("bytes", "unknown"), "%s.unit" % where)
        if "allocator" in data:
            check_id(data["allocator"], "%s.allocator" % where)
        if "unit_bytes" in data:
            unit = check_u64(data["unit_bytes"],
                             "%s.unit_bytes" % where)
            if unit == 0:
                fail("unexpected-value",
                     "%s.unit_bytes must be positive" % where)
        if "hiwater_bytes" in data and data["hiwater_bytes"] is not None:
            check_u64(data["hiwater_bytes"],
                      "%s.hiwater_bytes" % where)
        if "reason" in data:
            check_enum(data["reason"],
                       ("denied", "absent", "unparseable"),
                       "%s.reason" % where)
    elif kind == "gap":
        check_keys(data, ("channel", "lost_count", "reason",
                          "window_start_ns", "window_end_ns"), (), where)
        check_enum(data["channel"], CHANNELS, "%s.channel" % where)
        if data["lost_count"] is not None:
            check_u64(data["lost_count"], "%s.lost_count" % where)
        check_text(data["reason"], 512, "%s.reason" % where)
        check_u64(data["window_start_ns"], "%s.window_start_ns" % where)
        check_u64(data["window_end_ns"], "%s.window_end_ns" % where)
    elif kind == "marker":
        check_keys(data, ("text",), (), where)
        check_text(data["text"], 256, "%s.text" % where)
    elif kind == "counter_snapshot":
        check_keys(data, ("counter_id", "epoch", "scope", "value",
                          "unit"), (), where)
        check_text(data["counter_id"], 128, "%s.counter_id" % where)
        check_u64(data["epoch"], "%s.epoch" % where)
        scope = data["scope"]
        check_keys(scope, ("profile_id",), ("device_id",),
                   "%s.scope" % where)
        if scope.get("device_id") is not None:
            device = check_id(scope["device_id"],
                              "%s.scope.device_id" % where)
            if device not in devices:
                fail("unknown-device", "snapshot device %s" % device)
        check_text(scope["profile_id"], 128,
                   "%s.scope.profile_id" % where)
        check_u64(data["value"], "%s.value" % where)
        check_text(data["unit"], 32, "%s.unit" % where)
    else:
        fail("bad-kind", "unknown event kind %r" % (kind,))
    return summary


def check_event(obj, lineno, session):
    where = "line %d" % lineno
    check_keys(obj,
               ("schema_version", "session_id", "seq", "ts_ns", "kind",
                "source", "data"),
               ("observer_context",), where)
    if obj["schema_version"] != VERSION:
        fail("bad-version", "%s schema_version %r"
             % (where, obj["schema_version"]))
    if obj["session_id"] != session["id"]:
        fail("session-mismatch",
             "%s belongs to session %r" % (where, obj["session_id"]))
    seq = check_u64(obj["seq"], "%s.seq" % where)
    timestamp = check_u64(obj["ts_ns"], "%s.ts_ns" % where)
    kind = obj["kind"]
    floor = session["start"]
    if (kind == "counter_snapshot"
            and session["window_baseline"] is not None):
        floor = session["window_baseline"]
    if timestamp < floor or timestamp >= session["end"]:
        fail("outside-window", "%s timestamp outside capture window"
             % where)
    if kind not in KINDS:
        fail("bad-kind", "%s kind %r" % (where, kind))
    check_source(obj["source"], "%s.source" % where)
    if "observer_context" in obj:
        check_context(obj["observer_context"],
                      "%s.observer_context" % where)
    summary = check_data(kind, obj["data"], "%s.data" % where,
                         session["devices"])
    summary["kind"] = kind
    summary["seq"] = seq
    return summary


MAX_TRACKED_IDS = 4194304


def validate_stream(session, events_path):
    """Validate one NDJSON stream; return an incremental summary.

    Events are checked and folded one line at a time; only identity sets
    and running attempt totals are retained. Identity tracking is capped
    so a hostile stream fails closed instead of exhausting memory. This
    strict validator suits design-scale inputs; production-scale replay is
    the product reader's bounded streaming job.
    """
    count = 0
    attempts = 0
    requested = 0
    per_device = {}
    kinds = set()
    pools = set()
    previous_seq = None
    operations = set()
    mappings = {}
    pending_refs = []
    for lineno, raw in iter_lines(events_path):
        try:
            text = raw.decode("utf-8")
        except UnicodeDecodeError as exc:
            fail("bad-encoding", "line %d: %s" % (lineno, exc))
        if not text.strip():
            fail("blank-line", "line %d is blank" % lineno)
        check_depth(text, "line %d" % lineno)
        obj = parse_json(text, "line %d" % lineno)
        event = check_event(obj, lineno, session)
        if previous_seq is not None and event["seq"] <= previous_seq:
            fail("bad-sequence",
                 "line %d sequence does not increase" % lineno)
        previous_seq = event["seq"]
        if event.get("op") is not None:
            # Only attempts and map results claim an operation once;
            # copies and syncs repeat freely under one operation.
            if event["kind"] in ("bounce_attempt", "map_result"):
                key = (event["kind"], event["op"])
                if key in operations:
                    fail("duplicate-id",
                         "line %d repeats operation %s for kind %s"
                         % (lineno, event["op"], event["kind"]))
                operations.add(key)
        if "mapping" in event:
            if event["mapping"] in mappings:
                fail("duplicate-id",
                     "mapping %s repeats" % event["mapping"])
            mappings[event["mapping"]] = {"seq": event["seq"],
                                          "released": False}
        ref = event.get("mapping_ref")
        if ref is not None:
            if event["kind"] == "unmap":
                state = mappings.get(ref)
                if state is None:
                    fail("unknown-mapping",
                         "line %d releases mapping %s without prior "
                         "creation" % (lineno, ref))
                if state["released"]:
                    fail("double-release",
                         "line %d releases mapping %s twice"
                         % (lineno, ref))
                state["released"] = True
            else:
                pending_refs.append((event["seq"], ref))
        if len(operations) + len(mappings) > MAX_TRACKED_IDS:
            fail("too-many-identities",
                 "capture exceeds %d tracked identities" % MAX_TRACKED_IDS)
        if event["kind"] == "bounce_attempt":
            attempts += 1
            requested += event["bytes"]
            if requested > U64MAX:
                fail("u64-range", "requested-bytes sum overflows")
            device = event["device"]
            dev_count, dev_total = per_device.get(device, (0, 0))
            dev_total += event["bytes"]
            if dev_total > U64MAX:
                fail("u64-range", "per-device bytes sum overflows")
            per_device[device] = (dev_count + 1, dev_total)
        kinds.add(event["kind"])
        if event["kind"] == "pool_sample":
            pools.add(event["pool"])
        count += 1
    for seq, ref in pending_refs:
        if ref not in mappings:
            fail("unknown-mapping",
                 "seq %d references unknown mapping %s" % (seq, ref))
    return {"count": count, "attempts": attempts, "requested": requested,
            "per_device": per_device, "kinds": kinds, "pools": pools}


def validate_capture(path):
    session_path = os.path.join(path, "session.json")
    events_path = os.path.join(path, "events.ndjson")
    if not os.path.isfile(session_path):
        fail("missing-file", "no session.json in %s" % path)
    if not os.path.isfile(events_path):
        fail("missing-file", "no events.ndjson in %s" % path)
    session = check_session(read_json_file(session_path, "session.json"))
    return session, validate_stream(session, events_path)



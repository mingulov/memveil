    check_enum(obj["status"], ("validated", "reference-unvalidated"),
               "profile.status")
    ident = obj["identity"]
    check_keys(ident, ("arch", "min_kernel", "source"), ("note",),
               "profile.identity")
    check_text(ident["arch"], 32, "profile.identity.arch")
    floor = ident["min_kernel"]
    if not isinstance(floor, str) or not MIN_KERNEL_RE.fullmatch(floor):
        fail("bad-version", "profile.identity.min_kernel")
    source = ident["source"]
    check_keys(source, ("origin", "revision"), ("note",),
               "profile.identity.source")
    check_text(source["origin"], 64, "profile.identity.source.origin")
    check_text(source["revision"], 128, "profile.identity.source.revision")
    if "note" in source:
        check_text(source["note"], 512, "profile.identity.source.note",
                   allow_empty=True)

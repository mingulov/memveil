# unpacked by the build: staged bytes must match the receipt.
# Longer prefixes first so libbpf-mojo-LICENSES/ wins over
# the licenses/ file prefix.
OUTPUT_STAGED_PREFIXES = (
    ("bpf", "bpf"),
    ("licenses/libbpf-mojo-LICENSES", "deps/lmb/LICENSES"),
    ("licenses", "deps/lmb/licenses"),
)
OUTPUT_STAGED_FILES = {
    "lib/libbpf_mojo.so.1": "deps/lmb/lib/libbpf_mojo.so.1",
    "licenses/libbpf-mojo-LICENSE": "deps/lmb/LICENSE",

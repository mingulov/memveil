def run_one(entry, args, kind, source, disk_img, tools, run_id,
            prefix, guest_script=None, collect=None,
            stage=None):
    ident = entry["id"]
    export = os.path.join(args.out, ident)
    if os.path.exists(export):
        return {"id": ident, "ok": False, "run_id": run_id,
                "detail": "evidence dir exists (refusing overwrite)"}
    os.makedirs(export)
    admitted = [cap for cap in km.CAPS
                if entry["expected"][cap]["verdict"] == "admitted"]
    job = {"id": ident, "vng_version": km.row_boot_label(entry),
           "release": entry["release"], "admitted": admitted,
           "duration": args.duration, "dd_count": args.dd_count,
           "run_id": run_id, "data_serial": "mv0",
           "scratch_serial": "mv1"}
    if kind == "deb":
        job["deb"] = source
    else:
        job["bundle"] = source
    job["repo"] = str(ROOT)
    if stage is not None:
        stage(export, job)
    Path(export, "job.json").write_text(json.dumps(job, indent=2)
                                        + "\n")
    t0 = time.monotonic()
    ok, msg, cache_dir, target = verify_cache(entry)
    if not ok and entry["source"]["kind"] == "archive" \
            and "missing" in msg:
        dl_ok, dl_msg = download_cache(
            prefix[-1], entry["source"]["vng_version"])
        Path(export, "download.txt").write_text(dl_msg + "\n")
        if dl_ok:
            ok, msg, cache_dir, target = verify_cache(entry)
        else:
            msg = dl_msg
    if not ok:
        Path(export, "cache-FAIL.txt").write_text(msg + "\n")
        return {"id": ident, "ok": False, "detail": msg,
                "run_id": run_id,
                "elapsed": round(time.monotonic() - t0, 1)}
    Path(export, "cache.txt").write_text(msg + " " + cache_dir
                                         + "\n")
    try:
        km.validate_shell_path(export, "evidence dir")
        km.validate_shell_path(disk_img, "disk image")
    except ValueError as exc:
        return {"id": ident, "ok": False, "detail": str(exc),
                "run_id": run_id,
                "elapsed": round(time.monotonic() - t0, 1)}
    script = guest_script or str(
        ROOT / "tests" / "vm" / "kernel_matrix_guest.py")
    guest_cmd = "python3 %s /tmp/export %s" % (
        shlex.quote(script), shlex.quote(str(ROOT)))
    scratch_img = ensure_scratch(disk_img, ident)
    qemu_opts = "-cpu host %s %s" % (
        km.qemu_drive_opt(disk_img),
        km.qemu_drive_opt(scratch_img, drive_id="d1",
                          serial="mv1", readonly=False))
    append = "swiotlb=131072,force"
    for arg in entry.get("boot_append") or []:
        km.validate_shell_path(arg, "boot argument")
        append += " " + arg
    vng_args = ["--run", target,
                "--cpus", str(args.cpus),
                "-m", "4G", "--append", append,
                "--overlay-rwdir=/usr", "--overlay-rwdir=/etc",
                "--overlay-rwdir=/var",
                "--rwdir=/tmp/export=%s" % export,
                "--qemu-opts=%s" % qemu_opts,
                "--exec", guest_cmd]
    try:
        cmd = km.build_vng_cmd(prefix,
                               os.environ.get("MV_HOST_CPUS"),
                               str(Path.home()), vng_args)
    except ValueError as exc:
        return {"id": ident, "ok": False, "detail": str(exc),
                "run_id": run_id,
                "elapsed": round(time.monotonic() - t0, 1)}
    Path(export, "vng-cmd.txt").write_text(" ".join(cmd) + "\n")
    from vm_process import run_owned_guest
    timeout = False
    try:
        proc = run_owned_guest(cmd, timeout=args.timeout)
        Path(export, "console.txt").write_text(
            (proc.stdout or "") + (proc.stderr or ""))
        Path(export, "vng.exit").write_text(str(proc.returncode))
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        err = exc.stderr if isinstance(exc.stderr, str) else ""
        Path(export, "console.txt").write_text((out or "")
                                               + (err or ""))
        Path(export, "vng.exit").write_text("timeout")
        timeout = True
    elapsed = time.monotonic() - t0
    if collect is None:
        return collect_one(entry, export, tools,
                           args.dd_count, elapsed, run_id,
                           timeout, cache_dir, args.duration)
    return collect(entry, export, tools, elapsed, run_id,
                   timeout, cache_dir)


NEGATIVE_NAMES = ("renamed_field", "widened_layout",
                  "wrong_shift", "wrong_argcnt")


def scenario_negatives():
    """Name to sha256 for the four negative objects.

    Raises ValueError when the negative build is missing.
    """
    shas = {}
    for name in NEGATIVE_NAMES:
        path = ROOT / "build" / "bpf-negative" / (
            "swiotlb_copy-%s.bpf.o" % name)
        if not path.is_file():
            raise ValueError(
                "missing negative object %s (run tools/build)"
                % path)
        shas[name] = km.sha_file(str(path))
    return shas


def deb_copy_object_sha(deb):
    """Sha256 of the deb's copy object, or raise ValueError."""
    try:
        fsys = subprocess.run(
            ["dpkg-deb", "--fsys-tarfile", deb],
            capture_output=True, timeout=120)
        if fsys.returncode != 0:
            raise ValueError("cannot list deb %s" % deb)
        tar = subprocess.run(
            ["tar", "-xO",
             "./usr/lib/memveil/swiotlb_copy.bpf.o"],
            input=fsys.stdout, capture_output=True,
            timeout=120)
        if tar.returncode != 0 or not tar.stdout:
            raise ValueError(
                "deb %s has no copy object" % deb)
        return hashlib.sha256(tar.stdout).hexdigest()
    except subprocess.TimeoutExpired:
        raise ValueError("deb read timed out: %s" % deb)


def check_scenario_inputs(deb):
    """Negative shas after the deb matches the build.

    Raises ValueError when negatives are missing or the
    deb's copy object differs from the built one.
    """
    shas = scenario_negatives()
    built = ROOT / "build" / "bpf" / "swiotlb_copy.bpf.o"
    if not built.is_file():
        raise ValueError("missing built copy object %s "
                         "(run tools/build)" % built)
    if deb_copy_object_sha(deb) != km.sha_file(str(built)):
        raise ValueError(
            "deb copy object differs from %s" % built)
    return shas


def stage_scenario_files(export, job, neg_shas):
    """Copy negative objects into the export; extend the job."""
    neg_dir = os.path.join(export, "neg")
    os.makedirs(neg_dir, exist_ok=True)
    for name in NEGATIVE_NAMES:
        src = ROOT / "build" / "bpf-negative" / (
            "swiotlb_copy-%s.bpf.o" % name)
        shutil.copy2(str(src), os.path.join(
            neg_dir, "swiotlb_copy-%s.bpf.o" % name))
    job["negatives"] = dict(neg_shas)


def run_check_doctor(path):
    """True when validate-schemas accepts one doctor document."""
    if not os.path.isfile(path):
        return False
    try:
        proc = subprocess.run(
            [str(ROOT / "tools" / "validate-schemas"),
             "--check-doctor", path],
            capture_output=True, text=True,
            timeout=CAPTURE_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def validate_capture_dir(capdir):
    """Validator exit for one capture dir, None when missing."""
    if not os.path.isdir(capdir):
        return None
    try:
        proc = subprocess.run(
            [str(ROOT / "tools" / "validate-schemas"),
             capdir],
            capture_output=True, text=True,
            timeout=CAPTURE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 99
    except OSError:
        return 99
    return proc.returncode


def gather_scenario_ev(export, name, negs, base_verdict):
    """Evidence dict for one scenario directory."""
    sdir = os.path.join(export, "scn-" + name)

    def read(leaf):
        return read_text(os.path.join(sdir, leaf))

    def load_json(leaf):
        try:
            return json.loads(read(leaf) or "")
        except ValueError:
            return None

    spec = ks.SCENARIOS[name]
    capture = None
    if spec.get("capture") is not None:
        capdir = os.path.join(sdir, "cap")
        capture = {
            "events_text": read_text(os.path.join(
                capdir, "events.ndjson")),
            "session_text": read_text(os.path.join(
                capdir, "session.json")),
            "report_json_text": read("report.json"),
            "report_text": read("report.txt"),
            "workload_out": read("workload.out"),
            "workload_exit": read("workload.exit"),
            "validate_rc": validate_capture_dir(capdir),
            "object_sha": negs.get(spec.get("negative")),
        }
    memcg = None
    if name == "memcg":
        memcg = load_json("memcg.json")
    return {
        "passive": {"text": read("doctor-passive.json"),
                    "exit": read("doctor-passive.exit")},
        "load": {"text": read("doctor-load.json"),
                 "exit": read("doctor-load.exit")},
        "record": {"out": read("record.out"),
                   "exit": read("record.exit"),
                   "exists": read("record.exists")},
        "passive_schema": run_check_doctor(os.path.join(
            sdir, "doctor-passive.json")),
        "load_schema": run_check_doctor(os.path.join(
            sdir, "doctor-load.json")),
        "precondition": load_json("precondition.json"),
        "teardown": load_json("teardown.json"),
        "base_verdict": base_verdict,
        "capture": capture,
        "memcg": memcg,
        "job_negatives": dict(negs),
    }


def collect_scenarios(entry, export, tools, elapsed, run_id,
                      timeout, cache_dir):
    """Judge every scenario of one booted row."""
    ident = entry["id"]
    try:
        job = json.loads(Path(export, "job.json")
                         .read_text())
    except (OSError, ValueError):
        job = {}
    negs = job.get("negatives", {})
    base_verdict = None
    try:
        base_pre = json.loads(Path(
            export, "scn-base",
            "precondition.json").read_text())
        base_verdict = base_pre.get("verdict")
    except (OSError, ValueError, AttributeError):
        base_verdict = None
    named = []
    for name in ks.SCENARIO_ORDER:
        try:
            ev = gather_scenario_ev(export, name, negs,
                                    base_verdict)
            rec = ks.evaluate_scenario(name, ev)
        except Exception as exc:
            rec = {"name": name, "ok": False,
                   "status": "fail",
                   "checks": [{"name": "precondition",
                               "ok": False,
                               "detail": "scenario decision "
                                         "crashed: %s" % exc,
                               "skipped": False}]}
        named.append((name, rec))
    try:
        results = ks.evaluate_run(named)
    except Exception as exc:
        return {"id": ident, "mode": "scenarios", "ok": False,
                "run_id": run_id,
                "detail": "run decision crashed: %s" % exc,
                "elapsed": round(elapsed, 1),
                "scenarios": [rec for _, rec in named]}
    ok_count = sum(1 for res in results
                   if res["status"] == "ok")
    np_count = sum(1 for res in results
                   if res["status"] == "not_proven")
    fail_count = sum(1 for res in results
                     if res["status"] == "fail")
    ok = fail_count == 0
    detail = "scenarios ok=%d fail=%d not_proven=%d" % (
        ok_count, fail_count, np_count)
    fail_txt = read_text(os.path.join(export, "FAIL.txt"))
    if fail_txt is not None:
        ok = False
        detail += "; guest FAIL: %s" % fail_txt.strip()[:200]
    if timeout:
        ok = False
        detail += "; vng timeout"
    binary_sha = None
    try:
        artifacts = json.loads(Path(
            export, "artifacts.json").read_text())
        binary_sha = artifacts["binary"]["sha256"]
    except (OSError, ValueError, KeyError, TypeError):
        binary_sha = None
    return {"id": ident, "mode": "scenarios", "ok": ok,
            "detail": detail, "run_id": run_id,
            "vng_version": km.row_boot_label(entry),
            "release": entry["release"],
            "elapsed": round(elapsed, 1),
            "binary_sha256": binary_sha,
            "negatives": dict(negs),
            "scenarios": results}


def write_scenario_summary(out, merged):
    lines = ["kernel vng scenarios verdict run"]
    for rec in merged:
        results = rec.get("scenarios", [])
        ok_count = sum(1 for res in results
                       if res.get("status") == "ok")
        fail_count = sum(1 for res in results
                         if res.get("status") == "fail")
        np_count = sum(1 for res in results
                       if res.get("status") == "not_proven")
        lines.append("%s %s ok=%d fail=%d not_proven=%d %s "
                     "run=%s" % (
                         rec.get("id"),
                         rec.get("vng_version", "?"),
                         ok_count, fail_count, np_count,
                         "PASS" if rec.get("ok") else "FAIL",
                         rec.get("run_id", "?")))
        for res in results:
            lines.append("  %s: %s" % (
                res.get("name"), res.get("status")))
    Path(out, "summary.txt").write_text("\n".join(lines)
                                       + "\n")
    Path(out, "summary.json").write_text(
        json.dumps(merged, indent=2, sort_keys=True) + "\n")
    print("\n".join(lines))


def write_summary(out, merged):
    lines = ["kernel vng doctor record report channels "
             "detail/aggregate verdict run"]
    for rec in merged:
        chans = rec.get("channels")
        if isinstance(chans, dict):
            chan_txt = ",".join("%s=%s" % (k, v.split()[0])
                                for k, v in sorted(chans.items()))
        else:
            chan_txt = "-"
        lines.append("%s %s doctor=%s record=%s report=%s %s %s %s "
                     "run=%s" % (
                         rec.get("id"), rec.get("vng_version", "?"),
                         "ok" if rec.get("doctor_ok") else "BAD",
                         rec.get("record_exit", "?"),
                         rec.get("report_exit", "?"), chan_txt,
                         (rec.get("detail_quality", "-") or "-")[:60],
                         "PASS" if rec.get("ok") else "FAIL",
                         rec.get("run_id", "?")))
    Path(out, "summary.txt").write_text("\n".join(lines) + "\n")
    Path(out, "summary.json").write_text(
        json.dumps(merged, indent=2, sort_keys=True) + "\n")
    print("\n".join(lines))


def main(argv=None):
    parser = argparse.ArgumentParser(
        description="Boot matrix kernels and prove the generations "
                    "table. MV_HOST_CPUS pins the host CPU set "
                    "through taskset; unset runs without taskset.")
    parser.add_argument("--out", required=True,
                        help="evidence parent dir (per-kernel subdirs)")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--kernel", help="one lock id to run")
    group.add_argument("--kernels",
                       help="comma-separated lock ids, in order")
    group.add_argument("--all", action="store_true",
                       help="run every lock entry")
    parser.add_argument("--lock", default=str(
        ROOT / "tests" / "vm" / "kernels.lock.json"),
                        help="kernels lock path")
    parser.add_argument("--deb", default=os.environ.get("MV_DEB"),
                        help="memveil .deb to install (or MV_DEB)")
    parser.add_argument("--bundle",
                        help="owner bundle dir with bin/memveil")
    parser.add_argument("--disk-img",
                        help="NVMe backing image (created if missing)")
    parser.add_argument("--duration", type=int, default=60,
                        help="record duration seconds")
    parser.add_argument("--dd-count", type=int, default=128,
                        help="MB per dd read")
    parser.add_argument("--timeout", type=int, default=900,
                        help="per-kernel timeout seconds")
    parser.add_argument("--cpus", type=int, default=4,
                        help="guest vCPUs (at most 4)")
    parser.add_argument("--scenarios", action="store_true",
                        help="run detection scenarios, not the "
                             "matrix")
    args = parser.parse_args(argv)
    if args.cpus < 1 or args.cpus > 4:
        print("kernel-matrix: --cpus must be 1..4", file=sys.stderr)
        return 2
    try:
        lock = km.parse_lock(args.lock)
    except km.LockError as exc:
        print("kernel-matrix: bad lock: %s" % exc, file=sys.stderr)
        return 2
    entries = lock["kernels"]
    if args.kernel:
        entries = [e for e in entries if e["id"] == args.kernel]
        if not entries:
            print("kernel-matrix: unknown kernel %s" % args.kernel,
                  file=sys.stderr)
            return 2
    if args.kernels:
        try:
            entries = km.select_kernel_ids(entries, args.kernels)
        except ValueError as exc:
            print("kernel-matrix: bad --kernels: %s" % exc,
                  file=sys.stderr)
            return 2
    try:
        kind, source = km.resolve_inputs(args.deb, args.bundle)
    except ValueError as exc:
        print("kernel-matrix: %s" % exc, file=sys.stderr)
        return 2
    if args.scenarios and kind != "deb":
        print("kernel-matrix: --scenarios needs --deb",
              file=sys.stderr)
        return 2
    if kind == "deb":
        if not os.path.isfile(source):
            print("kernel-matrix: missing deb %s" % source,
                  file=sys.stderr)
            return 2
        source = str(Path(source).resolve())
    else:
        cand = Path(source) / "bin" / "memveil"
        if not cand.is_file():
            print("kernel-matrix: missing %s" % cand,
                  file=sys.stderr)
            return 2
        source = str(cand.resolve())
    neg_shas = {}
    if args.scenarios:
        try:
            neg_shas = check_scenario_inputs(source)
        except ValueError as exc:
            print("kernel-matrix: %s" % exc, file=sys.stderr)
            return 2
        for entry in entries:
            if not ks.scenarios_row_admitted(entry):
                print("kernel-matrix: --scenarios needs an "
                      "all-admitted row, refusing %s"
                      % entry["id"], file=sys.stderr)
                return 2
    os.makedirs(args.out, exist_ok=True)
    collisions = km.check_out_collisions(
        args.out, [e["id"] for e in entries])
    if collisions:
        print("kernel-matrix: evidence dirs exist (refusing "
              "overwrite): %s; use a fresh --out"
              % ", ".join(collisions), file=sys.stderr)
        return 2
    disk_img = args.disk_img or str(ROOT / "build" / "vm"
                                    / "kernel-matrix-disk.img")
    try:
        km.validate_shell_path(disk_img, "disk image")
        disk_img = ensure_disk(disk_img)
    except ValueError as exc:
        print("kernel-matrix: %s" % exc, file=sys.stderr)
        return 2
    try:
        sys.path.insert(0, str(ROOT / "tests" / "vm"))
        from test_attempt_capture import gate_prefix
        prefix, _ = gate_prefix()
    except BaseException as exc:
        print("kernel-matrix: guest unrunnable: %s" % exc,
              file=sys.stderr)
        return 1
    try:
        import harness_env
        harness = harness_env.check_harness_versions(prefix[-1])
    except ValueError as exc:
        print("kernel-matrix: %s" % exc, file=sys.stderr)
        return 1
    for tool in ("bpftrace", "bpftool"):
        try:
            proc = subprocess.run([tool, "--version"],
                                  capture_output=True, text=True,
                                  timeout=10)
            first = (proc.stdout or "").splitlines()
            harness[tool] = first[0].strip() if first else ""
        except (OSError, subprocess.TimeoutExpired):
            harness[tool] = ""
    harness["run_id"] = datetime.now(timezone.utc).strftime(
        "%Y%m%dT%H%M%SZ")
    try:
        harness["deb_sha256"] = km.sha_file(source) \
            if kind == "deb" else None
    except OSError as exc:
        print("kernel-matrix: cannot hash %s: %s" % (source, exc),
              file=sys.stderr)
        return 1
    commit, dirty = km.repo_identity(ROOT)
    harness["harness_commit"] = commit
    harness["harness_dirty"] = dirty
    lock_dir = ROOT / "build" / "vm"
    lock_dir.mkdir(parents=True, exist_ok=True)
    lease = (lock_dir / "suite.lock").open("a+")
    try:
        fcntl.flock(lease, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lease.close()
        print("kernel-matrix: VM suite lease already owned",
              file=sys.stderr)
        return 1
    Path(args.out, "harness.json").write_text(
        json.dumps(harness, indent=2, sort_keys=True) + "\n")
    run_id = harness["run_id"]
    results = []
    try:
        for entry in entries:
            print("kernel-matrix: %s (%s)" % (entry["id"],
                                              km.row_boot_label(
                                                  entry)))
            if args.scenarios:
                rec = run_one(
                    entry, args, kind, source, disk_img,
                    lock["tools"], run_id, prefix,
                    guest_script=str(
                        ROOT / "tests" / "vm"
                        / "kernel_scenarios_guest.py"),
                    collect=collect_scenarios,
                    stage=lambda export, job, shas=neg_shas:
                    stage_scenario_files(export, job, shas))
            else:
                rec = run_one(entry, args, kind, source,
                              disk_img, lock["tools"], run_id,
                              prefix)
            results.append(rec)
            Path(args.out, entry["id"] + ".json").write_text(
                json.dumps(rec, indent=2, sort_keys=True) + "\n")
            status = "PASS" if rec.get("ok") else "FAIL"
            print("kernel-matrix: %s %s (%.1fs)" % (
                entry["id"], status, rec.get("elapsed", 0)))
    finally:
        lease.close()
    summary_path = Path(args.out, "summary.json")
    if summary_path.exists():
        try:
            old = json.loads(summary_path.read_text())
            if not isinstance(old, list):
                raise ValueError("summary is not a list")
        except ValueError:
            print("kernel-matrix: existing summary unparseable, "
                  "refusing to merge", file=sys.stderr)
            return 2
    else:
        old = []
    merged = km.merge_summary(old, results)
    if args.scenarios:
        write_scenario_summary(args.out, merged)
    else:
        write_summary(args.out, merged)
    return 0 if all(r.get("ok") for r in results) else 1


if __name__ == "__main__":
    sys.exit(main())

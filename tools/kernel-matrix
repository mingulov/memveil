                rec = run_one(
                    entry, args, kind, source, disk_img,
                    lock["tools"], run_id, prefix,
                    receipt_base,
                    guest_script=str(
                        ROOT / "tests" / "vm"
                        / "kernel_scenarios_guest.py"),
                    collect=collect_scenarios,
                    stage=lambda export, job, shas=neg_shas:
                    stage_scenario_files(
                        export, job, shas, deb=source,
                        rootfs=rootfs, staging=staging),
                    rootfs=rootfs)
            else:
                rec = run_one(entry, args, kind, source,
                              disk_img, lock["tools"], run_id,
                              prefix, receipt_base)
            results.append(rec)
            Path(args.out, entry["id"] + ".json").write_text(
                json.dumps(rec, indent=2, sort_keys=True) + "\n")
            status = "PASS" if rec.get("ok") else "FAIL"
            print("kernel-matrix: %s %s (%.1fs)" % (
                entry["id"], status, rec.get("elapsed", 0)))
    finally:
        if rootfs is not None:
            note, rm_note = teardown_scenario_rootfs_mount(
                rootfs["mount"],
                rootfs["privilege"] == "sudo")
            if rm_note is not None:
                print("kernel-matrix: rootfs mount "
                      "point left: %s" % rm_note,
                      file=sys.stderr)
            try:
                doc = json.loads(Path(
                    args.out, "rootfs.json").read_text())
            except (OSError, ValueError):
                doc = dict(rootfs, staging=staging)
            doc["umount"] = "ok" if note is None else note
            try:
                Path(args.out, "rootfs.json").write_text(
                    json.dumps(doc, indent=2, sort_keys=True)
                    + "\n")
            except OSError as exc:
                print("kernel-matrix: cannot update rootfs.json: "
                      "%s" % exc, file=sys.stderr)
            if note is not None:
                print("kernel-matrix: rootfs umount failed: %s"
                      % note, file=sys.stderr)
        lease.close()
    old, error = load_old_summary(args.out)
    if error is not None:
        print("kernel-matrix: %s; use a fresh --out" % error,
              file=sys.stderr)
        return 2
    merged = km.merge_summary(old, results)
    if args.scenarios:
        write_scenario_summary(args.out, merged)
    else:
        write_summary(args.out, merged)
    return 0 if all(r.get("ok") for r in results) else 1


if __name__ == "__main__":
    sys.exit(main())

            rec["busy_chown_error"] = busy_chown_error
    rec["elapsed"] = round(elapsed, 1)
    rec["run_id"] = run_id
    rec["timeout"] = bool(timeout)
    return rec


def shipped_id(entry):
    """Validated profile id naming this row release, or None."""
    try:
        found = gk.shipped_profile(entry.get("release", ""))
        if found is None:
            return None
        return json.loads(Path(found).read_text())["profile_id"]
    except (OSError, ValueError, KeyError):
        return None


def run_one(entry, args, kind, source, disk_img, tools, run_id,
            prefix, receipt_base, guest_script=None,
            collect=None, stage=None, rootfs=None):
    ident = entry["id"]
    export = os.path.join(args.out, ident)
    if rootfs is not None:
        # The guest spawn runs with the host cwd inside the
        # rootfs mount (the twice-proven live shape), so every
        # host path the spawn consumes must be absolute.
        export = os.path.abspath(export)
        disk_img = os.path.abspath(disk_img)
    if os.path.exists(export):
        return {"id": ident, "ok": False, "run_id": run_id,
                "detail": "evidence dir exists (refusing overwrite)"}
    os.makedirs(export)

    def finish(rec, timeout=False):
        ctx = dict(receipt_base)
        ctx["timeout"] = bool(timeout)
        ctx["shipped_profile_id"] = shipped_id(entry)
        try:
            km.write_row_receipt(export, rec, entry, ctx)
        except (ValueError, OSError) as exc:
            print("kernel-matrix: %s: row receipt refused: %s"
                  % (ident, exc), file=sys.stderr)
            failed = [check.get("name")
                      for check in rec.get("checks", [])
                      if not check.get("ok")]
            print("kernel-matrix: %s: underlying verdict ok=%s"
                  " failed=%s" % (ident, rec.get("ok"), failed),
                  file=sys.stderr)
            return {"id": ident, "ok": False,
                    "run_id": run_id,
                    "elapsed": rec.get("elapsed", 0),
                    "detail": "row receipt refused",
                    "checks": [{"name": "receipt", "ok": False,
                                "detail": "row-receipt-refused",
                                "skipped": False}]}
        return rec

    def stage_fail(name, token, detail, t0):
        return finish(
            {"id": ident, "ok": False, "detail": detail,
             "run_id": run_id,
             "elapsed": round(time.monotonic() - t0, 1),
             "checks": [{"name": name, "ok": False,
                         "detail": token,
                         "skipped": False}]})
    admitted = [cap for cap in km.CAPS
                if entry["expected"][cap]["verdict"] == "admitted"]
    job = {"id": ident, "vng_version": km.row_boot_label(entry),
           "release": entry["release"], "admitted": admitted,
           "duration": args.duration, "dd_count": args.dd_count,
           "run_id": run_id, "data_serial": "mv0",
           "scratch_serial": "mv1"}
    if kind == "deb":
        job["deb"] = source
    else:
        job["bundle"] = source
    job["repo"] = str(ROOT)
    t0 = time.monotonic()
    for tool in ("bpftrace", "bpftool"):
        # vng passes no PATH into the guest, so the guest
        # cannot resolve the pinned tools by name: hand it
        # the host-resolved absolute paths (the shared
        # rootfs makes them valid in-guest). Host preflight
        # already verified these versions against the lock.
        path = shutil.which(tool)
        if not path or not os.path.isabs(path):
            return stage_fail("tools", "tool-unresolved",
                              "%s not on PATH" % tool, t0)
        job[tool] = path
    if stage is not None:
        try:
            stage(export, job)
        except (OSError, ValueError) as exc:
            Path(export, "job.json").write_text(
                json.dumps(job, indent=2) + "\n")
            return stage_fail("stage", "stage-failed",
                              str(exc), t0)
    Path(export, "job.json").write_text(json.dumps(job, indent=2)
                                        + "\n")
    dl_failed = False
    ok, msg, cache_dir, target = verify_cache(entry)
    if not ok and entry["source"]["kind"] == "archive" \
            and "missing" in msg:
        dl_ok, dl_msg = download_cache(
            prefix[-1], entry["source"]["vng_version"])
        Path(export, "download.txt").write_text(dl_msg + "\n")
        if dl_ok:
            ok, msg, cache_dir, target = verify_cache(entry)
        else:
            msg = dl_msg
            dl_failed = True
    if not ok:
        Path(export, "cache-FAIL.txt").write_text(msg + "\n")
        if dl_failed:
            return stage_fail("download", "download-failed",
                              msg, t0)
        return stage_fail("cache", "cache-unverified", msg,
                          t0)
    Path(export, "cache.txt").write_text(msg + " " + cache_dir
                                         + "\n")
    for label, value, name in (
            ("evidence dir", export, "evidence_path"),
            ("disk image", disk_img, "disk_path"),
            ("boot target", target, "boot_target")):
        try:
            km.validate_shell_path(value, label)
        except ValueError as exc:
            return stage_fail(name, "path-rejected",
                              str(exc), t0)
    if rootfs is not None:
        guest_cmd = scenario_guest_cmd(job.get("deb"))
    else:
        script = guest_script or str(
            ROOT / "tests" / "vm" / "kernel_matrix_guest.py")
        guest_cmd = "python3 %s /tmp/export %s" % (
            shlex.quote(script), shlex.quote(str(ROOT)))
    try:
        scratch_img = ensure_scratch(disk_img, ident)
        km.validate_shell_path(scratch_img, "scratch image")
    except ValueError as exc:
        return stage_fail("scratch", "scratch-failed",
                          str(exc), t0)
    qemu_opts = "-cpu host %s %s" % (
        km.qemu_drive_opt(disk_img),
        km.qemu_drive_opt(scratch_img, drive_id="d1",
                          serial="mv1", readonly=False))
    # tsc=nowatchdog stops the clocksource watchdog, whose remote-CPU
    # read timeouts under host vCPU preemption are guest noise.
    append = "swiotlb=131072,force tsc=nowatchdog"
    try:
        for arg in entry.get("boot_append") or []:
            km.validate_shell_path(arg, "boot argument")
            append += " " + arg
    except (ValueError, TypeError) as exc:
        return stage_fail("boot_args", "boot-argument-rejected",
                          str(exc), t0)
    vng_args = ["--run", target,
                "--cpus", str(args.cpus),
                "-m", "4G", "--append", append,
                "--overlay-rwdir=/usr", "--overlay-rwdir=/etc",
                "--overlay-rwdir=/var",
                "--rwdir=/tmp/export=%s" % export,
                "--qemu-opts=%s" % qemu_opts]
    if rootfs is not None:
        vng_args += scenario_rootfs_vng_args(
            rootfs["mount"],
            os.path.join(export, STAGE_DEB_DIRNAME))
    vng_args += ["--exec", guest_cmd]
    try:
        if rootfs is not None and prefix \
                and not os.path.isabs(prefix[-1]):
            resolved = shutil.which(prefix[-1])
            if resolved is None:
                return stage_fail("vng_cmd", "vng-unresolved",
                                  "vng not on PATH: %s"
                                  % prefix[-1], t0)
            prefix = list(prefix[:-1]) + [
                os.path.abspath(resolved)]
        cmd = km.build_vng_cmd(prefix,
                               os.environ.get("MV_HOST_CPUS"),
                               str(Path.home()), vng_args)
    except ValueError as exc:
        return stage_fail("vng_cmd", "vng-command-rejected",
                          str(exc), t0)
    Path(export, "vng-cmd.txt").write_text(" ".join(cmd) + "\n")
    from vm_process import run_owned_guest
    timeout = False
    old_cwd = None
    if rootfs is not None:
        try:
            old_cwd = os.getcwd()
            os.chdir(rootfs["mount"])
        except OSError as exc:
            return stage_fail("rootfs", "rootfs-chdir-failed",
                              str(exc), t0)
    try:
        proc = run_owned_guest(cmd, timeout=args.timeout)
        Path(export, "console.txt").write_text(
            (proc.stdout or "") + (proc.stderr or ""))
        Path(export, "vng.exit").write_text(str(proc.returncode))
    except subprocess.TimeoutExpired as exc:
        out = exc.stdout if isinstance(exc.stdout, str) else ""
        err = exc.stderr if isinstance(exc.stderr, str) else ""
        Path(export, "console.txt").write_text((out or "")
                                               + (err or ""))
        Path(export, "vng.exit").write_text("timeout")
        timeout = True
    finally:
        if old_cwd is not None:
            os.chdir(old_cwd)
    elapsed = time.monotonic() - t0
    if collect is None:
        return finish(collect_one(entry, export, tools,
                                  args.dd_count, elapsed,
                                  run_id, timeout, cache_dir,
                                  args.duration), timeout)
    return finish(collect(entry, export, tools, elapsed,
                          run_id, timeout, cache_dir),
                  timeout)


NEGATIVE_NAMES = ("renamed_field", "widened_layout",
                  "wrong_shift", "wrong_argcnt")


def scenario_negatives():
    """Name to sha256 for the four negative objects.

    Raises ValueError when the negative build is missing.
    """
    shas = {}
    for name in NEGATIVE_NAMES:
        path = ROOT / "build" / "bpf-negative" / (
            "swiotlb_copy-%s.bpf.o" % name)
        if not path.is_file():
            raise ValueError(
                "missing negative object %s (cutover: C probes retired; "
                "armed runs need Rust-native probe staging)" % path)
        shas[name] = km.sha_file(str(path))
    return shas


def deb_copy_object_sha(deb):
    """Sha256 of the deb's copy object, or raise ValueError."""
    try:
        fsys = subprocess.run(
            ["dpkg-deb", "--fsys-tarfile", deb],
            capture_output=True, timeout=120)
        if fsys.returncode != 0:
            raise ValueError("cannot list deb %s" % deb)
        tar = subprocess.run(
            ["tar", "-xO",
             "./usr/lib/memveil/swiotlb_copy.bpf.o"],
            input=fsys.stdout, capture_output=True,
            timeout=120)
        if tar.returncode != 0 or not tar.stdout:
            raise ValueError(
                "deb %s has no copy object" % deb)
        return hashlib.sha256(tar.stdout).hexdigest()
    except subprocess.TimeoutExpired:
        raise ValueError("deb read timed out: %s" % deb)


BPF_CHANNELS = ("attempt", "lifecycle", "copy")
AYA_FIXTURE_BLOB = "tests/vm/fixtures/aya/swiotlb_%s.bpf.o"
MANIFEST_BPF_ENTRY = "bpf/swiotlb_%s.bpf.o"
# The sealed source commit whose Aya fixture bytes anchor
# scenario staging, plus their git blob ids. The blob pins
# name the sealed bundle bytes the committed fixtures were
# refreshed from (the same seal tests/vm/candidate_pins.py
# names; swap both in one pass at the next seal). They let
# checkouts whose git objects cannot supply those bytes at
# the sealed source (shallow clones, or a sealed source
# tree that predates the fixture refresh) verify the
# worktree bytes before trusting them; dirt fails the pin
# exactly as a missing object would.
SEALED_SOURCE_COMMIT = \
    "3a3d6cb8c8acc1295efdff6df44f2d89d327cc9c"
SEALED_FIXTURE_BLOBS = {
    "attempt": "bfbe26bbe4450145fed90c66f72ea2c4dba39b48",
    "lifecycle": "280cce505ff18005793e3b04d897c29707249976",
    "copy": "2899af58a7b7e91a4bce172b17ed2390ee0a79ea",
}


def scenario_manifest():
    """Parsed candidate manifest bound to this scenario run.

    Raises ValueError when MV_CANDIDATE_MANIFEST is unset or the
    manifest fails validation. The manifest pins the sealed source
    commit and the expected BPF object bytes.
    """
    path = os.environ.get("MV_CANDIDATE_MANIFEST")
    if not path:
        raise ValueError(
            "scenario staging needs MV_CANDIDATE_MANIFEST "
            "(fail-closed content substitution)")
    sys.path.insert(0, str(ROOT / "tools"))
    import candidate
    try:
        return candidate.load_manifest(path)
    except (OSError, ValueError, KeyError) as exc:
        raise ValueError(
            "scenario candidate manifest refused: %s" % exc)


def manifest_bpf_sha(manifest, channel):
    """Expected bytes digest for one BPF channel, or raise."""
    try:
        return manifest["files"][MANIFEST_BPF_ENTRY % channel]
    except (KeyError, TypeError):
        raise ValueError(
            "candidate manifest lacks the bpf %s entry"
            % channel)


def sealed_blob_id(data):
    """Git blob id (sha1 over the framed bytes) of data."""
    return hashlib.sha1(
        b"blob %d\0" % len(data) + data).hexdigest()


def verified_sealed_fixture_sha(channel, spec):
    """Sha256 of one sealed-commit fixture from verified bytes.

    Reads the worktree bytes only after their blob id matches
    the sealed pin, so dirt fails exactly as a missing object
    would. Raises ValueError on any gap.
    """
    try:
        want_blob = SEALED_FIXTURE_BLOBS[channel]
    except (KeyError, TypeError):
        raise ValueError(
            "sealed fixture unreadable %s: unknown "
            "channel" % spec)
    try:
        with open(str(ROOT / (AYA_FIXTURE_BLOB % channel)),
                  "rb") as handle:
            data = handle.read()
    except OSError:
        raise ValueError(
            "sealed fixture unreadable %s: worktree "
            "bytes missing" % spec)
    if sealed_blob_id(data) != want_blob:
        raise ValueError(
            "sealed fixture worktree bytes differ from "
            "the sealed pin (refusing dirt): %s" % spec)
    return hashlib.sha256(data).hexdigest()


def sealed_fixture_sha(commit, channel):
    """Sha256 of one sealed-commit Aya fixture blob.

    Reads the bytes straight from the git object store while
    they are present, so worktree dirt cannot bless staged
    bytes. For the sealed source commit the object bytes
    must also match the sealed blob pin: the sealed source
    tree can predate the fixture refresh, and then (as in
    shallow clones lacking the sealed objects) the worktree
    bytes are used only after they verify against the pin,
    which dirt cannot pass. Raises ValueError when the blob
    is unreadable.
    """
    spec = "%s:%s" % (commit, AYA_FIXTURE_BLOB % channel)
    try:
        proc = subprocess.run(
            ["git", "-C", str(ROOT), "show", spec],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            timeout=60)
    except subprocess.TimeoutExpired:
        raise ValueError(
            "sealed fixture read timed out: %s" % spec)
    except OSError:
        proc = None
    if proc is not None and proc.returncode == 0 \
            and proc.stdout:
        if commit != SEALED_SOURCE_COMMIT \
                or sealed_blob_id(proc.stdout) == \
                SEALED_FIXTURE_BLOBS.get(channel):
            return hashlib.sha256(
                proc.stdout).hexdigest()
    if commit == SEALED_SOURCE_COMMIT:
        return verified_sealed_fixture_sha(channel, spec)
    if proc is None:
        raise ValueError(
            "cannot read the sealed fixture: git "
            "unavailable (%s)" % spec)
    detail = (proc.stderr or b"").decode(
        "utf-8", "replace").strip()[:200]
    raise ValueError("sealed fixture unreadable %s: %s"
                     % (spec, detail or "empty blob"))


def release_set_shas(base):
    """Per-channel shas from one release-output tree.

    base holds build-script OUT_DIR sets (<hash>/out/
    memveil-ebpf-{attempt,lifecycle,copy}): every complete set
    must agree byte-for-byte, and the newest wins. Missing or
    divergent sets fail closed with an actionable cause.
    """
    try:
        names = sorted(os.listdir(str(base)))
    except OSError:
        raise ValueError(
            "missing release BPF artifacts under %s" % base)
    sets = [os.path.join(str(base), name, "out")
            for name in names
            if all(os.path.isfile(os.path.join(
                str(base), name, "out",
                "memveil-ebpf-" + channel))
                for channel in BPF_CHANNELS)]
    if not sets:
        raise ValueError(
            "no complete release BPF set under %s" % base)
    first = {channel: km.sha_file(os.path.join(
        sets[0], "memveil-ebpf-" + channel))
        for channel in BPF_CHANNELS}
    for other in sets[1:]:
        for channel in BPF_CHANNELS:
            if km.sha_file(os.path.join(
                    other, "memveil-ebpf-" + channel)) \
                    != first[channel]:
                raise ValueError(
                    "divergent release BPF sets: %s vs %s"
                    % (sets[0], other))
    newest = max(sets, key=lambda out: os.path.getmtime(
        os.path.join(out, "memveil-ebpf-attempt")))
    return {channel: km.sha_file(os.path.join(
        newest, "memveil-ebpf-" + channel))
        for channel in BPF_CHANNELS}


def check_scenario_inputs(deb, bpf_set=None):
    """Negative shas plus the staging record, after byte agreement.

    The deb's copy object and the reference copy bytes must both
    equal the candidate manifest's bpf copy entry. The reference
    is the sealed-commit fixture blob, or --scenario-bpf-set's
    complete pinned release-output set from outside this tree.
    Returns (neg_shas, staging). Raises ValueError on any gap;
    this tree's target/ is never consulted.
    """
    shas = scenario_negatives()
    manifest = scenario_manifest()
    sys.path.insert(0, str(ROOT / "tools"))
    import candidate
    digest = candidate.digest_bytes(
        candidate.canonical(manifest))
    try:
        commit = manifest["source"]["commit"]
    except (KeyError, TypeError):
        raise ValueError(
            "candidate manifest lacks the sealed source "
            "commit")
    want_copy = manifest_bpf_sha(manifest, "copy")
    if deb_copy_object_sha(deb) != want_copy:
        raise ValueError(
            "deb copy object differs from the candidate "
            "manifest bpf entry")
    if bpf_set is None:
        if sealed_fixture_sha(commit, "copy") != want_copy:
            raise ValueError(
                "sealed fixture blob differs from the "
                "candidate manifest bpf entry")
        staging = {"reference": "sealed-fixture",
                   "manifest_digest": digest,
                   "manifest_commit": commit,
                   "copy_sha256": want_copy,
                   "bpf_set": None}
        return shas, staging
    set_root = os.path.realpath(bpf_set)
    root_real = os.path.realpath(str(ROOT))
    if set_root == root_real \
            or set_root.startswith(root_real + os.sep):
        raise ValueError(
            "bpf set %s is inside this tree (build the "
            "release set outside it)" % bpf_set)
    got = release_set_shas(set_root)
    for channel in BPF_CHANNELS:
        if got[channel] != manifest_bpf_sha(manifest,
                                            channel):
            raise ValueError(
                "bpf set %s channel differs from the "
                "candidate manifest" % channel)
    staging = {"reference": "bpf-set",
               "manifest_digest": digest,
               "manifest_commit": commit,
               "copy_sha256": want_copy,
               "bpf_set": set_root}
    return shas, staging


def stage_scenario_files(export, job, neg_shas, deb=None,
                         rootfs=None, staging=None):
    """Copy negative objects into the export; extend the job.

    Under a selected rootfs also stages an exact deb copy into
    export/ro-deb (verified byte-for-byte after the copy) and
    rewrites job["deb"] to its read-only guest path, keeping the
    host path as job["deb_host"]. The staging record pins the deb
    bytes to the candidate manifest either way.
    """
    neg_dir = os.path.join(export, "neg")
    os.makedirs(neg_dir, exist_ok=True)
    for name in NEGATIVE_NAMES:
        src = ROOT / "build" / "bpf-negative" / (
            "swiotlb_copy-%s.bpf.o" % name)
        shutil.copy2(str(src), os.path.join(
            neg_dir, "swiotlb_copy-%s.bpf.o" % name))
    job["negatives"] = dict(neg_shas)
    if staging is not None:
        job["staging"] = dict(staging)
    if rootfs is None:
        return
    if not deb:
        raise ValueError(
            "scenario rootfs run needs the deb path")
    base = os.path.basename(deb)
    if not base or base in (".", ".."):
        raise ValueError("bad deb basename: %r" % deb)
    dest_dir = os.path.join(export, STAGE_DEB_DIRNAME)
    os.makedirs(dest_dir, exist_ok=True)
    dest = os.path.join(dest_dir, base)
    expect = km.sha_file(deb)
    shutil.copy2(deb, dest)
    if km.sha_file(dest) != expect:
        raise ValueError(
            "staged deb copy differs from %s" % deb)
    job["deb_host"] = deb
    job["deb"] = "%s/%s" % (SCENARIO_GUEST_DEBDIR, base)
    job["rootfs"] = {"image": rootfs["image"],
                     "sha256": rootfs["sha256"],
                     "mount": rootfs["mount"]}
    record = {"image": rootfs["image"],
              "sha256": rootfs["sha256"],
              "mount": rootfs["mount"],
              "privilege": rootfs.get("privilege"),
              "runner_commit": rootfs.get("runner_commit"),
              "runner_dirty": rootfs.get("runner_dirty"),
              "staging": dict(staging) if staging else None}
    Path(export, "rootfs.json").write_text(
        json.dumps(record, indent=2, sort_keys=True) + "\n")


# Evidence identity: scenario boots under --scenario-rootfs run a NEW
# runner identity (runner commit + rootfs digest + effective vng argv,
# all recorded per row). They count toward a frozen gate only via a
# reviewed amendment or next-seal integration plus an affected-gate
# rerun.
#
# Guest share placement: flat depth-1 siblings directly under
# /tmp (/tmp/mv-repo for the repo, /tmp/mv-deb for the staged
# deb), never nested under a shared intermediate parent. The vng
# guest init only materializes a share whose parent directory
# already exists: a nested guest path with an absent
# intermediate parent is skipped silently - no mountpoint is
# created, no 9p session starts, nothing is logged, and later
# shares still mount. Diagnosed live: a nested two-level guest
# path never mounted while a flat sibling in the same boot did (mount
# diagnosis boots 1, 2, and 4; 9p session counts matched the
# mounted shares exactly, with no EROFS anywhere). /tmp itself
# stays required: it is in vng's default overlay set in both
# its rw and non-rw branches, so the mountpoint lands on the
# overlay upper. A shared parent would also collide with the
# guest's local evidence staging in that same directory. The guest
# command runs a mount guard first that fails fast with the
# exact missing share (exit 42) instead of a bare python
# ENOENT.
SCENARIO_GUEST_REPO = "/tmp/mv-repo"
SCENARIO_GUEST_DEBDIR = "/tmp/mv-deb"
SCENARIO_GUEST_EXPORT = "/tmp/export"
SCENARIO_GUEST_SCRIPT = "tests/vm/kernel_scenarios_guest.py"
SCENARIO_MOUNT_GUARD_EXIT = 42
STAGE_DEB_DIRNAME = "ro-deb"


def scenario_cli_state(args):
    """Scenario-only flag state, after pair validation.

    Returns None in matrix mode (all three flags ignored) or the
    {"rootfs_image", "rootfs_sha256", "bpf_set"} state in scenario
    mode. Raises ValueError on a half-given rootfs pair.
    """
    if not args.scenarios:
        return None
    if bool(args.scenario_rootfs) \
            != bool(args.scenario_rootfs_sha256):
        raise ValueError("--scenario-rootfs needs "
                         "--scenario-rootfs-sha256 (and vice "
                         "versa)")
    return {"rootfs_image": args.scenario_rootfs,
            "rootfs_sha256": args.scenario_rootfs_sha256,
            "bpf_set": args.scenario_bpf_set}


def verify_scenario_rootfs(image, expected):
    """Resolved image identity after existence + digest checks.

    Returns {"image": abspath, "sha256": hex}. Raises ValueError
    when the file is missing or unreadable, the expected digest
    is malformed, or the bytes differ. Mounts nothing.
    """
    expect = (expected or "").strip().lower()
    if len(expect) != 64 \
            or any(char not in "0123456789abcdef"
                   for char in expect):
        raise ValueError("bad --scenario-rootfs-sha256: need "
                         "64 hex chars")
    if not image or not os.path.isfile(image):
        raise ValueError(
            "missing scenario rootfs image: %s" % image)
    try:
        digest = km.sha_file(image)
    except OSError as exc:
        raise ValueError(
            "cannot hash scenario rootfs image %s: %s"
            % (image, exc))
    if digest != expect:
        raise ValueError(
            "scenario rootfs digest mismatch: image %s "
            "hashes %s, want %s" % (image, digest, expect))
    return {"image": os.path.abspath(image),
            "sha256": digest}


def mount_scenario_rootfs(image, mnt_dir, use_sudo):
    """Loop-mount the verified image read-only at mnt_dir.

    Raises ValueError on any failure, mounting nothing on the
    error paths. The read-only mount keeps the sealed bytes
    intact while the guest writes through its overlays.
    """
    if os.path.ismount(mnt_dir):
        raise ValueError("stale rootfs mount at %s (umount "
                         "before reuse)" % mnt_dir)
    try:
        os.makedirs(mnt_dir, exist_ok=True)
    except OSError as exc:
        raise ValueError(
            "cannot create rootfs mount point %s: %s"
            % (mnt_dir, exc))
    try:
        crowded = os.listdir(mnt_dir)
    except OSError as exc:
        raise ValueError(
            "cannot list rootfs mount point %s: %s"
            % (mnt_dir, exc))
    if crowded:
        raise ValueError(
            "rootfs mount point not empty: %s" % mnt_dir)
    argv = ["mount", "-o", "loop,ro", image, mnt_dir]
    if use_sudo:
        argv = ["sudo", "-n"] + argv
    try:
        proc = subprocess.run(argv, capture_output=True,
                              text=True, timeout=120)
    except subprocess.TimeoutExpired:
        raise ValueError(
            "rootfs mount timed out: %s" % image)
    except OSError as exc:
        raise ValueError("cannot run mount: %s" % exc)
    if proc.returncode != 0:
        detail = ((proc.stderr or "")
                  + (proc.stdout or "")).strip()[:300]
        raise ValueError("rootfs loop mount failed: %s"
                         % (detail or "exit %d"
                            % proc.returncode))


def umount_scenario_rootfs(mnt_dir, use_sudo):
    """Best-effort unmount; None on success, error text otherwise.

    Never raises: cleanup failures are recorded, never thrown
    from the row loop's finally block.
    """
    argv = ["umount", mnt_dir]
    if use_sudo:
        argv = ["sudo", "-n"] + argv
    try:
        proc = subprocess.run(argv, capture_output=True,
                              text=True, timeout=60)
    except subprocess.TimeoutExpired:
        return "umount timed out"
    except OSError as exc:
        return "cannot run umount: %s" % exc
    except Exception as exc:
        return "umount failed: %s" % exc
    if proc.returncode != 0:
        detail = ((proc.stderr or "")
                  + (proc.stdout or "")).strip()[:300]
        return detail or "exit %d" % proc.returncode
    return None


def scenario_mount_guard(deb_marker=None):
    """POSIX shell guard proving the scenario 9p shares.

    Always prints the mount table (captured into the row
    console.txt, which is the live mount probe's evidence),
    then requires each share dir to exist and to be listed
    in the table, the repo marker script to be a file, and
    the staged deb marker when one is given. On any miss it
    records "scenario mounts missing: ..." in the export
    FAIL.txt (already surfaced into the row detail by the
    collector) and exits SCENARIO_MOUNT_GUARD_EXIT; the
    table itself stays on stdout (console.txt) to keep the
    command short. On success the guard falls through
    with status 0 so the caller chains the real command
    after a ";". SCENARIO_REPO, SCENARIO_DEBDIR,
    SCENARIO_EXPORT, and SCENARIO_MOUNTS_FILE override the
    baked guest paths (unset in the guest) so unarmed tests
    execute this exact text under sh with mocked mounts.
    Keep it short: vng base64-encodes the whole guest
    command onto the 2048-byte kernel command line.
    """
    parts = [
        "r=${SCENARIO_REPO:-%s}" % SCENARIO_GUEST_REPO,
        "b=${SCENARIO_DEBDIR:-%s}" % SCENARIO_GUEST_DEBDIR,
        "e=${SCENARIO_EXPORT:-%s}" % SCENARIO_GUEST_EXPORT,
        "m=${SCENARIO_MOUNTS_FILE:-/proc/mounts}",
        "t=$(cat \"$m\" 2>/dev/null||true)",
        "printf '%s\\n' \"$t\"",
        "s=''",
        "for d in \"$r\" \"$b\";do "
        "[ -d \"$d\" ]||{ s=\"$s $d\";continue; };"
        "case \"$t\" in *\" $d \"*);;"
        "*)s=\"$s $d(unmounted)\";;esac;done",
        "[ -f \"$r/%s\" ]||s=\"$s $r/%s\""
        % (SCENARIO_GUEST_SCRIPT, SCENARIO_GUEST_SCRIPT),
    ]
    if deb_marker is not None:
        parts.append("[ -f \"$b/%s\" ]||s=\"$s $b/%s\""
                     % (deb_marker, deb_marker))
    parts.append(
        "[ -z \"$s\" ]||{ g=\"scenario mounts missing:$s\";"
        "echo \"$g\";echo \"$g\">\"$e/FAIL.txt\""
        " 2>/dev/null||true;exit %d;}"
        % SCENARIO_MOUNT_GUARD_EXIT)
    return ";".join(parts)


# Deb basenames the mount guard embeds raw in its marker
# check; mirrors the row-receipt staged-deb name shape, so a
# name the receipt would refuse never reaches the shell.
_DEB_MARKER_RE = "[A-Za-z0-9][A-Za-z0-9+_~.-]*\\.deb"


def scenario_guest_cmd(deb=None):
    """Guest-side scenario command under the selected rootfs.

    The repo reaches the guest through a read-only --rodir at
    SCENARIO_GUEST_REPO, so the guest-visible layout mirrors the
    shared-host-rootfs shape exactly (script plus REPO), with no
    host absolute path left for the guest to resolve. A mount
    guard runs first and fails fast with the exact missing
    share; deb, when it names a staged guest deb path, adds
    its basename as a second marker file check.
    """
    marker = None
    if isinstance(deb, str) \
            and deb.startswith(SCENARIO_GUEST_DEBDIR + "/"):
        base = deb[len(SCENARIO_GUEST_DEBDIR) + 1:]
        if "/" not in base and re.fullmatch(_DEB_MARKER_RE,
                                            base):
            marker = base
    tail = "python3 %s %s %s" % (
        shlex.quote("%s/%s" % (SCENARIO_GUEST_REPO,
                               SCENARIO_GUEST_SCRIPT)),
        shlex.quote(SCENARIO_GUEST_EXPORT),
        shlex.quote(SCENARIO_GUEST_REPO))
    return "%s;%s" % (scenario_mount_guard(marker), tail)


def scenario_rootfs_vng_args(mount, deb_stage_dir):
    """Extra vng argv elements for scenario boots under --root.

    mount and deb_stage_dir are absolute host paths. --cwd pins
    the guest start to the root (verified in the pinned vng
    source: relpath "."), matching the twice-proven live shape
    where the host cwd sits inside the root; the runner also
    spawns from inside the mount. The repo and the staged deb
    each arrive through an explicit read-only --rodir; the
    bpftrace/bpftool host paths in job.json stay recorded but
    unresolved, since the scenario guest never reads them.
    Both guest share points must sit under a vng overlay
    (/tmp here): the guest root is read-only, so a share
    outside every overlay never gets its mountpoint.
    """
    return ["--root", mount,
            "--cwd", mount,
            "--rodir=%s=%s" % (SCENARIO_GUEST_REPO,
                               str(ROOT)),
            "--rodir=%s=%s" % (SCENARIO_GUEST_DEBDIR,
                               deb_stage_dir)]


def scenario_rootfs_mnt_dir(out):
    """Sibling scratch dir for the scenario rootfs mount.

    The mountpoint sits BESIDE --out, never under it: the
    row enumerator scans --out subdirs as rows, so a mount
    dir inside --out would read as a row without evidence.
    Stale reuse still refuses (see mount_scenario_rootfs).
    """
    base = os.path.abspath(out)
    return os.path.join(os.path.dirname(base),
                        os.path.basename(base)
                        + "-rootfs-mnt")


def remove_scenario_mountpoint(mnt):
    """Best-effort removal of the emptied mountpoint.

    Returns None on success (or when already gone), else a
    short note; never raises. A live mount is always kept:
    only call after a successful umount, and let the next
    run's stale detection refuse if cleanup failed.
    """
    if os.path.ismount(mnt):
        return "still mounted: %s" % mnt
    try:
        os.rmdir(mnt)
    except FileNotFoundError:
        return None
    except OSError as exc:
        return "cannot remove mount point %s: %s" % (mnt,
                                                     exc)
    return None


def teardown_scenario_rootfs_mount(mnt, use_sudo,
                                   umount=umount_scenario_rootfs):
    """Umount then remove the scenario rootfs mountpoint.

    Returns (umount_note, remove_note), each None on its
    success. Removal runs only after a clean umount, so a
    failed umount keeps the live mount for the next run's
    stale detection to refuse; never raises.
    """
    note = umount(mnt, use_sudo)
    if note is not None:
        return note, None
    return None, remove_scenario_mountpoint(mnt)


def run_check_doctor(path):
    """True when validate-schemas accepts one doctor document."""
    if not os.path.isfile(path):
        return False
    try:
        proc = subprocess.run(
            [str(ROOT / "tools" / "validate-schemas"),
             "--check-doctor", path],
            capture_output=True, text=True,
            timeout=CAPTURE_TIMEOUT)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return proc.returncode == 0


def validate_capture_dir(capdir):
    """Validator exit for one capture dir, None when missing."""
    if not os.path.isdir(capdir):
        return None
    try:
        proc = subprocess.run(
            [str(ROOT / "tools" / "validate-schemas"),
             capdir],
            capture_output=True, text=True,
            timeout=CAPTURE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return 99
    except OSError:
        return 99
    return proc.returncode


def gather_scenario_ev(export, name, negs, base_verdict):
    """Evidence dict for one scenario directory."""
    sdir = os.path.join(export, "scn-" + name)

    def read(leaf):
        return read_text(os.path.join(sdir, leaf))

    def load_json(leaf):
        try:
            return json.loads(read(leaf) or "")
        except ValueError:
            return None

    spec = ks.SCENARIOS[name]
    capture = None
    if spec.get("capture") is not None:
        capdir = os.path.join(sdir, "cap")
        capture = {
            "events_text": read_text(os.path.join(
                capdir, "events.ndjson")),
            "session_text": read_text(os.path.join(
                capdir, "session.json")),
            "report_json_text": read("report.json"),
            "report_text": read("report.txt"),
            "workload_out": read("workload.out"),
            "workload_exit": read("workload.exit"),
            "validate_rc": validate_capture_dir(capdir),
            "object_sha": negs.get(spec.get("negative")),
        }
    memcg = None
    if name == "memcg":
        memcg = load_json("memcg.json")
    return {
        "passive": {"text": read("doctor-passive.json"),
                    "exit": read("doctor-passive.exit")},
        "load": {"text": read("doctor-load.json"),
                 "exit": read("doctor-load.exit")},
        "record": {"out": read("record.out"),
                   "exit": read("record.exit"),
                   "exists": read("record.exists")},
        "passive_schema": run_check_doctor(os.path.join(
            sdir, "doctor-passive.json")),
        "load_schema": run_check_doctor(os.path.join(
            sdir, "doctor-load.json")),
        "precondition": load_json("precondition.json"),
        "teardown": load_json("teardown.json"),
        "base_verdict": base_verdict,
        "capture": capture,
        "memcg": memcg,
        "job_negatives": dict(negs),
    }


def _scenario_receipt_shape(rec):
    """Three-key scenario record the row receipt admits.

    The judge verdict flag duplicates the status word
    (ok exactly when the status is ok), so the record
    keeps the name, status, and checks the receipt
    grammar carries.
    """
    return {"name": rec["name"], "status": rec["status"],
            "checks": rec["checks"]}


def collect_scenarios(entry, export, tools, elapsed, run_id,
                      timeout, cache_dir):
    """Judge every scenario of one booted row."""
    ident = entry["id"]
    try:
        job = json.loads(Path(export, "job.json")
                         .read_text())
    except (OSError, ValueError):
        job = {}
    negs = job.get("negatives", {})
    base_verdict = None
    try:
        base_pre = json.loads(Path(
            export, "scn-base",
            "precondition.json").read_text())
        base_verdict = base_pre.get("verdict")
    except (OSError, ValueError, AttributeError):
        base_verdict = None
    named = []
    for name in ks.SCENARIO_ORDER:
        try:
            ev = gather_scenario_ev(export, name, negs,
                                    base_verdict)
            rec = ks.evaluate_scenario(name, ev)
        except Exception as exc:
            rec = {"name": name, "ok": False,
                   "status": "fail",
                   "checks": [{"name": "precondition",
                               "ok": False,
                               "detail": "scenario decision "
                                         "crashed: %s" % exc,
                               "skipped": False}]}
        named.append((name, rec))
    try:
        results = ks.evaluate_run(named)
    except Exception as exc:
        return {"id": ident, "mode": "scenarios", "ok": False,
                "run_id": run_id,
                "detail": "run decision crashed: %s" % exc,
                "elapsed": round(elapsed, 1),
                "scenarios": [_scenario_receipt_shape(rec)
                              for _, rec in named]}
    ok, detail = ks.scenarios_verdict(results)
    fail_txt = read_text(os.path.join(export, "FAIL.txt"))
    if fail_txt is not None:
        ok = False
        detail += "; guest FAIL: %s" % fail_txt.strip()[:200]
    if timeout:
        ok = False
        detail += "; vng timeout"
    binary_sha = None
    try:
        artifacts = json.loads(Path(
            export, "artifacts.json").read_text())
        binary_sha = artifacts["binary"]["sha256"]
    except (OSError, ValueError, KeyError, TypeError):
        binary_sha = None
    # A row whose guest never ran (the mount guard tripped
    # before the guest wrote artifacts) carries no negatives:
    # the receipt refuses negatives without guest evidence, so
    # the job pins stay in job.json while the rec omits them
    # and the row can receipt its failure. The guest-ran check
    # is file presence, mirroring the receipt exactly; the
    # FAIL.txt detail above keeps the failure loud.
    guest_ran = Path(export, "artifacts.json").is_file()
    return {"id": ident, "mode": "scenarios", "ok": ok,
            "detail": detail, "run_id": run_id,
            "vng_version": km.row_boot_label(entry),
            "release": entry["release"],
            "elapsed": round(elapsed, 1),
            "binary_sha256": binary_sha,
            "negatives": dict(negs) if guest_ran else {},
            "scenarios": [_scenario_receipt_shape(res)
                          for res in results]}


def write_scenario_summary(out, merged):
    lines = ["kernel vng scenarios verdict run"]
    for rec in merged:
        results = rec.get("scenarios", [])
        ok_count = sum(1 for res in results
                       if res.get("status") == "ok")
        fail_count = sum(1 for res in results
                         if res.get("status") == "fail")
        np_count = sum(1 for res in results
                       if res.get("status") == "not_proven")
        lines.append("%s %s ok=%d fail=%d not_proven=%d %s "
                     "run=%s" % (
                         rec.get("id"),
                         rec.get("vng_version", "?"),
                         ok_count, fail_count, np_count,
                         "PASS" if rec.get("ok") else "FAIL",
                         rec.get("run_id", "?")))
        for res in results:
            lines.append("  %s: %s" % (
                res.get("name"), res.get("status")))
    Path(out, "summary.txt").write_text("\n".join(lines)
                                       + "\n")
    Path(out, "summary.json").write_text(
        json.dumps(merged, indent=2, sort_keys=True) + "\n")
    print("\n".join(lines))


def write_summary(out, merged):
    lines = ["kernel vng doctor record report channels "
             "detail/aggregate verdict run"]
    for rec in merged:
        chans = rec.get("channels")
        if isinstance(chans, dict):
            chan_txt = ",".join("%s=%s" % (k, v.split()[0])
                                for k, v in sorted(chans.items()))
        else:
            chan_txt = "-"
        lines.append("%s %s doctor=%s record=%s report=%s %s %s %s "
                     "run=%s" % (
                         rec.get("id"), rec.get("vng_version", "?"),
                         "ok" if rec.get("doctor_ok") else "BAD",
                         rec.get("record_exit", "?"),
                         rec.get("report_exit", "?"), chan_txt,
                         (rec.get("detail_quality", "-") or "-")[:60],
                         "PASS" if rec.get("ok") else "FAIL",
                         rec.get("run_id", "?")))
    Path(out, "summary.txt").write_text("\n".join(lines) + "\n")
    Path(out, "summary.json").write_text(
        json.dumps(merged, indent=2, sort_keys=True) + "\n")
    print("\n".join(lines))


def load_old_summary(out):
    """Prior summary rows, refusing stale or corrupt state.

    Returns (rows, None); a missing summary is ([], None).
    An unparseable summary or a summary row without its
    evidence dir returns (None, reason): merges never carry
    verdicts whose evidence is gone.
    """
    summary_path = Path(out, "summary.json")
    if not summary_path.exists():
        return [], None
    try:
        old = json.loads(summary_path.read_text())
        if not isinstance(old, list):
            raise ValueError("summary is not a list")
    except ValueError:
        return None, "existing summary unparseable, " \
            "refusing to merge"
    stale = []
    for row in old:
        ident = row.get("id") if isinstance(row, dict) \
            else None
        if not isinstance(ident, str) or not ident \
                or not os.path.isdir(
                    os.path.join(out, ident)):
            stale.append(ident)
    if stale:
        return None, \
            "summary rows without evidence dirs (%s), " \
            "refusing to merge" % ", ".join(
                sorted(str(ident) for ident in stale))
    return old, None


def build_parser():
    """CLI parser for the matrix/scenario runner."""
    parser = argparse.ArgumentParser(
        description="Boot matrix kernels and prove the generations "
                    "table. MV_HOST_CPUS pins the host CPU set "
                    "through taskset; unset runs without taskset. "
                    "Qualification runs need both MV_BUNDLE_TARBALL "
                    "and MV_CANDIDATE_MANIFEST set; either one "
                    "alone refuses before booting.")
    parser.add_argument("--out", required=True,
                        help="evidence parent dir (per-kernel subdirs)")
    group = parser.add_mutually_exclusive_group(required=True)
    group.add_argument("--kernel", help="one lock id to run")
    group.add_argument("--kernels",
                       help="comma-separated lock ids, in order")
    group.add_argument("--all", action="store_true",
                       help="run every lock entry")
    group.add_argument("--verify-out", action="store_true",
                       help="re-derive every row receipt under "
                            "--out instead of booting")
    parser.add_argument("--lock", default=str(
        ROOT / "tests" / "vm" / "kernels.lock.json"),
                        help="kernels lock path")
    parser.add_argument("--deb", default=os.environ.get("MV_DEB"),
                        help="memveil .deb to install (or MV_DEB); "
                             "needs a Debian guest rootfs")
    parser.add_argument("--bundle",
                        help="owner bundle dir with bin/memveil "
                             "(tarball bundle; the path for "
                             "non-Debian guest rootfs)")
    parser.add_argument("--disk-img",
                        help="NVMe backing image (created if missing)")
    parser.add_argument("--duration", type=int, default=60,
                        help="record duration seconds")
    parser.add_argument("--dd-count", type=int, default=128,
                        help="MB per dd read")
    parser.add_argument("--timeout", type=int, default=900,
                        help="per-kernel timeout seconds")
    parser.add_argument("--cpus", type=int, default=4,
                        help="guest vCPUs (at most 4)")
    parser.add_argument("--scenarios", action="store_true",
                        help="run detection scenarios, not the "
                             "matrix")
    # New evidence identity: scenario boots under --scenario-rootfs
    # count toward a frozen gate only via a reviewed amendment or
    # next-seal integration plus an affected-gate rerun.
    parser.add_argument("--scenario-rootfs",
                        help="Debian guest rootfs image for "
                             "scenario runs only (verified by "
                             "digest, loop-mounted read-only, "
                             "passed as vng --root; ignored "
                             "without --scenarios)")
    parser.add_argument("--scenario-rootfs-sha256",
                        help="expected sha256 of "
                             "--scenario-rootfs")
    parser.add_argument("--scenario-bpf-set",
                        help="release-output tree holding the "
                             "pinned BPF sets for scenario "
                             "staging, outside this checkout "
                             "(sealed fixture blob when unset; "
                             "ignored without --scenarios)")
    parser.add_argument("--export-tested",
                        help="write tested payload after every "
                             "locked row re-derives")
    parser.add_argument("--evidence-dir",
                        help="qualification evidence dir for "
                             "--export-tested")
    parser.add_argument("--qualification",
                        help="qualification JSON for "
                             "--export-tested")
    parser.add_argument("--policy",
                        help="candidate policy JSON for "
                             "--export-tested")
    parser.add_argument("--source-tree", default=".",
                        help="source checkout for the "
                             "--export-tested matrix lock check")
    return parser


def main(argv=None):
    parser = build_parser()
    args = parser.parse_args(argv)
    if args.export_tested and not args.verify_out:
        parser.error("--export-tested requires --verify-out")
    if args.verify_out:
        if args.export_tested:
            sys.path.insert(0, str(ROOT / "tools"))
            import candidate
            try:
                if not args.evidence_dir \
                        or not args.qualification \
                        or not args.policy:
                    parser.error("--export-tested requires "
                                 "--evidence-dir, --qualification "
                                 "and --policy")
                manifest = candidate.load_manifest(
                    os.environ["MV_CANDIDATE_MANIFEST"])
                verify_lock_matches_checkout(
                    args.lock, manifest["source"]["commit"],
                    args.source_tree)
                lock = candidate.read_json(args.lock)
                km.parse_lock_bytes(Path(args.lock).read_bytes())
                inputs = _matrix_inputs_for_export(
                    args.evidence_dir, args.qualification)
                matrix_dir = inputs.get("matrix_directory") \
                    if isinstance(inputs, dict) else None
                if not isinstance(matrix_dir, str) \
                        or not matrix_dir:
                    raise ValueError(
                        "export needs a matrix directory")
                if Path(args.evidence_dir, matrix_dir).resolve() \
                        != Path(args.out).resolve():
                    raise ValueError(
                        "export out dir is not the qualified "
                        "matrix directory")
                candidate.verify_evidence_inventory(
                    inputs, args.evidence_dir)
                candidate.verify_qualification(
                    os.environ["MV_CANDIDATE_MANIFEST"],
                    args.qualification, args.policy,
                    args.evidence_dir,
                    source_tree=args.source_tree)
                km.export_tested_candidate(
                    args.out, lock, manifest, args.export_tested)
            except (OSError, ValueError, KeyError) as error:
                print("kernel-matrix: tested export refused: "
                      + str(error), file=sys.stderr)
                return 1
            return 0
        report = km.verify_matrix_out(args.out)
        for row in report["rows"]:
            print("kernel-matrix: verify %s %s: %s" % (
                row["id"], "PASS" if row["ok"] else "FAIL",
                row["detail"]))
        for problem in report["problems"]:
            print("kernel-matrix: verify refused: %s" % problem,
                  file=sys.stderr)
        if report["ok"]:
            print("kernel-matrix: verify %d rows re-derived"
                  % len(report["rows"]))
        return 0 if report["ok"] else 1
    try:
        selected_candidate = select_candidate_inputs(args)
    except (OSError, ValueError) as error:
        print("kernel-matrix: candidate refused: " + str(error),
              file=sys.stderr)
        return 2
    if args.cpus < 1 or args.cpus > 4:
        print("kernel-matrix: --cpus must be 1..4", file=sys.stderr)
        return 2
    try:
        lock = km.parse_lock(args.lock)
    except km.LockError as exc:
        print("kernel-matrix: bad lock: %s" % exc, file=sys.stderr)
        return 2
    entries = lock["kernels"]
    if args.kernel:
        entries = [e for e in entries if e["id"] == args.kernel]
        if not entries:
            print("kernel-matrix: unknown kernel %s" % args.kernel,
                  file=sys.stderr)
            return 2
    if args.kernels:
        try:
            entries = km.select_kernel_ids(entries, args.kernels)
        except ValueError as exc:
            print("kernel-matrix: bad --kernels: %s" % exc,
                  file=sys.stderr)
            return 2
    try:
        kind, source = km.resolve_inputs(args.deb, args.bundle)
    except ValueError as exc:
        print("kernel-matrix: %s" % exc, file=sys.stderr)
        return 2
    if args.scenarios and kind != "deb":
        print("kernel-matrix: --scenarios needs --deb",
              file=sys.stderr)
        return 2
    if kind == "deb":
        if not os.path.isfile(source):
            print("kernel-matrix: missing deb %s" % source,
                  file=sys.stderr)
            return 2
        source = str(Path(source).resolve())
    else:
        cand = Path(source) / "bin" / "memveil"
        if not cand.is_file():
            print("kernel-matrix: missing %s" % cand,
                  file=sys.stderr)
            return 2
        source = str(cand.resolve())
    neg_shas = {}
    staging = None
    rootfs_spec = None
    if args.scenarios:
        try:
            cli = scenario_cli_state(args)
        except ValueError as exc:
            print("kernel-matrix: %s" % exc, file=sys.stderr)
            return 2
        try:
            neg_shas, staging = check_scenario_inputs(
                source, bpf_set=cli["bpf_set"])
        except ValueError as exc:
            print("kernel-matrix: %s" % exc, file=sys.stderr)
            return 2
        if cli["rootfs_image"] is not None:
            try:
                rootfs_spec = verify_scenario_rootfs(
                    cli["rootfs_image"], cli["rootfs_sha256"])
            except ValueError as exc:
                print("kernel-matrix: %s" % exc, file=sys.stderr)
                return 2
        for entry in entries:

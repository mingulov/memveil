def select_candidate_inputs(args):
    sys.path.insert(0, str(ROOT / "tests"))
    from support import candidate_input
    if not candidate_input.requested():
        return None
    selected = candidate_input.load(required=True)
    if args.deb and args.bundle:
        raise ValueError("candidate qualification forbids "
                         "competing package overrides")
    if args.deb:
        expected = selected.artifact("deb")
        if Path(args.deb).resolve() != expected.resolve():
            raise ValueError("candidate qualification forbids "
                             "foreign --deb override")
        candidate_input.candidate.verify_file(
            args.deb, candidate_input.candidate.artifact(
                selected.manifest, "deb"))
    if args.bundle:
        root = Path(args.bundle)
        candidate = candidate_input.candidate
        bundled = candidate.verify_bundle_dir(root)
        if (bundled["manifest_sha256"]
                != selected.manifest["bundle_manifest_sha256"]
                or bundled["files"]
                != selected.manifest["files"]):
            raise ValueError("candidate qualification forbids "
                             "foreign --bundle override")
    if args.scenarios or args.deb:
        args.deb, args.bundle = str(selected.artifact("deb")), None
    else:
        args.bundle = str(selected.root)
    return selected


def verify_lock_matches_checkout(lock_path, commit, source_root):
    """Refuse unless the presented lock bytes equal C's lock bytes.

    The checkout must carry the candidate source commit C, whose
    tests/vm/kernels.lock.json bytes must equal the presented
    lock file byte for byte. Raises ValueError otherwise.
    """
    try:
        presented = Path(lock_path).read_bytes()
    except OSError as error:
        raise ValueError("matrix lock unreadable: %s"
                         % error) from error
    try:
        proc = subprocess.run(
            ["git", "-C", str(source_root), "show",
             "%s:tests/vm/kernels.lock.json" % commit],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    except OSError as error:
        raise ValueError("cannot read the checkout lock: %s"
                         % error) from error
    if proc.returncode != 0:
        raise ValueError("checkout has no matrix lock at "
                         + str(commit))
    if proc.stdout != presented:
        raise ValueError("matrix lock differs from C")
    return None


def _matrix_inputs_for_export(evidence_dir, qualification_path):
    """Parsed matrix inputs the qualification binds, for export.

    Resolves the matrix gate receipt through the qualification
    the same way qualification verification does; the signature
    over these bytes is verified by the qualification step that
    follows, so this loader only locates and parses them.
    """
    sys.path.insert(0, str(ROOT / "tools"))
    import candidate
    doc = candidate.read_json(qualification_path, sealed=True)
    try:
        gate = doc["gates"][candidate.MATRIX_GATE]
        receipt_name = gate["receipt"]
        record = candidate.read_json(
            Path(evidence_dir)
            / candidate.relative(receipt_name),
            sealed=True)
        inputs_name = record["inputs"]
        return candidate.read_json(
            Path(evidence_dir)
            / candidate.relative(inputs_name),
            sealed=True)
    except (KeyError, TypeError) as error:
        raise ValueError(
            "export needs qualified matrix inputs") from error


def find_vng():
    cand = os.environ.get("VNG")
    if cand:
        return cand
    found = shutil.which("vng")
    if found:
        return found
    home = Path.home() / ".local" / "bin" / "vng"
    if home.exists():
        return str(home)
    return None


def ensure_disk(path, size_gb=4):
    p = Path(path)
    if p.exists():
        if not p.is_file():
            raise ValueError("disk image is not a file: %s" % path)
        return str(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(["truncate", "-s", "%dG" % size_gb, str(p)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise ValueError("cannot create disk image: %s" % proc.stderr)
    return str(p)


def ensure_scratch(disk_img, ident):
    path = Path(km.scratch_img_path(disk_img, ident))
    if path.exists():
        if not path.is_file() or path.is_symlink():
            raise ValueError("scratch image is not a file: %s"
                             % path)
        path.unlink()
    path.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(["truncate", "-s", "64M", str(path)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise ValueError("cannot create scratch image: %s"
                         % proc.stderr)
    return str(path)


def verify_cache(entry):
    home = str(Path.home())
    ok, msg, target = km.verify_entry_cache(home, entry)
    if not ok:
        return False, msg, None, None
    return True, msg, km.entry_cache_dir(home, entry), target


def download_cache(vng_path, ver):
    try:
        proc = subprocess.run(km.vng_download_cmd(vng_path, ver),
                              capture_output=True, text=True,
                              timeout=900)
    except subprocess.TimeoutExpired:
        return False, "download timed out for %s" % ver
    if proc.returncode != 0:
        return False, "download failed for %s: %s" % (
            ver, (proc.stderr or "").strip()[:300])
    return True, "downloaded"


def read_text(path):
    try:
        return Path(path).read_text()
    except OSError:
        return None


def gather_miss_snaps(export, count=4):
    if not os.path.isdir(export):
        return None
    try:
        times = json.loads(Path(
            export, "progs_times.json").read_text())
    except (OSError, ValueError):
        times = {}
    snaps = []
    for idx in range(count):
        try:
            nsecs = int(times[str(idx)])
        except (KeyError, TypeError, ValueError):
            nsecs = None
        snaps.append((nsecs, read_text(
            os.path.join(export, "progs%d.json" % idx))))
    return snaps


def _retain_validation(export, rc, out):
    """Retain one validation outcome; note when it cannot be.

    Writes the validate.txt transcript plus the validate.json
    {rc, out} record the cache/raw check compares against. A
    record that cannot be written is noted in the returned
    outcome, which downstream refuses for lack of retained
    bytes.
    """
    out = out + _write_transcript(export, out)
    try:
        Path(export, "validate.json").write_text(
            json.dumps({"rc": rc, "out": out}) + "\n")
    except OSError as exc:
        return rc, out + "\n[validate record unwritten: %s]" \
            % exc
    return rc, out


def run_validator(export):
    cap = os.path.join(export, "cap")
    if not os.path.isdir(cap):
        return None, None
    try:
        proc = subprocess.run(
            [str(ROOT / "tools" / "validate-schemas"), cap],
            capture_output=True, text=True,
            timeout=CAPTURE_TIMEOUT)
    except subprocess.TimeoutExpired:
        return _retain_validation(
            export, 99, "validate-schemas timed out")
    out = ((proc.stdout or "") + (proc.stderr or "")).strip()
    return _retain_validation(export, proc.returncode,
                              out[-2000:])


def _write_transcript(export, out):
    try:
        Path(export, "validate.txt").write_text(out + "\n")
    except OSError as exc:
        return "\n[transcript unwritten: %s]" % exc
    return ""


def chown_guest_tree(path):
    """Chown one guest-written tree to us, or an error.

    Guest files land root-owned through sudo vng; the
    host must own the busy tree before it writes the
    validate transcript, the events summary, and the
    post-evaluation unlink.
    """
    proc = subprocess.run(
        ["sudo", "-n", "chown", "-R",
         "%d:%d" % (os.getuid(), os.getgid()), path],
        capture_output=True, text=True)
    if proc.returncode != 0:
        return (proc.stderr or "").strip() or \
            "chown rc=%d" % proc.returncode
    return None


def gather_persisted(export):
    path = os.path.join(export, "cap", "events.ndjson")
    try:
        with open(path) as handle:
            counts = km.persisted_counts(handle)
        with open(path) as handle:
            byts = km.persisted_bytes(handle)
        with open(path) as handle:
            dirs = km.persisted_copy_dirs(handle)
        return counts, byts, dirs, None
    except OSError:
        return None, None, None, "missing events.ndjson"
    except ValueError as exc:
        return None, None, None, str(exc)


def gather_counters(export):
    path = os.path.join(export, "cap", "events.ndjson")
    try:
        with open(path) as handle:
            return km.counter_deltas(handle), None
    except OSError:
        return None, "missing events.ndjson"
    except ValueError as exc:
        return None, str(exc)


def gather_unpaired(export):
    path = os.path.join(export, "cap", "events.ndjson")
    try:
        with open(path) as handle:
            count, nbytes = km.unpaired_maps(handle)
        return (count, nbytes), None
    except OSError:
        return (None, None), "missing events.ndjson"
    except ValueError as exc:
        return (None, None), str(exc)



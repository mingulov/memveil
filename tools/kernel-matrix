CAPTURE_TIMEOUT = 300


def find_vng():
    cand = os.environ.get("VNG")
    if cand:
        return cand
    found = shutil.which("vng")
    if found:
        return found
    home = Path.home() / ".local" / "bin" / "vng"
    if home.exists():
        return str(home)
    return None


def ensure_disk(path, size_gb=4):
    p = Path(path)
    if p.exists():
        if not p.is_file():
            raise ValueError("disk image is not a file: %s" % path)
        return str(p)
    p.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(["truncate", "-s", "%dG" % size_gb, str(p)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise ValueError("cannot create disk image: %s" % proc.stderr)
    return str(p)


def ensure_scratch(disk_img, ident):
    path = Path(km.scratch_img_path(disk_img, ident))
    if path.exists():
        if not path.is_file() or path.is_symlink():
            raise ValueError("scratch image is not a file: %s"
                             % path)
        path.unlink()
    path.parent.mkdir(parents=True, exist_ok=True)
    proc = subprocess.run(["truncate", "-s", "64M", str(path)],
                          capture_output=True, text=True)
    if proc.returncode != 0:
        raise ValueError("cannot create scratch image: %s"
                         % proc.stderr)
    return str(path)


def verify_cache(entry):
    home = str(Path.home())
    ok, msg, target = km.verify_entry_cache(home, entry)
    if not ok:
        return False, msg, None, None
    return True, msg, km.entry_cache_dir(home, entry), target


def download_cache(vng_path, ver):
    try:
        proc = subprocess.run(km.vng_download_cmd(vng_path, ver),
                              capture_output=True, text=True,
                              timeout=900)
    except subprocess.TimeoutExpired:
        return False, "download timed out for %s" % ver
    if proc.returncode != 0:
        return False, "download failed for %s: %s" % (
            ver, (proc.stderr or "").strip()[:300])
    return True, "downloaded"


def read_text(path):
    try:
        return Path(path).read_text()
    except OSError:
        return None


def gather_miss_snaps(export, count=4):
    if not os.path.isdir(export):
        return None
    try:
        times = json.loads(Path(
            export, "progs_times.json").read_text())
    except (OSError, ValueError):
        times = {}
    snaps = []
    for idx in range(count):
        try:
            nsecs = int(times[str(idx)])
        except (KeyError, TypeError, ValueError):
            nsecs = None
        snaps.append((nsecs, read_text(
            os.path.join(export, "progs%d.json" % idx))))
    return snaps


def run_validator(export):
    cap = os.path.join(export, "cap")
    if not os.path.isdir(cap):
        return None, None
    try:
        proc = subprocess.run(
            [str(ROOT / "tools" / "validate-schemas"), cap],
            capture_output=True, text=True,
            timeout=CAPTURE_TIMEOUT)
    except subprocess.TimeoutExpired:
        out = "validate-schemas timed out"
        return 99, out + _write_transcript(export, out)
    out = ((proc.stdout or "") + (proc.stderr or "")).strip()
    return proc.returncode, \
        out[-2000:] + _write_transcript(export, out)


def _write_transcript(export, out):
    try:
        Path(export, "validate.txt").write_text(out + "\n")
    except OSError as exc:
        return "\n[transcript unwritten: %s]" % exc
    return ""


def chown_guest_tree(path):
    """Chown one guest-written tree to us, or an error.

    Guest files land root-owned through sudo vng; the
    host must own the busy tree before it writes the
    validate transcript, the events summary, and the
    post-evaluation unlink.
    """
    proc = subprocess.run(
        ["sudo", "-n", "chown", "-R",
         "%d:%d" % (os.getuid(), os.getgid()), path],
        capture_output=True, text=True)
    if proc.returncode != 0:
        return (proc.stderr or "").strip() or \
            "chown rc=%d" % proc.returncode
    return None


def gather_persisted(export):
    path = os.path.join(export, "cap", "events.ndjson")
    try:
        with open(path) as handle:
            counts = km.persisted_counts(handle)
        with open(path) as handle:
            byts = km.persisted_bytes(handle)
        with open(path) as handle:
            dirs = km.persisted_copy_dirs(handle)
        return counts, byts, dirs, None
    except OSError:
        return None, None, None, "missing events.ndjson"
    except ValueError as exc:
        return None, None, None, str(exc)


def gather_busy_counters(busy):
    path = os.path.join(busy, "cap", "events.ndjson")
    try:
        with open(path) as handle:
            return km.counter_deltas(handle), None
    except OSError:
        return None, "missing events.ndjson"
    except ValueError as exc:
        return None, str(exc)



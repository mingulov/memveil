#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later
# Oracle live gate: module build plus guest comparison.
#
# The guest comparison and its owned module build run only
# when armed (MEMVEIL_VM_ORACLE=1) with qualified lifecycle
# probes. Unarmed runs exit 77 without building or booting;
# armed runs with missing pieces fail loudly.
set -u

case "${1:-}" in
    --help|-h) sed -n '2,/^set -u/p' "$0" | sed 's/^# //; s/^#//'; exit 0 ;;
esac

ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)

cd "$ROOT" || exit 1
if [ "${MEMVEIL_VM_ORACLE:-0}" != "1" ]; then
    echo "vm-oracle: SKIP: needs MEMVEIL_VM_ORACLE=1" \
        "with qualified probes" >&2
    exit 77
fi
if [ ! -f "$ROOT/build/bpf/swiotlb_lifecycle.bpf.o" ]; then
    echo "vm-oracle: FAIL: armed but lifecycle probes" \
        "not qualified" >&2
    exit 1
fi
exec python3 -m pytest \
    tests/vm/test_oracle_live.py::test_guest_comparison -v "$@"

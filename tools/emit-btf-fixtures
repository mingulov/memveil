def chain(nptrs, fname):
    b = Blob()
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    cur = t_int
    for _ in range(nptrs):
        cur = b.t(0, K_PTR, 0, cur)
    params = struct.pack("<II", b.s("p"), cur)
    t_proto = b.t(0, K_PROTO, 1, 0, params)
    b.t(b.s(fname), K_FUNC, 0, t_proto)
    return b.build()


def kflag():
    b = Blob()
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    # STRUCT "device" with kind_flag=1 and one member: the
    # walker must keep 12-byte member alignment and read
    # the trailing types exactly.
    mem = struct.pack("<III", b.s("m"), t_int, 0)
    t_dev = b.t(b.s("device"), K_STRUCT, 1, 64, mem, kflag=1)
    t_sproto = b.t(0, K_PROTO, 0, t_dev)
    b.t(b.s("kfs"), K_FUNC, 0, t_sproto)
    # ENUM64 "color" with kind_flag=1 and one enumerator.
    ent = struct.pack("<III", b.s("RED"), 1, 0)
    t_col = b.t(b.s("color"), K_ENUM64, 1, 8, ent, kflag=1)
    params = struct.pack("<II", b.s("c"), t_col)
    t_eproto = b.t(0, K_PROTO, 1, 0, params)
    b.t(b.s("kfe"), K_FUNC, 0, t_eproto)
    return b.build()


# (BTF spelling, size, bits) covering every normalized LP64
# integer name plus the kernel/BTF alias spellings.
_LP64_INTS = [
    ("char", 1, 8), ("signed char", 1, 8), ("unsigned char", 1, 8),
    ("short", 2, 16), ("unsigned short", 2, 16),
    ("int", 4, 32), ("unsigned int", 4, 32),
    ("long", 8, 64), ("unsigned long", 8, 64),
    ("long long", 8, 64), ("unsigned long long", 8, 64),
    ("bool", 1, 8),
    ("short int", 2, 16), ("long int", 8, 64),
    ("long long int", 8, 64),
    ("short unsigned int", 2, 16),
    ("long unsigned int", 8, 64),
    ("long long unsigned int", 8, 64),
]


def intsizes():
    b = Blob()
    params = b""
    names = "abcdefghijklmnopqr"
    for i, (spell, size, bits) in enumerate(_LP64_INTS):
        t = b.t(b.s(spell), K_INT, 0, size, int_data(bits, 0))
        params += struct.pack("<II", b.s("p" + names[i]), t)
    t_ulong = b.t(b.s("sizet-ulong"), K_INT, 0, 8,
                  int_data(64, 0))
    t_size = b.t(b.s("size_t"), K_TYPEDEF, 0, t_ulong)
    params += struct.pack("<II", b.s("psz"), t_size)
    t_proto = b.t(0, K_PROTO, len(_LP64_INTS) + 1, 0, params)
    b.t(b.s("isz"), K_FUNC, 0, t_proto)
    return b.build()


def intsize_bad():
    b = Blob()
    t_long4 = b.t(b.s("long"), K_INT, 0, 4, int_data(32, 0))
    t_rproto = b.t(0, K_PROTO, 0, t_long4)
    b.t(b.s("badret"), K_FUNC, 0, t_rproto)
    params = struct.pack("<II", b.s("x"), t_long4)
    t_pproto = b.t(0, K_PROTO, 1, 0, params)
    b.t(b.s("badpar"), K_FUNC, 0, t_pproto)
    return b.build()


def _swiotlb_types(b):
    """Shared swiotlb types; returns ids the live blobs reuse.

    Struct members carry the real 7.0.0-38-generic BTF
    (bit_offset, bit_size) pairs, verified against
    /sys/kernel/btf/vmlinux with bpftool plus an
    independent BTF walk: the copy probe reads exactly
    these members through CO-RE.
    """
    t_uint = b.t(b.s("unsigned int"), K_INT, 0, 4, int_data(32, 0))
    t_ulong = b.t(b.s("unsigned long"), K_INT, 0, 8, int_data(64, 0))
    t_phys = b.t(b.s("phys_addr_t"), K_TYPEDEF, 0, t_ulong)
    t_size = b.t(b.s("size_t"), K_TYPEDEF, 0, t_ulong)
    t_dir = b.t(b.s("dma_data_direction"), K_ENUM, 0, 4)
    mem = struct.pack("<III", b.s("min_align_mask"), t_uint, 32)
    t_parms = b.t(b.s("device_dma_parameters"), K_STRUCT, 1, 16, mem)
    t_parms_ptr = b.t(0, K_PTR, 0, t_parms)
    mem = struct.pack("<III", b.s("dma_parms"), t_parms_ptr, 5056)
    t_dev = b.t(b.s("device"), K_STRUCT, 1, 808, mem)
    mem = struct.pack("<III", b.s("orig_addr"), t_phys, 0)
    mem += struct.pack("<III", b.s("alloc_size"), t_size, 64)
    t_slot = b.t(b.s("io_tlb_slot"), K_STRUCT, 2, 24, mem)
    t_slot_ptr = b.t(0, K_PTR, 0, t_slot)
    mem = struct.pack("<III", b.s("start"), t_phys, 0)
    mem += struct.pack("<III", b.s("nslabs"), t_ulong, 192)
    mem += struct.pack("<III", b.s("slots"), t_slot_ptr, 448)
    t_pool = b.t(b.s("io_tlb_pool"), K_STRUCT, 3, 104, mem)
    return {
        "uint": t_uint, "ulong": t_ulong, "phys": t_phys,
        "size": t_size, "dir": t_dir, "dev": t_dev,
        "pool": t_pool, "slot": t_slot,
    }


def _swiotlb_funcs(b, ids, map_attrs_ptr, skip_map=False):
    t_dev_ptr = b.t(0, K_PTR, 0, ids["dev"])
    t_pool_ptr = b.t(0, K_PTR, 0, ids["pool"])
    if not skip_map:
        params = struct.pack("<II", b.s("dev"), t_dev_ptr)
        params += struct.pack("<II", b.s("orig_addr"), ids["phys"])
        params += struct.pack("<II", b.s("mapping_size"), ids["size"])
        params += struct.pack("<II", b.s("alloc_align_mask"), ids["uint"])
        params += struct.pack("<II", b.s("dir"), ids["dir"])
        if map_attrs_ptr:
            t_ap = b.t(0, K_PTR, 0, ids["ulong"])
            params += struct.pack("<II", b.s("attrs"), t_ap)
        else:
            params += struct.pack("<II", b.s("attrs"), ids["ulong"])
        t_proto = b.t(0, K_PROTO, 6, ids["phys"], params)
        b.t(b.s("swiotlb_tbl_map_single"), K_FUNC, 0, t_proto)
    params = struct.pack("<II", b.s("dev"), t_dev_ptr)
    params += struct.pack("<II", b.s("tlb_addr"), ids["phys"])
    params += struct.pack("<II", b.s("mapping_size"), ids["size"])
    params += struct.pack("<II", b.s("dir"), ids["dir"])
    params += struct.pack("<II", b.s("attrs"), ids["ulong"])
    params += struct.pack("<II", b.s("pool"), t_pool_ptr)
    t_proto = b.t(0, K_PROTO, 6, 0, params)
    b.t(b.s("__swiotlb_tbl_unmap_single"), K_FUNC, 0, t_proto)
    for name in ("__swiotlb_sync_single_for_device",
                 "__swiotlb_sync_single_for_cpu"):
        params = struct.pack("<II", b.s("dev"), t_dev_ptr)
        params += struct.pack("<II", b.s("tlb_addr"), ids["phys"])
        params += struct.pack("<II", b.s("size"), ids["size"])
        params += struct.pack("<II", b.s("dir"), ids["dir"])
        params += struct.pack("<II", b.s("pool"), t_pool_ptr)
        t_proto = b.t(0, K_PROTO, 5, 0, params)
        b.t(b.s(name), K_FUNC, 0, t_proto)
    params = struct.pack("<II", b.s("dev"), t_dev_ptr)
    params += struct.pack("<II", b.s("tlb_addr"), ids["phys"])
    params += struct.pack("<II", b.s("size"), ids["size"])
    params += struct.pack("<II", b.s("dir"), ids["dir"])
    params += struct.pack("<II", b.s("mem"), t_pool_ptr)
    t_proto = b.t(0, K_PROTO, 5, 0, params)
    b.t(b.s("swiotlb_bounce"), K_FUNC, 0, t_proto)
    # A sixth FUNC present in BTF but absent from the test
    # filter-function lists: unattachable by fixture design.
    # It reuses the bounce prototype so doc-rename tests keep
    # a matching signature; only the name presence is tested.
    params = struct.pack("<II", b.s("dev"), t_dev_ptr)
    params += struct.pack("<II", b.s("tlb_addr"), ids["phys"])
    params += struct.pack("<II", b.s("size"), ids["size"])
    params += struct.pack("<II", b.s("dir"), ids["dir"])
    params += struct.pack("<II", b.s("mem"), t_pool_ptr)
    t_proto = b.t(0, K_PROTO, 5, 0, params)
    b.t(b.s("swiotlb_map"), K_FUNC, 0, t_proto)


def swiotlb_live(map_attrs_ptr):
    b = Blob()
    ids = _swiotlb_types(b)
    _swiotlb_funcs(b, ids, map_attrs_ptr)
    return b.build()


def swiotlb_live_nomap():
    b = Blob()
    ids = _swiotlb_types(b)
    _swiotlb_funcs(b, ids, False, skip_map=True)
    return b.build()


def members():
    b = Blob()
    t_long = b.t(b.s("long"), K_INT, 0, 8, int_data(64, 1))
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    t_uint = b.t(b.s("unsigned int"), K_INT, 0, 4, int_data(32, 0))
    t_short = b.t(b.s("short"), K_INT, 0, 2, int_data(16, 1))
    t_ull = b.t(b.s("unsigned long long"), K_INT, 0, 8,
               int_data(64, 0))
    t_char = b.t(b.s("char"), K_INT, 0, 1, int_data(8, 1))
    mem = struct.pack("<III", b.s("b"), t_long, 0)
    mem += struct.pack("<III", b.s("c"), t_long, 64)
    t_inner = b.t(0, K_STRUCT, 2, 16, mem)
    t_ptr_void = b.t(0, K_PTR, 0, 0)
    mem = struct.pack("<III", 0, t_inner, 0)
    mem += struct.pack("<III", b.s("d"), t_long, 0)
    t_union = b.t(0, K_UNION, 2, 16, mem)
    mem = struct.pack("<III", b.s("a"), t_long, 0)
    mem += struct.pack("<III", 0, t_union, 64)
    mem += struct.pack("<III", b.s("mapping"), t_ptr_void, 192)
    b.t(b.s("mvt_anon"), K_STRUCT, 3, 32, mem)
    mem = struct.pack("<III", b.s("x"), t_uint, 0)
    mem += struct.pack("<III", b.s("offline_disabled"), t_uint,
                       (1 << 24) | 6112)
    b.t(b.s("mvt_dev"), K_STRUCT, 2, 768, mem, kflag=1)
    t_bf1 = b.t(b.s("unsigned int"), K_INT, 0, 4, int_data(1, 0))
    mem = struct.pack("<III", b.s("offline_disabled"), t_bf1, 6112)
    b.t(b.s("mvt_dev_old"), K_STRUCT, 1, 768, mem)
    mem = struct.pack("<III", b.s("flags"), t_short, 64)
    b.t(b.s("mvt_console"), K_STRUCT, 1, 12, mem)
    b.t(b.s("mvt_console"), K_STRUCT, 1, 12, mem)
    mem = struct.pack("<III", b.s("flags"), t_int, 0)
    b.t(b.s("mvt_dup"), K_STRUCT, 1, 8, mem)
    mem = struct.pack("<III", b.s("flags"), t_int, 32)
    b.t(b.s("mvt_dup"), K_STRUCT, 1, 8, mem)
    mem = struct.pack("<III", b.s("other"), t_int, 0)
    b.t(b.s("mvt_partial"), K_STRUCT, 1, 4, mem)
    mem = struct.pack("<III", b.s("other"), t_int, 0)
    mem += struct.pack("<III", b.s("extra"), t_int, 96)
    b.t(b.s("mvt_partial"), K_STRUCT, 2, 16, mem)
    ent = struct.pack("<III", b.s("MVT_BIG"), 0, 0x100)
    b.t(b.s("mvt_e64"), K_ENUM64, 1, 8, ent)
    t_phys = b.t(b.s("mvt_phys_t"), K_TYPEDEF, 0, t_ull)
    t_const = b.t(0, K_CONST, 0, t_phys)
    t_tag = b.t(b.s("__tag"), K_TAG, 0, t_const)
    t_p = b.t(0, K_PTR, 0, t_tag)
    extra = struct.pack("<III", t_char, t_int, 16)
    t_arr = b.t(0, K_ARRAY, 0, 0, extra)
    mem = struct.pack("<III", b.s("p"), t_p, 0)
    mem += struct.pack("<III", b.s("q"), t_phys, 64)
    mem += struct.pack("<III", b.s("name"), t_arr, 128)
    b.t(b.s("mvt_tag"), K_STRUCT, 3, 32, mem)
    return b.build()


def split():
    data = bytearray(funcproto())
    type_len = struct.unpack("<I", data[12:16])[0]
    data[24 + type_len] = ord("S")
    return bytes(data)


def sig_width():
    b = Blob()
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    t_dev = b.t(b.s("device"), K_STRUCT, 0, 64)
    t_ptr = b.t(0, K_PTR, 0, t_dev)
    t_u32 = b.t(b.s("unsigned int"), K_INT, 0, 4, int_data(32, 0))
    t_size = b.t(b.s("size_t"), K_TYPEDEF, 0, t_u32)
    params = struct.pack("<II", b.s("dev"), t_ptr)
    params += struct.pack("<II", b.s("size"), t_size)
    t_proto = b.t(0, K_PROTO, 2, t_int, params)
    b.t(b.s("test_fn"), K_FUNC, 0, t_proto)
    return b.build()


def sig_dup():
    b = Blob()
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    t_dev = b.t(b.s("device"), K_STRUCT, 0, 64)
    t_ptr = b.t(0, K_PTR, 0, t_dev)
    t_ulong = b.t(b.s("unsigned long"), K_INT, 0, 8, int_data(64, 0))
    t_size = b.t(b.s("size_t"), K_TYPEDEF, 0, t_ulong)
    t_u32 = b.t(b.s("unsigned int"), K_INT, 0, 4, int_data(32, 0))

    def proto(second):
        params = struct.pack("<II", b.s("dev"), t_ptr)
        params += struct.pack("<II", b.s("size"), second)
        return b.t(0, K_PROTO, 2, t_int, params)

    b.t(b.s("test_fn"), K_FUNC, 0, proto(t_size))
    b.t(b.s("test_fn"), K_FUNC, 0, proto(t_size))
    b.t(b.s("test_gn"), K_FUNC, 0, proto(t_size))
    b.t(b.s("test_gn"), K_FUNC, 0, proto(t_u32))
    return b.build()


def main():
    OUT.mkdir(parents=True, exist_ok=True)
    blobs = {"funcproto": funcproto(), "dupfunc": dupfunc(),
             "cycle": cycle(), "anon": anon(), "unnamed": unnamed(),
             "voidptr": voidptr(), "array": array(),
             "badref": badref(), "fnptr": fnptr(),
             "chain31": chain(31, "deep31"),
             "chain32": chain(32, "deep32"),
             "kflag": kflag(), "intsizes": intsizes(),
             "intsize-bad": intsize_bad(),
             "swiotlb-live": swiotlb_live(False),
             "swiotlb-live-73": swiotlb_live(True),
             "swiotlb-live-nomap": swiotlb_live_nomap(),
             "members": members(), "split": split(),
             "sig-width": sig_width(), "sig-dup": sig_dup()}
    for name, data in blobs.items():
        (OUT / (name + ".bin")).write_bytes(data)
    print("wrote %d BTF fixtures to %s" % (len(blobs), OUT))


if __name__ == "__main__":
    sys.exit(main())

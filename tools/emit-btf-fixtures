#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""Generate minimal raw-BTF fixtures for function-prototype reads.

Hand-encoded blobs (not derived from a build artifact): each holds a
few BTF types exercising one prototype-reader path. The reader tests
consume them as raw vmlinux-style blobs (header at offset 0).

Outputs: tests/fixtures/btf/*.bin (funcproto, dupfunc, cycle, anon,
  unnamed, voidptr, array, badref, fnptr, chain31, chain32, kflag,
  intsizes, intsize-bad, swiotlb-live, swiotlb-live-73).

  funcproto : FUNC test_fn -> PROTO (int, [dev: PTR STRUCT device,
                size: TYPEDEF size_t]); canonical
                "int (struct device *dev, size_t size)". Also FUNC
                vret -> PROTO (void, []); canonical "void (void)";
                and FUNC lint -> PROTO ("long unsigned int", [])
                proving the BTF-to-C integer alias.
  dupfunc   : funcproto plus a second FUNC test_fn (refused).
  cycle     : FUNC cyc whose param type is a CONST/VOLATILE cycle
                (hop exhaustion refused). Named TYPEDEFs stop
                resolution with their own name, so only anonymous
                modifier chains can exhaust the hop budget.
  anon      : FUNC anon with PTR to an anonymous STRUCT (refused).
  unnamed   : FUNC unm with an unnamed parameter (refused).
  voidptr   : FUNC vptr with PTR -> CONST -> void parameter;
                canonical "void (void *p)".
  array     : FUNC arr with INT[4] parameter; canonical
                "void (int[4] a)".
  badref    : FUNC bad whose parameter cites type id 99, which
                does not exist (refused).
  fnptr     : FUNC cb with PTR -> FUNC_PROTO parameter, the
                realistic function-pointer shape (refused: the
                reader spells data types only).
  chain31   : 31 nested PTRs to INT (resolves; exercises deep
                but finite chains).
  chain32   : 32 nested PTRs to INT (hop budget exhausted).
  kflag     : FUNC kfs returning STRUCT "device" with kind_flag=1
                (one member, proving member alignment is kept)
                plus trailing types; FUNC kfe taking ENUM64
                "color" with kind_flag=1. kind_flag changes
                interpretation, not record layout, so both
                spell normally.
  intsizes  : FUNC isz taking one parameter of every LP64
                integer spelling (plus kernel/BTF aliases and a
                size_t typedef); proves the LP64 size check
                accepts the full table.
  intsize-bad: FUNC badret returning "long" with size 4 and
                FUNC badpar taking "long" with size 4; both
                refused by the LP64 size check.
  swiotlb-live : the five swiotlb FUNCs with 7.0-generation
                canonical spellings plus the four structs the
                copy probe reads (real 7.0.0-38 member
                offsets); feeds live-verification tests.
  swiotlb-live-73: swiotlb-live with the 7.3 map shape
                (attrs as a pointer).
  swiotlb-live-nomap: swiotlb-live without the
                swiotlb_tbl_map_single FUNC: the hook-absent
                shape for kallsyms-split tests.
  members   : synthetic member-resolution shapes: anonymous
                struct-in-union nesting, kind_flag and legacy
                bitfields, agreeing/disagreeing/partial
                duplicate structs, an ENUM64, typedef/const/
                tag chains and an array member.
  split     : funcproto with its string section's first
                byte patched to nonzero: the split-BTF
                shape needing a base.
  sig-width : FUNC test_fn whose size_t typedef resolves
                to 32 bits: the typedef-width refusal shape.
  sig-dup   : FUNC test_fn twice over identical
                prototypes (accepted) and FUNC test_gn
                twice over differing prototypes (refused).
"""
import struct
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "tests" / "fixtures" / "btf"

K_INT, K_PTR, K_ARRAY, K_STRUCT = 1, 2, 3, 4
K_UNION = 5
K_ENUM = 6
K_TYPEDEF, K_VOLATILE, K_CONST = 8, 9, 10
K_FUNC, K_PROTO = 12, 13
K_TAG = 18
K_ENUM64 = 19


class Blob:
    def __init__(self):
        self.strs = [b""]
        self.types = []

    def s(self, text):
        if text == "":
            return 0
        for i, s in enumerate(self.strs):
            if s == text.encode():
                return sum(len(x) + 1 for x in self.strs[:i])
        off = sum(len(x) + 1 for x in self.strs)
        self.strs.append(text.encode())
        return off

    def t(self, name_off, kind, vlen, size_or_type, extra=b"",
            kflag=0):
        self.types.append(
            struct.pack("<III", name_off,
                        (kflag << 31) | (kind << 24) | vlen,
                        size_or_type) + extra
        )
        return len(self.types)

    def build(self):
        tsec = b"".join(self.types)
        ssec = b"\x00".join(self.strs) + b"\x00"
        hdr = struct.pack("<HBBIIIII", 0xEB9F, 1, 0, 24, 0, len(tsec),
                          len(tsec), len(ssec))
        return hdr + tsec + ssec


def int_data(bits, encoding):
    return struct.pack("<I", (encoding << 24) | bits)


def _funcproto_body(b):
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    t_dev = b.t(b.s("device"), K_STRUCT, 0, 64)
    t_ptr = b.t(0, K_PTR, 0, t_dev)
    t_ulong = b.t(b.s("unsigned long"), K_INT, 0, 8, int_data(64, 0))
    t_size = b.t(b.s("size_t"), K_TYPEDEF, 0, t_ulong)
    params = struct.pack("<II", b.s("dev"), t_ptr)
    params += struct.pack("<II", b.s("size"), t_size)
    t_proto = b.t(0, K_PROTO, 2, t_int, params)
    b.t(b.s("test_fn"), K_FUNC, 0, t_proto)
    t_void = b.t(0, K_PROTO, 0, 0)
    b.t(b.s("vret"), K_FUNC, 0, t_void)
    t_lui = b.t(b.s("long unsigned int"), K_INT, 0, 8,
                int_data(64, 0))
    t_lproto = b.t(0, K_PROTO, 0, t_lui)
    b.t(b.s("lint"), K_FUNC, 0, t_lproto)


def funcproto():
    b = Blob()
    _funcproto_body(b)
    return b.build()


def dupfunc():
    b = Blob()
    _funcproto_body(b)
    # Second FUNC test_fn pointing at the first prototype (id 6).
    b.t(b.s("test_fn"), K_FUNC, 0, 6)
    return b.build()


def cycle():
    b = Blob()
    t_int = b.t(b.s("int"), K_INT, 0, 4, int_data(32, 1))
    t_a = b.t(0, K_CONST, 0, 0)
    t_b = b.t(0, K_VOLATILE, 0, t_a)
    # Patch a -> b to close the cycle. Record 1 (INT) is 16
    # bytes, so a starts at 16 and its type field at 24.
    raw = bytearray(b"".join(b.types))
    struct.pack_into("<I", raw, 24, t_b)
    offs = [0, 16, 28]
    ends = offs[1:] + [len(raw)]
    b.types = [bytes(raw[s:e]) for s, e in zip(offs, ends)]
    params = struct.pack("<II", b.s("x"), t_a)
    t_proto = b.t(0, K_PROTO, 1, t_int, params)
    b.t(b.s("cyc"), K_FUNC, 0, t_proto)
    return b.build()



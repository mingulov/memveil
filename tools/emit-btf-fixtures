    t_ptr = b.t(0, K_PTR, 0, t_anon)
    params = struct.pack("<II", b.s("p"), t_ptr)
    t_proto = b.t(0, K_PROTO, 1, t_int, params)
    b.t(b.s("anon"), K_FUNC, 0, t_proto)

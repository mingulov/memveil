    {"id": "spec-05", "title": "Loss, censored stop, denied access, absent sources and exhausted bounds", "cases": ["loss-and-bounds"]},
    {"id": "spec-06", "title": "Equal metadata with different fixed test-data protection and no payload inspection", "cases": ["mapping-dax-inventory"]},
    {"id": "spec-07", "title": "Normal interface use versus an authored native rejection where observable", "cases": ["interface-activity", "tdx-ve-interface-activity"]},
    {"id": "spec-08", "title": "Identical guest traces with and without a modeled host read stay indistinguishable", "cases": ["egress-control-facts"]},
    {"id": "spec-09", "title": "Mixed namespaces, paravisor peers and generic non-confidential objects", "cases": ["channel-lifetimes", "mapping-dax-inventory", "shared-heap-retention"]},
    {"id": "spec-10", "title": "Compatible and incompatible comparisons, reordered rules, conflicts and empty scope", "cases": ["before-after-delta", "operator-walkthrough"]}

{
  "schema": "policy",
  "schema_version": "0.1.0",
  "policy_id": "example-snp-virtio",
  "subject_scope": "virtio-queue-lifetimes",
  "applies_to": {
    "platform": "sev-snp",
    "profile": "pinned"
  },
  "required_sources": [
    "dma-virtio-paths"
  ],
  "clock": "guest_monotonic_active",
  "role_bindings": {
    "queue": "snapshot-role-1"
  },
  "rules": [
    {
      "rule_id": "no-unexpected-queue",
      "selector": {
        "capability": "dma-paths",
        "source_id": "dma-virtio-paths",
        "semantics": "request"
      },
      "permitted": "allowlisted-only",
      "limit": {
        "window": "capture",
        "max": "0"
      },
      "obligation": null
    }
  ],
  "exceptions": []
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "session-v0.1.4.schema.json",
  "title": "MemVeil capture session",
  "description": "Capture session with required committed-byte SHA-256 integrity. Legacy schemas remain immutable.",
  "type": "object",
  "required": [
    "schema_version",
    "session_id",
    "synthetic",
    "product",
    "environment",
    "capture",
    "device_catalog",
    "baseline",
    "capabilities",
    "quality",
    "stop"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "0.1.4"
    },
    "session_id": {
      "$ref": "#/$defs/opaque_id"
    },
    "boot_id": {
      "$ref": "#/$defs/opaque_id",
      "description": "Optional boot identity when the capture is tied to one boot."
    },
    "synthetic": {
      "type": "boolean",
      "description": "True when every value is authored test data. Must survive every reporting and export path."
    },
    "product": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "memveil"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "build": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128
        }
      }
    },
    "environment": {
      "type": "object",
      "required": [
        "mode",
        "detection",
        "attestation",
        "evidence"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "none",
            "sev",
            "sev_es",
            "sev_snp",
            "tdx",
            "unknown"
          ],
          "description": "Guest mode. 'none' requires sufficient negative evidence; missing access gives 'unknown'."
        },
        "detection": {
          "enum": [
            "kernel_reported",
            "unverified",
            "conflicting"
          ]
        },
        "asserted_mode": {
          "enum": [
            "none",
            "sev",
            "sev_es",
            "sev_snp",
            "tdx",
            "unknown",
            null
          ],
          "description": "User-supplied hint only; never verification."
        },
        "attestation": {
          "enum": [
            "not_performed",
            "external_verified",
            "failed"
          ],
          "description": "External attestation status referenced as context; never generated internally."
        },
        "evidence": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/evidence_item"
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "required": [
        "mode",
        "window",
        "filters",
        "finalized",
        "integrity"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "live",
            "synthetic"
          ]
        },
        "window": {
          "type": "object",
          "required": [
            "start_ns",
            "end_ns"
          ],
          "additionalProperties": false,
          "properties": {
            "start_ns": {
              "$ref": "#/$defs/u64"
            },
            "end_ns": {
              "$ref": "#/$defs/u64"
            },
            "baseline_start_ns": {
              "$ref": "#/$defs/u64"
            }
          },
          "description": "Half-open monotonic observation window [start_ns, end_ns). Optional baseline_start_ns vouches the earlier start-cut read; counter snapshots are admissible from the baseline, every other record from start_ns."
        },
        "filters": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "device": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1,
              "maxLength": 256,
              "description": "Literal exact device selector, or null for no filter."
            }
          }
        },
        "finalized": {
          "type": "boolean",
          "description": "True once session/window/health finalization ran. A finalized capture may still hold incomplete evidence."
        },
        "end_reason": {
          "enum": [
            "duration",
            "size_limit",
            "signal",
            "error",
            "unknown",
            null
          ]
        },
        "integrity": {
          "type": "object",
          "required": [
            "algorithm",
            "events_bytes",
            "line_count",
            "first_seq",
            "last_seq",
            "events_sha256",
            "kinds"
          ],
          "additionalProperties": false,
          "properties": {
            "algorithm": {
              "const": "sha256"
            },
            "events_bytes": {
              "$ref": "#/$defs/u64"
            },
            "line_count": {
              "$ref": "#/$defs/u64"
            },
            "first_seq": {
              "anyOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "last_seq": {
              "anyOf": [
                {
                  "$ref": "#/$defs/u64"
                },
                {
                  "type": "null"
                }
              ]
            },
            "events_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kinds": {
              "type": "object",
              "required": [
                "bounce_attempt",
                "map_result",
                "unmap",
                "copy",
                "sync_request",
                "transition_result",
                "pool_sample",
                "gap",
                "marker",
                "counter_snapshot"
              ],
              "additionalProperties": false,
              "properties": {
                "bounce_attempt": {
                  "$ref": "#/$defs/u64"
                },
                "map_result": {
                  "$ref": "#/$defs/u64"
                },
                "unmap": {
                  "$ref": "#/$defs/u64"
                },
                "copy": {
                  "$ref": "#/$defs/u64"
                },
                "sync_request": {
                  "$ref": "#/$defs/u64"
                },
                "transition_result": {
                  "$ref": "#/$defs/u64"
                },
                "pool_sample": {
                  "$ref": "#/$defs/u64"
                },
                "gap": {
                  "$ref": "#/$defs/u64"
                },
                "marker": {
                  "$ref": "#/$defs/u64"
                },
                "counter_snapshot": {
                  "$ref": "#/$defs/u64"
                }
              }
            }
          }
        }
      }
    },
    "device_catalog": {
      "$ref": "#/$defs/device_catalog"
    },
    "baseline": {
      "type": "object",
      "required": [
        "complete",
        "region_observations"
      ],
      "additionalProperties": false,
      "properties": {
        "complete": {
          "type": "boolean",
          "description": "Whether pre-existing state needed for totals was captured. False keeps stateful totals unavailable."
        },
        "region_observations": {
          "type": "array",
          "maxItems": 4096,
          "description": "Actual initial region observations with provenance. Empty when initial state is unknown; never an invented transition.",
          "items": {
            "type": "object",
            "required": [
              "region_id",
              "state",
              "offset",
              "length",
              "address_space",
              "provenance"
            ],
            "additionalProperties": false,
            "properties": {
              "region_id": {
                "$ref": "#/$defs/opaque_id"
              },
              "state": {
                "enum": [
                  "shared",
                  "private",
                  "unknown"
                ]
              },
              "offset": {
                "$ref": "#/$defs/u64"
              },
              "length": {
                "$ref": "#/$defs/u64"
              },
              "address_space": {
                "enum": [
                  "guest_physical",
                  "kernel_virtual",
                  "iova",
                  "identity_only"
                ]
              },
              "provenance": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "generation": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9223372036854775807,
                "description": "Region lineage generation; absent means 1."
              }
            }
          }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "bounce_attempts",
        "mapping_lifecycle",
        "copy_bytes",
        "sync_requests",
        "conversion_results",
        "region_state",
        "pool_stats",
        "task_context"
      ],
      "additionalProperties": false,
      "properties": {
        "bounce_attempts": {
          "$ref": "#/$defs/capability"
        },
        "mapping_lifecycle": {
          "$ref": "#/$defs/capability"
        },
        "copy_bytes": {
          "$ref": "#/$defs/capability"
        },
        "sync_requests": {
          "$ref": "#/$defs/capability"
        },
        "conversion_results": {
          "$ref": "#/$defs/capability"
        },
        "region_state": {
          "$ref": "#/$defs/capability"
        },
        "pool_stats": {
          "$ref": "#/$defs/capability"
        },
        "task_context": {
          "$ref": "#/$defs/capability"
        }
      }
    },
    "quality": {
      "type": "object",
      "required": [
        "detail",
        "aggregate",
        "correlation",
        "baseline",
        "terminal"
      ],
      "additionalProperties": false,
      "properties": {
        "detail": {
          "$ref": "#/$defs/channel"
        },
        "aggregate": {
          "$ref": "#/$defs/channel"
        },
        "correlation": {
          "$ref": "#/$defs/correlation_channel"
        },
        "baseline": {
          "$ref": "#/$defs/channel"
        },
        "terminal": {
          "$ref": "#/$defs/channel"
        }
      },
      "description": "Independent quality channels. Detail loss never implies aggregate loss and conversely."
    },
    "stop": {
      "$ref": "#/$defs/stop_state"
    },
    "verdict": {
      "$ref": "#/$defs/verdict"
    }
  },
  "$defs": {
    "u64": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,19})$",
      "description": "Canonical unsigned 64-bit decimal string: no sign, leading zeros, fraction, or exponent. The application must also check range 0..18446744073709551615."
    },
    "opaque_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
      "description": "Session-local opaque identifier. Carries no address identity across namespaces."
    },
    "evidence_item": {
      "type": "object",
      "required": [
        "type",
        "source",
        "interpretation"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "interpretation": {
          "type": "string",
          "maxLength": 1024
        }
      }
    },
    "device_catalog": {
      "type": "object",
      "required": [
        "devices"
      ],
      "additionalProperties": false,
      "properties": {
        "devices": {
          "type": "array",
          "maxItems": 4096,
          "items": {
            "type": "object",
            "required": [
              "device_id",
              "name",
              "identity_status"
            ],
            "additionalProperties": false,
            "properties": {
              "device_id": {
                "$ref": "#/$defs/opaque_id"
              },
              "name": {
                "type": "string",
                "maxLength": 256,
                "description": "Bounded observed label; metadata, not a unique hardware serial number."
              },
              "driver": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1,
                "maxLength": 128
              },
              "identity_status": {
                "enum": [
                  "resolved",
                  "unresolved",
                  "exhausted"
                ]
              }
            }
          }
        }
      }
    },
    "capability": {
      "type": "object",
      "required": [
        "status",
        "reason",
        "hooks"
      ],
      "additionalProperties": false,
      "description": "'verified' means the profile/probe combination passed the product test, not attestation.",
      "properties": {
        "status": {
          "enum": [
            "verified",
            "partial",
            "unavailable",
            "disabled"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "hooks": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "profile_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "grade": {
          "enum": [
            "validated",
            "local-auto",
            "candidate",
            "partial",
            null
          ]
        }
      }
    },
    "channel": {
      "type": "object",
      "required": [
        "status",
        "loss_count",
        "scope",
        "reason"
      ],
      "additionalProperties": false,
      "description": "One independent quality channel. loss_count is null when unobservable, zero only when measured as zero.",
      "properties": {
        "status": {
          "enum": [
            "complete_for_scope",
            "partial",
            "unavailable",
            "not_applicable"
          ]
        },
        "loss_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "correlation_channel": {
      "type": "object",
      "required": [
        "status",
        "loss_count",
        "scope",
        "reason"
      ],
      "additionalProperties": false,
      "description": "Correlation quality: the aggregate rollup plus an optional per-relation-class breakdown. Absent relations mean legacy-conservative expansion of the aggregate to every class.",
      "properties": {
        "status": {
          "enum": [
            "complete_for_scope",
            "partial",
            "unavailable",
            "not_applicable"
          ]
        },
        "loss_count": {
          "anyOf": [
            {
              "$ref": "#/$defs/u64"
            },
            {
              "type": "null"
            }
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "relations": {
          "type": "object",
          "required": [
            "mapping_release",
            "copy_attribution",
            "sync_attribution"
          ],
          "additionalProperties": false,
          "description": "Per-class correlation evidence. All three classes are required when present.",
          "properties": {
            "mapping_release": {
              "$ref": "#/$defs/channel"
            },
            "copy_attribution": {
              "$ref": "#/$defs/channel"
            },
            "sync_attribution": {
              "$ref": "#/$defs/channel"
            }
          }
        }
      }
    },
    "stop_state": {
      "type": "object",
      "required": [
        "outcome",
        "reason",
        "budget_ms",
        "elapsed_ms",
        "admission_closed",
        "quiescence_observed",
        "writers_settled",
        "in_flight_at_close",
        "late_submits_drained",
        "drained_records",
        "busy_at_drain",
        "counters_valid",
        "open_mappings"
      ],
      "additionalProperties": false,
      "description": "Terminal stop evidence: which of the six stop stages proved what. outcome complete carries an empty reason; outcome partial carries the first unproven stage. drained_records counts consumed close-out batches; payloads stay undecoded by design.",
      "allOf": [
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "const": ""
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "outcome": {
                "const": "partial"
              }
            }
          },
          "then": {
            "properties": {
              "reason": {
                "minLength": 1
              }
            }
          }
        }
      ],
      "properties": {
        "outcome": {
          "enum": [
            "complete",
            "partial"
          ]
        },
        "reason": {
          "type": "string",
          "maxLength": 512
        },
        "budget_ms": {
          "$ref": "#/$defs/u64"
        },
        "elapsed_ms": {
          "$ref": "#/$defs/u64"
        },
        "admission_closed": {
          "type": "boolean"
        },
        "quiescence_observed": {
          "type": "boolean"
        },
        "writers_settled": {
          "$ref": "#/$defs/u64"
        },
        "in_flight_at_close": {
          "$ref": "#/$defs/u64"
        },
        "late_submits_drained": {
          "$ref": "#/$defs/u64"
        },
        "drained_records": {
          "$ref": "#/$defs/u64"
        },
        "drain_completed": {
          "type": "boolean",
          "description": "True when the close-out drain ran. Optional; absent on pre-0.1.3 documents."
        },
        "submit_after_drain": {
          "type": "boolean",
          "description": "True when a submit landed past the drain. Optional; absent on pre-0.1.3 documents."
        },
        "busy_at_drain": {
          "type": "boolean"
        },
        "counters_valid": {
          "type": "boolean"
        },
        "open_mappings": {
          "$ref": "#/$defs/u64"
        }
      }
    },
    "verdict": {
      "type": "object",
      "required": [
        "name",
        "loss_ratio_bps",
        "delivered"
      ],
      "additionalProperties": false,
      "description": "Record-time measurement verdict: agreed counters plus bounded loss. loss_ratio_bps is basis points 0..10000, exact when every leg is known and a lower bound otherwise; delivered counts the persisted bounce_attempt records the ratio ranges over.",
      "properties": {
        "name": {
          "enum": [
            "complete",
            "partial_known_loss",
            "partial_unknown_loss"
          ]
        },
        "loss_ratio_bps": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,3}|10000)$",
          "description": "Canonical basis-points decimal string 0..10000: no sign, leading zeros, fraction, or exponent."
        },
        "delivered": {
          "$ref": "#/$defs/u64"
        }
      }
    }
  }
}
